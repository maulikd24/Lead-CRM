# =====================================================================================================================
# Allvest Customer OS: PRODUCTION environment TEMPLATE (names and placeholders only)
# =====================================================================================================================
# For: Sohel Shaikh (infra/hosting). Prepared 15 Oct 2026 from src/lib/flags/registry.ts, docs/feature-flags.md,
# docs/profiles/go-live.env, docs/ai-gateway.md, docs/consent.md, docs/integrations/*.md and a scan of every
# process.env read in src, scripts, prisma.config.ts, next.config.ts and whatsapp-worker.
#
# RULES
#  * This file contains NO real secret and must stay that way. Never commit a filled-in copy. Put real values in
#    your secret manager (e.g. GCP Secret Manager) and inject them as pod environment variables.
#  * <set-me> / <generate: ...> / *.internal.example are placeholders. Replace them. Anything still in angle
#    brackets at start-up is a mistake.
#  * A flag is ON only for the exact value 1. Anything else (0, empty, unset) is OFF. Exception: see
#    DAILY_BRIEF_EVENING_ENABLED below, which is ON unless it is exactly 0.
#  * NEXT_PUBLIC_* names are BUILD-TIME: they are baked into the browser bundle when the image is built. Changing one
#    needs a rebuild of the image (pass them as Docker build args / build env), not just a pod restart.
#  * Every other name is RUN-TIME: change it, restart the pods.
#
# Legend used in the comments:
#   REQUIRED  = the app refuses to start or the feature cannot work without it
#   OPTIONAL  = safe to leave unset
#   Owner     = who produces the value (Sohel = infra; Owner = Chirayu / company decision; Admin = an Allvest Admin
#               user typing it into Settings > Apps & Integrations inside the running app)
#   Lives in  = "server env" (this file / secret manager) or "integrations page" (inside the app, stored encrypted in
#               the database with ENCRYPTION_KEY). NEVER in git.
# "(file)" after a name shows the source file that reads it.
# =====================================================================================================================


# ---------------------------------------------------------------------------------------------------------------------
# 1. Runtime identity
# ---------------------------------------------------------------------------------------------------------------------

# REQUIRED. Owner: Sohel. Lives in: server env. Set by the container image / Helm values.
# Next.js and the production safety checks read it. (framework; src/lib/ai/gateway/config.ts, src/instrumentation.ts path)
NODE_ENV=production

# REQUIRED on builds that contain src/lib/security/runtime-env.ts (the supportify port branch allvest/customer-os-on-dev,
# see reports/sp-port-report.md). Owner: Sohel. Lives in: server env.
# Tells the safety code "this is production" on GKE: mock webhook/Freshdesk/click-to-call/KYC adapters are refused,
# and the demo/sample-data conflict rules fire. Use APP_ENV=staging on the dev/staging environment so mocks stay allowed.
# NOTE: this worktree (allvest/fb-env, off w6-integrate) does NOT contain that file yet, so here APP_ENV is ignored
# by the code and the line below is the one that counts. Both are harmless together.
APP_ENV=production

# REQUIRED ONLY on builds WITHOUT runtime-env.ts (i.e. this tree). Owner: Sohel. Lives in: server env.
# In this tree the production safety switches (webhook-auth.ts, kyc/providers.ts, flags/cond.ts) test VERCEL_ENV only,
# and GKE does not set it. Setting it here is the no-code fix recommended in reports/golive-data-readiness.md 1c.
# Remove this line once the deployed image includes runtime-env.ts (then APP_ENV is used).
VERCEL_ENV=production

# OPTIONAL. Break-glass only. Owner: Sohel with Chirayu's OK. Lives in: server env.
# Leave UNSET. FLAG_CHECK=warn downgrades a failed start-up flag check from "stop the boot" to "loud warning".
# (src/lib/flags/startup.ts). Use it only to get a stuck pod up, then fix the real cause.
# FLAG_CHECK=warn

# OPTIONAL. Owner: Sohel. Lives in: server env. Set to the literal word true ONLY because the app sits behind the
# platform load balancer; the rate limiter then keys on the first X-Forwarded-For hop. Any other value = off.
# Do not set it if clients can reach the pod directly (they could fake the header). (src/lib/security/rate-limit.ts)
TRUST_FORWARDED_FOR=true

# OPTIONAL. Owner: Sohel. Lives in: server env. Public https base URL of this CRM, no trailing slash. Today only the
# Google Chat lead alert reads it, to build the deep link to a lead. (src/lib/leads/gchat-alert.ts)
CRM_BASE_URL=<set-me: https://your-production-host>


# ---------------------------------------------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ---------------------------------------------------------------------------------------------------------------------
# Two roles, two strings. See docs/hosting/postgres.env.example and scripts/db/setup-app-role.mjs.
#   supportify_app  = restricted runtime role (plain DML; INSERT+SELECT only on AuditLog; cannot ALTER/DROP/DISABLE TRIGGER)
#   owner role      = owns the tables, runs migrations only, never used by the running app

# REQUIRED. Owner: Sohel (value) / created by setup-app-role.mjs. Lives in: server env (secret manager).
# The RESTRICTED supportify_app role. This is what the running pods use. (src/lib/db/prisma.ts, prisma.config.ts)
#  * Always add sslmode=require (or verify-full with a CA bundle) when Postgres is not on the same private network.
#  * Pooling: Prisma opens its own pool per pod (default about 2*CPU+1 connections). Budget:
#      connections_needed = pods * pool_size + 1 (cron/maintenance headroom); keep it under Postgres max_connections.
#    Add &connection_limit=10 to cap each pod. If you put PgBouncer in front, use transaction mode and add
#    &pgbouncer=true; point DIRECT_DATABASE_URL at Postgres itself (migrations need a direct, non-pooled session).
#  * URL-encode special characters in the password.
DATABASE_URL=postgresql://supportify_app:<set-me-app-role-password>@db.internal.example:5432/<set-me-db-name>?sslmode=require&connection_limit=10

# REQUIRED for migrations and setup-app-role.mjs ONLY. Owner: Sohel. Lives in: the one-off migration job's
# environment / secret manager. Do NOT mount it into the long-running app pods if you can avoid it.
# The OWNER role (can create tables, install the audit-log triggers). Direct connection, no pooler.
# (scripts/vercel-migrate.mjs, scripts/db/setup-app-role.mjs). Note: prisma.config.ts reads DATABASE_URL, so the
# migration command is `DATABASE_URL="$DIRECT_DATABASE_URL" npx prisma migrate deploy`.
DIRECT_DATABASE_URL=postgresql://<set-me-owner-role>:<set-me-owner-password>@db.internal.example:5432/<set-me-db-name>?sslmode=require

# NOT SET IN THE APP. These two are inputs to scripts/db/setup-app-role.mjs, run once by Sohel from a shell:
#   APP_DB_PASSWORD   = the password to give supportify_app (24+ characters). <generate: openssl rand -base64 36>
#   APP_DATABASE_URL  = same string as DATABASE_URL above, used by `setup-app-role.mjs check` to prove the role is
#                       restricted. Both are in the registry as secrets but the running app never reads them.
# APP_DB_PASSWORD=<generate: openssl rand -base64 36>
# APP_DATABASE_URL=postgresql://supportify_app:<set-me-app-role-password>@db.internal.example:5432/<set-me-db-name>?sslmode=require


# ---------------------------------------------------------------------------------------------------------------------
# 3. Core secrets (the app will not start without the first four; src/lib/flags/registry.ts alwaysRequired)
# ---------------------------------------------------------------------------------------------------------------------

# REQUIRED. Owner: Sohel. Lives in: server env (secret manager). Signs login sessions. (src/lib/auth/*)
# NEXTAUTH_SECRET is the older name and works too; set ONE of them. Changing it signs everyone out.
AUTH_SECRET=<generate: openssl rand -hex 32>
# NEXTAUTH_SECRET=<alternative to AUTH_SECRET: openssl rand -hex 32>

# REQUIRED. Owner: Sohel. Lives in: server env + the in-cluster CronJob 'supportify-tick'.
# The scheduler sends it as header "x-cron-secret" when it POSTs /api/internal/cron/tick every 5 minutes.
# (src/app/api/internal/cron/tick/route.ts). The app and the CronJob must hold the identical value.
CRON_SECRET=<generate: openssl rand -hex 32>

# REQUIRED. Owner: Sohel (generate ONCE and never change). Lives in: server env (secret manager) + a sealed backup.
# Exactly 64 hex characters. Encrypts every integration credential stored in the database (Freshdesk, Exotel,
# CleverTap, WhatsApp, Meta/Google Ads tokens). If the production DB already holds saved credentials, you MUST reuse the
# existing key, otherwise they cannot be decrypted. Losing it = re-entering every credential.
ENCRYPTION_KEY=<generate: openssl rand -hex 32>

# REQUIRED in production (go-live check "env-core" BLOCKER; src/lib/go-live/checks.ts). Owner: Sohel.
# The public https address of this app. Not localhost, not a preview address. Also used by SSO and the RM brief links.
# AUTH_URL is the Auth.js v5 name; NEXTAUTH_URL the v4 name; the app reads both. Set both to the same value.
AUTH_URL=<set-me: https://your-production-host>
NEXTAUTH_URL=<set-me: https://your-production-host>


# ---------------------------------------------------------------------------------------------------------------------
# 4. Sign-in: Keycloak (SSO) or Google. Names only; values come from the identity admin.
# ---------------------------------------------------------------------------------------------------------------------
# Rollout order (docs/integrations/keycloak-sso.md): week 1 leave SSO off or on WITHOUT SSO_ONLY, so passwords keep
# working. SSO_ONLY is ignored while SSO itself is incomplete, so a half-configured env cannot lock everyone out.

# OPTIONAL. Owner: Chirayu decides; Sohel sets. Lives in: server env. Master switch for Keycloak. Default for week 1: off.
SSO_ENABLED=0
# Needed only if SSO_ENABLED=1 (all three, https issuer). Owner: identity admin supplies; Sohel stores. Lives in: server env.
# KEYCLOAK_ISSUER=<set-me: https://keycloak.internal.example/realms/<realm>>
# KEYCLOAK_CLIENT_ID=<set-me>
# KEYCLOAK_CLIENT_SECRET=<set-me: from your secret manager, never chat or email>
# Hides the password form. NEVER turn on without a break-glass list. Keep OFF in week 1.
SSO_ONLY=0
# SSO_BREAK_GLASS_EMAILS=<set-me: comma-separated work emails of the 2 people who may still use a password>

# OPTIONAL. "Continue with Google" for existing active users on the allowed domains (domains are set in the app,
# Settings; empty = off). Default for week 1: off. (src/lib/auth)
GOOGLE_SIGNIN_ENABLED=0
# Needed only if GOOGLE_SIGNIN_ENABLED=1. Owner: Google Workspace admin; Sohel stores. Lives in: server env.
# GOOGLE_CLIENT_ID=<set-me>
# GOOGLE_CLIENT_SECRET=<set-me>


# ---------------------------------------------------------------------------------------------------------------------
# 5. Safety posture: all outbound sending OFF. Do not change without the owner's written approval per flag.
# ---------------------------------------------------------------------------------------------------------------------
# Each of these sends something to a real customer or a vendor. Every one stays OFF in week 1.
# Full auto-approval is not allowed for any outbound message (every send needs a person's approval in the app).

AGENT_NUDGER_ENABLED=0            # draft-only WhatsApp nudger. Needs owner approval.
WA_BUSINESS_NUDGE_ENABLED=0       # sends approved nudges through the WhatsApp Cloud API (templates only). Needs approval + 4 Meta templates.
CLEVERTAP_PUSH_ENABLED=0          # writes to CleverTap (India region only). Needs approval + approved frozen batch.
LEAD_ALERTS_GCHAT_ENABLED=0       # posts new-lead alerts to a Google Chat space. Needs approval; rotate the webhook first.
CLOSED_LOOP_CONVERSIONS_ENABLED=0 # sends hashed consented conversions to Meta/Google. Turning it on IS the approval.
CLOSED_LOOP_KILL_SWITCH=0         # set to 1 at any time to stop every conversion send without a deploy.
DAILY_BRIEF_ENABLED=0             # morning RM email via SendGrid (09:00 IST Mon-Sat).
# !!! DAILY_BRIEF_EVENING_ENABLED is ON by default in code ("on unless exactly 0", src/lib/daily-brief/evening-job.ts).
# It must be set to 0 explicitly or the evening RM email can send as soon as SENDGRID_API_KEY and BRIEF_FROM exist.
DAILY_BRIEF_EVENING_ENABLED=0
WA_ASSIST_ENABLED=0               # AI suggested replies in the inbox (sends conversation text to an AI vendor).
WA_ASSIST_AUTO=0                  # auto-draft a reply on open.
OUTCOMES_DRAFTS_ENABLED=0         # draft check-in messages.
LEAD_PUSH_DRAFTS_ENABLED=0        # suggested first message for a new lead (draft).
FRESHDESK_COPILOT_ENABLED=0       # AI summary/suggested reply on Freshdesk hand-offs (drafts only).
AI_AGENTS_ENABLED=0               # lets the AI Bot own next best actions; serves /api/agent/work.
MEMORY_EXTRACTION_ENABLED=0       # sends conversation text to an AI vendor.
AUTOPILOT_APPLY_ENABLED=0         # BLOCKED in code. Never turn on: would change live ad accounts.
PUSH_DRY_RUN=0                    # leave 0/unset in production. If 1, "sent" pushes silently go nowhere.

# AI kill switch: 1 = the AI gateway refuses every model call. Keep 1 until the owner sets a provider key AND budgets (section 8).
AI_KILL_SWITCH=1

# --- Must be ABSENT or 0 in production (demo / sample data). The start-up check stops the boot on some of these. ---
# DO NOT SET, DO NOT UNCOMMENT:
#   NEXT_PUBLIC_DEMO_MODE        (build-time demo banner; must be unset when the image is BUILT)
#   DEMO_MODE                    (silently satisfies the AI-key check, so a missing key would go unnoticed)
#   CLOSED_LOOP_DEMO             (fake conversion destination)
#   PARTNER_SOURCE=sample        (made-up partner data; leave unset, default is native)
#   PARTNER_ALLOW_SAMPLE         (permits sample partners in production)
#   KYC_AUTOMATION_PROVIDER=mock (mock KYC verifier; leave unset: all KYC steps stay manual)
#   AI_PROVIDER=fake             (refused in production)
#   Never `source` ci/flags-all-on.env or docs/profiles/demo.env or docs/profiles/all-on.env into production.


# ---------------------------------------------------------------------------------------------------------------------
# 6. Consent and compliance gates
# ---------------------------------------------------------------------------------------------------------------------
# docs/consent.md. Existing customers have NO consent rows (migration 20261122000000_consent_ledger has no backfill),
# so with enforcement on, consent-gated sends find nobody consented. That is the safe direction.

# REQUIRED to be 1 before any outbound flag is ever turned on (rule FR-10 in the flag check). Owner: Owner. Lives in: server env.
CONSENT_ENFORCEMENT=1
# Enforces the 24-hour WhatsApp customer-service window. Keep 1.
WA_META_WINDOW=1
# OPTIONAL. Purposes recorded but not yet enforced while rolling out (comma-separated purpose names).
# CONSENT_RECORD_ONLY_PURPOSES=<set-me: only if the owner asks>
# OPTIONAL. Wording and version of the ads-measurement consent notice (needed before closed-loop conversions).
# CONSENT_ADS_MEASUREMENT_NOTICE=<set-me: legal-approved text>
# CONSENT_ADS_MEASUREMENT_NOTICE_VERSION=<set-me: e.g. 1>
# OPTIONAL. Wording shown with every projection; must say "illustrative". A built-in text applies when unset.
# OUTCOMES_DISCLAIMER=<set-me: legal-approved text>


