# =====================================================================================================================
# Allvest Customer OS: PostgreSQL environment TEMPLATE (names and placeholders only)
# =====================================================================================================================
# For a self-hosted or containerised Postgres. If you use a managed Postgres (Cloud SQL etc.) you do not need the
# POSTGRES_* variables: create the database and the owner role in the provider console and use only the role notes below.
#
# NO real value goes in this file or in git. Generate passwords yourself and keep them in your secret manager.
#   openssl rand -base64 36        # a 48-character password; use this for every password below
# Avoid @ : / ? # % in passwords you put inside a connection URL, or URL-encode them. base64 output can contain / and +;
# if you hit URL problems use:  openssl rand -hex 24
#
# Version: CI tests against postgres:16 (.github/workflows/ci.yml, marked "match the production major version before go-live").
# Use 16 unless production is already on another major; confirm the production version and database size BEFORE the
# migration rehearsal: reports/golive-data-readiness.md lists these as unknown.

# ---------------------------------------------------------------------------------------------------------------------
# 1. Container bootstrap (official postgres image reads these on FIRST start of an empty data directory only)
# ---------------------------------------------------------------------------------------------------------------------
# REQUIRED for the container. Owner: Sohel.
# The OWNER role: owns every table, runs `prisma migrate deploy` and scripts/db/setup-app-role.mjs. Never used by the app at runtime.
POSTGRES_USER=<set-me: owner role name, e.g. supportify_owner>
POSTGRES_DB=<set-me: database name>
POSTGRES_PASSWORD=<generate: openssl rand -base64 36>

# ---------------------------------------------------------------------------------------------------------------------
# 2. The two roles (the application connects as the restricted one)
# ---------------------------------------------------------------------------------------------------------------------
# Owner role   = POSTGRES_USER above. Goes into DIRECT_DATABASE_URL (migrations only, direct connection, no pooler).
# App role     = supportify_app (fixed name in the script). Goes into DATABASE_URL (runtime). It has plain
#                SELECT/INSERT/UPDATE/DELETE on business tables, INSERT+SELECT only on "AuditLog" (the audit log is
#                append-only), read-only on the chain head and on _prisma_migrations, no CREATE on the schema, and it is
#                not the owner, so it cannot DISABLE TRIGGER, DROP or ALTER anything.
#
# Create or refresh the app role (idempotent; run as the owner, after migrate deploy, and again after any release that adds tables):
#   APP_DB_PASSWORD=<generate: openssl rand -base64 36>   (24+ characters; the script refuses shorter)
#   DIRECT_DATABASE_URL=postgresql://<owner>:<owner-password>@db.internal.example:5432/<db>?sslmode=require
#   node scripts/db/setup-app-role.mjs setup
# Then prove it is restricted:
#   APP_DATABASE_URL=postgresql://supportify_app:<app-password>@db.internal.example:5432/<db>?sslmode=require
#   node scripts/db/setup-app-role.mjs check
# (Needs a real Postgres; `check` cannot run against the local PGlite dev database.)
#
# The same placeholders as in production.env.example:
# DIRECT_DATABASE_URL=postgresql://<set-me-owner-role>:<set-me-owner-password>@db.internal.example:5432/<set-me-db-name>?sslmode=require
# DATABASE_URL=postgresql://supportify_app:<set-me-app-role-password>@db.internal.example:5432/<set-me-db-name>?sslmode=require&connection_limit=10
#
# IMPORTANT ORDER: the migration 20261008000000_tamper_evident_audit_log installs append-only triggers on "AuditLog".
# Run migrations as the owner BEFORE the app first starts, and never point the app at the owner URL.
# Rollback of the role split: README.md says "point DATABASE_URL back at the owner URL and redeploy"; the triggers keep the
# log append-only either way.

# ---------------------------------------------------------------------------------------------------------------------
# 3. Server settings worth setting (postgresql.conf or container command flags)
# ---------------------------------------------------------------------------------------------------------------------
# Connections: max_connections must exceed pods * per-pod pool + owner/maintenance sessions (default Prisma pool is about
# 2*CPU+1 per pod; production.env.example caps it with connection_limit=10).
# Storage: put PGDATA on a persistent, encrypted volume. Never on the container's ephemeral layer.
# TLS: enable ssl=on with a server certificate and keep sslmode=require (or verify-full) in both URLs.
# Network: only the app pods, the migration job and the backup job may reach port 5432. No public IP.

# ---------------------------------------------------------------------------------------------------------------------
# 4. Backups, PITR and restore tests (this is the only real rollback for the database)
# ---------------------------------------------------------------------------------------------------------------------
# Several migrations cannot be undone in place (audit-log hash backfill and append-only triggers, the MARKETING enum value,
# identity-key backfills, forced password reset flags). The ONLY database rollback is restoring a point in time taken
# BEFORE the cutover.
#
#  * Continuous archiving (PITR): turn on WAL archiving (archive_mode=on, archive_command or pgBackRest/WAL-G/Barman)
#    to an object store inside the company's cloud account, with versioning/retention. Managed Postgres: enable its PITR.
#  * Base backup: take one immediately before cutover and label it (e.g. pre-customer-os-<date>). Record its restore point
#    / LSN / timestamp in the go-live ticket.
#  * Keep real data inside the company cloud. Do NOT download production dumps to a laptop.
#  * RESTORE TEST (mandatory before go-live): restore the latest backup into a SEPARATE database/instance, then
#      1. start it, confirm it accepts connections and `select count(*) from "AuditLog"` matches production;
#      2. run the full migration chain against that copy (migrate deploy as the owner) and time it, especially the
#         audit-chain backfill (20261008000000) and identity-key backfill (20261023000000);
#      3. run `node scripts/db/setup-app-role.mjs setup` then `check` against the copy;
#      4. neutralise integrations on the copy so it cannot message real customers (the Integrations settings default to mock;
#         do not copy live credentials into a test environment, and do not point a copy at the production CleverTap project).
#    Repeat a restore test after every change to the backup setup, and at least quarterly.
#  * Retention: keep at least 7 days of WAL plus the pre-cutover base backup for 30 days.
#  * The database is also protected by the daily S3 Object Lock audit anchor (production.env.example section 12).

# ---------------------------------------------------------------------------------------------------------------------
# 5. STAGING ONLY: minimal docker-compose snippet (do NOT use for production data; no HA, no PITR, no TLS)
# ---------------------------------------------------------------------------------------------------------------------
# Save as docker-compose.staging.yml next to a filled-in (uncommitted) postgres.env, then:  docker compose -f docker-compose.staging.yml up -d
#
# services:
#   db:
#     image: postgres:16
#     env_file: ./postgres.env            # POSTGRES_USER / POSTGRES_DB / POSTGRES_PASSWORD from section 1 (filled in, never committed)
#     volumes:
#       - pgdata:/var/lib/postgresql/data
#     ports:
#       - "127.0.0.1:5432:5432"           # loopback only
#     healthcheck:
#       test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
#       interval: 5s
#       timeout: 3s
#       retries: 10
#     restart: unless-stopped
# volumes:
#   pgdata:
#
# Staging flow: up -> `DATABASE_URL="$DIRECT_DATABASE_URL" npx prisma migrate deploy` -> setup-app-role.mjs setup -> check -> start the app
# with APP_ENV=staging (mock integrations allowed, no real customer data). Never put production data in this container.
