# Profile: go-live - The whole firm, real customers.
# Generated by npm run flags:docs from src/lib/flags/profiles.ts. Do not edit by hand: change the profile and regenerate.
# Names and safe values only. A flag is on only for the exact value 1. NEXT_PUBLIC_* names are set at BUILD time (a change needs a rebuild).
# Live messaging (CleverTap writes, the nudger) and closed-loop conversions are left commented out: each runs only after the owner's approval. The sample paths and addresses are placeholders.

NEXT_PUBLIC_NAV_V2=1
NEXT_PUBLIC_HOME_V2=1
NEXT_PUBLIC_MOTION=1
NEXT_PUBLIC_C360=1
NEXT_PUBLIC_OUTCOMES=1
NEXT_PUBLIC_CALLS_REVIEW=1
NEXT_PUBLIC_CONSENT=1
NEXT_PUBLIC_MERGE_REVIEW=1
NEXT_PUBLIC_SUPPORT_SLA=1
NEXT_PUBLIC_INSIGHTS=1
NEXT_PUBLIC_MARKETING=1
PARTNER_WORKSPACE_ENABLED=1
REFERRAL_PROGRAM_ENABLED=1
BACKOFFICE_IMPORT_ENABLED=1
PORTFOLIO_FEED_ENABLED=1
META_ADS_SYNC_ENABLED=1
GOOGLE_ADS_REPORTING_ENABLED=1
MERGE_SUGGESTIONS_ENABLED=1
APP_USER_ID_LINKING=1
FRESHDESK_HANDOFF_ENABLED=1
SSO_ENABLED=1
SSO_ONLY=1
WA_META_WINDOW=1
CONSENT_ENFORCEMENT=1
WA_ASSIST_ENABLED=1
REFERRAL_LINK_BASE=https://example.com/r
BACKOFFICE_IMPORT_DIR=/var/lib/crm/import
SSO_BREAK_GLASS_EMAILS=admin@example.com

# Planned: these names arrive with a branch that is not merged yet. Uncomment them when it lands.
# NEXT_PUBLIC_ATTRIBUTION=1
