# Needs approval: left off until the owner approves each one (live customer messaging, the consent decision).
# AGENT_NUDGER_ENABLED=1  (Live customer messaging: a person approves before it runs for real customers.)
# WA_BUSINESS_NUDGE_ENABLED=1  (Live customer messaging: a person approves before it runs for real customers. The owner approves the Meta templates and business verification first.)
# FRESHDESK_COPILOT_ENABLED=1  (approval required)
# CLEVERTAP_PUSH_ENABLED=1  (Live customer messaging: a person approves before it runs for real customers.)
# LEAD_ALERTS_GCHAT_ENABLED=1  (Owner approves the receiving Chat space and the payload shape before the flag is switched on.)
# CLOSED_LOOP_CONVERSIONS_ENABLED=1  (Consent decision: the owner approves the ads-measurement consent wording and the destination regions.)
# DAILY_BRIEF_ENABLED=1  (approval required)
# DAILY_BRIEF_EVENING_ENABLED=1  (approval required)

