# Profile: pilot - Real data, a small named group of RMs, drafts only.
# Generated by npm run flags:docs from src/lib/flags/profiles.ts. Do not edit by hand: change the profile and regenerate.
# Names and safe values only. A flag is on only for the exact value 1. NEXT_PUBLIC_* names are set at BUILD time (a change needs a rebuild).
# The reply assistant needs a recorded AI pilot sign-off and the person on the pilot list (Settings, AI pilot). Marketing, partner, referral and outbound push are off.

NEXT_PUBLIC_NAV_V2=1
NEXT_PUBLIC_HOME_V2=1
NEXT_PUBLIC_C360=1
NEXT_PUBLIC_OUTCOMES=1
NEXT_PUBLIC_CALLS_REVIEW=1
NEXT_PUBLIC_CONSENT=1
NEXT_PUBLIC_MERGE_REVIEW=1
NEXT_PUBLIC_SUPPORT_SLA=1
NEXT_PUBLIC_CONTROL_PLANE=1
MERGE_SUGGESTIONS_ENABLED=1
WA_META_WINDOW=1
CONSENT_ENFORCEMENT=1
WA_ASSIST_ENABLED=1

# Credentials this profile needs. Set real values in the host's secret store; never commit them.
# one of: ANTHROPIC_API_KEY, OPENAI_API_KEY (the one for AI_PROVIDER)
# AUTH_SECRET=
# CRON_SECRET=
# ENCRYPTION_KEY=
# NEXTAUTH_SECRET=
