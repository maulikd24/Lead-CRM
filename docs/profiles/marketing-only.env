# Profile: marketing-only - The marketing hire's environment: marketing surfaces on, nothing customer-facing for RMs.
# Generated by npm run flags:docs from src/lib/flags/profiles.ts. Do not edit by hand: change the profile and regenerate.
# Names and safe values only. A flag is on only for the exact value 1. NEXT_PUBLIC_* names are set at BUILD time (a change needs a rebuild).
# RM-side feature flags are off. Attribution shows no Customer 360 journey tab on purpose (a warning, not an error). Autopilot is read-only.

NEXT_PUBLIC_CONSENT=1
NEXT_PUBLIC_MARKETING=1
NEXT_PUBLIC_AUTOPILOT=1
NEXT_PUBLIC_PLANNER=1
PLANNER_AI_COPY_ENABLED=1
SOCIAL_DRAFTS_ENABLED=1
META_ADS_SYNC_ENABLED=1
GOOGLE_ADS_REPORTING_ENABLED=1
CONSENT_ENFORCEMENT=1
AUTOPILOT_DAILY_AUDIT_ENABLED=1

# Planned: these names arrive with a branch that is not merged yet. Uncomment them when it lands.
# NEXT_PUBLIC_ATTRIBUTION=1
# NEXT_PUBLIC_CREATIVE_INTEL=1
# DIRECTOR_REPORTS_ENABLED=1

# Credentials this profile needs. Set real values in the host's secret store; never commit them.
# one of: ANTHROPIC_API_KEY, OPENAI_API_KEY (the one for AI_PROVIDER)
# AUTH_SECRET=
# CRON_SECRET=
# ENCRYPTION_KEY=
# NEXTAUTH_SECRET=
