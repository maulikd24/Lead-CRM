# Profile: demo - The demo on a laptop: every screen on, no network side effects.
# Generated by npm run flags:docs from src/lib/flags/profiles.ts. Do not edit by hand: change the profile and regenerate.
# Names and safe values only. A flag is on only for the exact value 1. NEXT_PUBLIC_* names are set at BUILD time (a change needs a rebuild).
# Off on purpose: every real outbound flag (CleverTap writes, the nudger, reply auto-draft) and the blocked Autopilot apply switch. Closed-loop runs only against its fake destination. AI answers come from the local stand-in that DEMO_MODE provides.

NEXT_PUBLIC_NAV_V2=1
NEXT_PUBLIC_HOME_V2=1
NEXT_PUBLIC_MOTION=1
NEXT_PUBLIC_CLEVERTAP_CARD=1
NEXT_PUBLIC_C360=1
NEXT_PUBLIC_OUTCOMES=1
NEXT_PUBLIC_CALLS_REVIEW=1
NEXT_PUBLIC_CONSENT=1
NEXT_PUBLIC_MERGE_REVIEW=1
NEXT_PUBLIC_SUPPORT_SLA=1
NEXT_PUBLIC_INSIGHTS=1
NEXT_PUBLIC_MARKETING=1
PARTNER_WORKSPACE_ENABLED=1
REFERRAL_PROGRAM_ENABLED=1
SOCIAL_DRAFTS_ENABLED=1
MERGE_SUGGESTIONS_ENABLED=1
NEXT_PUBLIC_LANDING=1
CONSENT_ENFORCEMENT=1
REFERRAL_LINK_BASE=https://example.com/r

# Planned: these names arrive with a branch that is not merged yet. Uncomment them when it lands.
# NEXT_PUBLIC_ATTRIBUTION=1
# NEXT_PUBLIC_AUTOPILOT=1
# NEXT_PUBLIC_CREATIVE_INTEL=1
# NEXT_PUBLIC_PLANNER=1
# NEXT_PUBLIC_KANBAN=1
# NEXT_PUBLIC_DEMO_MODE=1
# CLOSED_LOOP_CONVERSIONS_ENABLED=1
# CLOSED_LOOP_DEMO=1
# DIRECTOR_REPORTS_ENABLED=1
# DEMO_MODE=1

# Credentials this profile needs. Set real values in the host's secret store; never commit them.
# one of: ANTHROPIC_API_KEY, OPENAI_API_KEY (the one for AI_PROVIDER)
# APP_SIGNUP_SECRET=
# AUTH_SECRET=
# CRON_SECRET=
# ENCRYPTION_KEY=
# NEXTAUTH_SECRET=
