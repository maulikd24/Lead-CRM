# Copy to `.env` (git-ignored) and fill in. Named without a leading dot because the repo's
# .gitignore ignores `.env*`, which would swallow a committed `.env.example`.

# The CRM's public URL (no trailing slash).
CRM_BASE_URL=https://your-crm.vercel.app

# Shared secret used to HMAC-sign every request to the CRM. MUST equal WHATSAPP_WORKER_SECRET in the CRM's
# environment (Vercel → Settings → Environment Variables). Generate with:  openssl rand -hex 32
WHATSAPP_WORKER_SECRET=

# One Openwa session per WhatsApp number. Each id must match a "Session ID" created in the CRM under
# Settings → WhatsApp Accounts. Letters, numbers, - and _ only (no spaces).
SESSION_IDS=rm_1,rm_2,rm_3,rm_4

# Where browser profiles / session data live. Mount this as a volume so a restart doesn't need a new QR scan.
SESSION_DATA_DIR=./data/sessions

# Path to Chrome/Chromium. The Docker image sets this for you.
# CHROME_PATH=/usr/bin/chromium

# --- Tuning (defaults shown) ---
# Boot numbers one at a time; launching several Chromium instances at once spikes CPU/RAM.
START_STAGGER_MS=20000
# How often to ask the CRM for queued replies.
OUTBOX_POLL_MS=2000
# The CRM marks a number offline if it hears no heartbeat for 5 minutes.
HEARTBEAT_MS=30000
HEALTH_CHECK_MS=60000
# Minimum gap between sends on one number (plus 0-1s jitter). Bursty, machine-regular sending is a ban signal.
SEND_MIN_INTERVAL_MS=1500
# Ignore messages older than this on arrival (stops a first-time link's history sync creating stale leads). 0 = keep all.
MAX_MESSAGE_AGE_SECONDS=900
LOG_LEVEL=info
