{
  "name": "supportify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && node scripts/vercel-migrate.mjs && next build",
    "seed:perf": "tsx prisma/seed-perf.ts",
    "seed:distribution-os": "tsx prisma/seed-distribution-os.ts",
    "simulate:whatsapp": "tsx scripts/simulate-whatsapp.ts",
    "evals": "tsx src/lib/agents/evals/cli.ts",
    "layout-budget:seed": "tsx scripts/layout-budget/seed.ts && tsx scripts/layout-budget/seed-outcomes.ts && tsx scripts/layout-budget/seed-partners.ts && tsx scripts/layout-budget/seed-referrals.ts && tsx scripts/layout-budget/seed-approvals.ts && tsx scripts/layout-budget/seed-attribution.ts && tsx scripts/layout-budget/seed-marketing-degraded.ts",
    "layout-budget": "node scripts/layout-budget/run.mjs",
    "flags:docs": "tsx scripts/flags/gen.ts",
    "flags:check": "tsx scripts/flags/check.ts",
    "relationships:docs": "tsx scripts/relationships/gen.ts",
    "ci:check": "node scripts/ci/check.mjs",
    "ci:lint-ratchet": "node scripts/ci/lint-ratchet.mjs",
    "ci:scripts-test": "node --test \"scripts/ci/**/*.test.mjs\"",
    "ci:ai-boundary": "node scripts/ci/ai-boundary.mjs",
    "ci:migration-order": "node scripts/ci/migration-order.mjs",
    "ci:migrations": "node scripts/ci/migrations-check.mjs",
    "ci:legacy": "node scripts/ci/legacy-db/run.mjs",
    "ci:legacy:determinism": "node scripts/ci/legacy-db/run.mjs --scale 0.05 --determinism",
    "ci:db-suites": "node scripts/ci/db-suites.mjs",
    "ci:build:off": "next build",
    "ci:build:on": "node scripts/ci/with-env.mjs ci/flags-all-on.env -- next build",
    "ci:e2e": "node scripts/ci/e2e.mjs",
    "seed:e2e": "tsx prisma/seed-e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/pdfkit": "^0.17.6",
    "@vercel/blob": "^2.8.0",
    "@xyflow/react": "^12.11.3",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.34.0",
    "motion": "14.0.0",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "openai": "^7.27.0",
    "papaparse": "^5.7.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode-generator": "^1.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
