// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  RM
  DEALER
  // --- Allvest Distribution OS additions (additive; existing 4 values and all their
  // behavior are completely unchanged) ---
  TEAM_MANAGER // heads a Team spanning RMs and/or Partners; broader than MANAGER's direct-report chain
  PARTNER      // external referral/distribution partner (IFA-style), has a PartnerProfile
  AFFILIATE    // lighter-weight referral-only partner tier, has a PartnerProfile
  DISTRIBUTOR  // partner who manages a network of sub-partners/affiliates, has a PartnerProfile
  FINANCE      // internal finance/ops role for Earnings Engine review & reconciliation
}

enum AvailabilityStatus {
  AVAILABLE
  ON_LEAVE
  UNAVAILABLE
}

model User {
  id                 String              @id @default(cuid())
  decidedProposals   AgentProposal[]     @relation("AgentProposalDecider")
  name               String
  email              String              @unique
  passwordHash       String
  role               Role                @default(RM)
  isActive           Boolean             @default(true)
  capacity           Int? // max active clients this RM should carry — enforced by src/lib/assignment/routing-engine.ts (falls back to 50 when unset)
  availabilityStatus AvailabilityStatus  @default(AVAILABLE) // routing/reassignment signal, independent of isActive (which gates login)
  regions            String[]            @default([]) // empty = no region constraint, matches any client
  languages          String[]            @default([]) // empty = no language constraint, matches any client
  handlesHni         Boolean             @default(false) // required to be routed HNI-tier clients
  hasSeenTour        Boolean             @default(false)
  lastLoginAt        DateTime? // Distribution OS: set on successful sign-in; basis for the Users detail page's "Last signed in" line
  failedLoginAttempts Int                @default(0) // reset to 0 on any successful sign-in
  lockedUntil        DateTime? // set after too many consecutive failures; checked (and cleared once past) in authorize()
  // Forced password change: set by an Admin reset, a new account's temporary password, or a security response;
  // every page and action redirects to /change-password until the user sets a new one.
  mustChangePassword Boolean            @default(false)
  // Sessions signed in before this instant are rejected on their next request (password changed, reset, or a
  // forced sign-out) — see the jwt callback in src/lib/auth/config.ts.
  sessionsValidFrom  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  managerId String?
  manager   User?   @relation("TeamHierarchy", fields: [managerId], references: [id])
  reports   User[]  @relation("TeamHierarchy")

  assignedClients     Client[]             @relation("AssignedRM")
  nextActionFor       Client[]             @relation("NextActionOwner")
  tasks               Task[]
  activities          Activity[]
  notifications       Notification[]
  createdJourneys     Journey[]
  stageChanges        StageHistory[]
  auditLogs           AuditLog[]
  dealerIntroductions DealerIntroduction[] @relation("DealerIntroDealer")

  // --- Distribution OS back-relations (additive; no existing scalar fields touched) ---
  partnerProfile PartnerProfile?
  teamsManaged   Team[]                @relation("TeamManager")
  dataAccessLogs DataAccessLog[]       @relation("DataAccessLogUser")

  hierarchyAssignmentsAsAssignee HierarchyAssignment[] @relation("HierarchyAssignmentAssigneeUser")
  hierarchyAssignmentsAsParent   HierarchyAssignment[] @relation("HierarchyAssignmentParentUser")
  hierarchyAssignmentsCreated    HierarchyAssignment[] @relation("HierarchyAssignmentCreatedBy")

  approvalsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecidedBy")

  tradingAccountsOpened  TradingAccount[]      @relation("TradingAccountRmAtOpening")
  entitlementsGranted    ProductEntitlement[]  @relation("ProductEntitlementGrantedBy")
  advisoryInteractions   AdvisoryInteraction[] @relation("AdvisoryInteractionAdvisor")

  loginAttempts     LoginAttempt[]      @relation("LoginAttemptUser")
  userEvents        UserEvent[]         @relation("UserEventUser")
  deviceTokens      DeviceToken[]       @relation("DeviceTokenUser")
  pushTokens        PushToken[]         @relation("PushTokenUser")
  aiSummaries       AiSummary[]         @relation("AiSummaryUser")
  pushMutedCategories String[]          @default([]) // notification categories this user has muted for phone push (see src/lib/notifications/describe.ts)
  erasureRequested  ErasureRequest[]    @relation("ErasureRequestedBy")

  // --- Earnings Engine back-relations (Workstream 3; additive) ---
  commissionRulesCreated       CommissionRule[]               @relation("CommissionRuleCreatedBy")
  commissionAssignmentsMade    PartnerCommissionAssignment[]  @relation("PartnerCommissionAssignmentAssignedBy")
  payoutRunsCreated            PayoutRun[]                    @relation("PayoutRunCreatedBy")
  payoutRunsApproved           PayoutRun[]                    @relation("PayoutRunApprovedBy")
  commissionAdjustmentsCreated CommissionAdjustment[]         @relation("CommissionAdjustmentCreatedBy")

  // --- Debugger back-relations (additive) ---
  bugReportsFiled    BugReport[] @relation("BugReportReportedBy")
  bugReportsResolved BugReport[] @relation("BugReportResolvedBy")

  // --- Opportunity Management back-relations (additive) ---
  opportunitiesOwned     Opportunity[]             @relation("OpportunityOwner")
  opportunityStageChanges OpportunityStageHistory[] @relation("OpportunityStageHistoryChangedBy")

  // --- Wealth Workspace back-relation (additive) ---
  wealthHealthCheckupsPerformed WealthHealthCheckup[] @relation("WealthHealthCheckupPerformedBy")

  // --- WhatsApp inbox back-relations (additive) ---
  whatsappAccount WhatsAppAccount? @relation("WhatsAppAccountOwner")
  messagesSent    Message[]        @relation("MessageSender")

  // --- Quality Audit back-relation (additive) ---
  conversationReviewsAsReviewer ConversationReview[] @relation("ConversationReviewReviewer")
}

// ---------------------------------------------------------------------------
// Client Onboarding: the core domain
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  NOT_PROCEEDING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Client {
  id                 String       @id @default(cuid())
  agentProposals     AgentProposal[]
  cleverTapSync      CleverTapSync?
  consentRecords     ConsentRecord[]
  mergeSuggestionsA  MergeSuggestion[] @relation("MergeA")
  mergeSuggestionsB  MergeSuggestion[] @relation("MergeB")
  clientCode         String       @unique // generated "CL-00001"
  name               String
  mobile             String? // optional: an inbound Email/Live Chat contact may have no phone at all
  email              String?
  pan                String?      @unique // normalized (trim+uppercase) at write time; exact match is a hard dedup block
  // Matching keys for mobile/email (src/lib/clients/identity-keys.ts) — set automatically on every write by the
  // query extension in src/lib/db/prisma.ts; never written by hand. Every lead source matches on these.
  mobileKey          String?
  emailKey           String?
  // Freshdesk history sync (src/lib/support/freshdesk-sync.ts): when this client's tickets were last pulled, and
  // for which identity — a changed phone/email makes the scheduler pull again.
  freshdeskSyncedAt  DateTime?
  freshdeskSyncKey   String?
  ckycRef            String?      @unique // CKYC reference; exact match is a hard dedup block
  region             String?
  preferredLanguage  String?
  city               String?
  state              String?
  clientType         String?
  investmentCategory String? // "Wealth" | "Broking" | "Wealth & Broking" — free-text, same convention as clientType
  leadSource         String?
  /// Campaign / UTM / platform details for paid and web leads (see src/lib/leads/ingest.ts); null for manual entry.
  leadAttribution    Json?
  /// Broking | Wealth | Mutual Funds | HNI | Existing Customer | Support | Other (see src/lib/intelligence/categories.ts).
  customerCategory   String?
  /// Consent captured at the lead form (DPDP) — null when the lead was entered by hand.
  marketingConsentAt   DateTime?
  marketingConsentText String?
  productInterest    String?
  existingBroker     String?
  tradingExperience  String?
  expectedInvestment Decimal?
  referralSource     String?
  notes              String?
  priority           Priority     @default(MEDIUM)
  status             ClientStatus @default(ACTIVE)
  currentStageId     String
  currentStage       Stage        @relation(fields: [currentStageId], references: [id])
  stageEnteredAt     DateTime     @default(now())
  assignedToId       String?
  assignedTo         User?        @relation("AssignedRM", fields: [assignedToId], references: [id])
  mergedIntoId       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  completedAt        DateTime?

  // Soft-delete/archive — Admin only. Hidden from active views via buildClientWhere(), never
  // physically removed (audit/compliance retention).
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?

  // Joint account holding — null means single-holder (the common case). The Client row itself is
  // always the First Holder's identity; additional holders are AccountHolder rows.
  operatingInstruction OperatingInstruction?
  accountHolders       AccountHolder[]

  // Read-optimized cache of the earliest open Task for this client — written only by
  // syncNextAction(); never trusted for compliance-critical gating (query Task directly there).
  nextActionTitle   String?
  nextActionDueAt   DateTime?
  nextActionOwnerId String?
  nextActionOwner   User?     @relation("NextActionOwner", fields: [nextActionOwnerId], references: [id])

  activities         Activity[]
  tasks              Task[]
  journeyRuns        JourneyRun[]
  messages           Message[]
  documents          Document[]
  stageHistory       StageHistory[]
  kycRecord          KycRecord?
  supportTickets     SupportTicket[]
  kycSteps           KycStep[]
  fundingRecord      FundingRecord?
  dealerIntroduction DealerIntroduction?
  exceptions         Exception[]

  // --- Distribution OS back-relations (additive; no existing scalar fields touched) ---
  householdMemberships HouseholdMember[]
  tradingAccounts      TradingAccount[]
  advisoryInteractions AdvisoryInteraction[]
  revenueEvents        RevenueEvent[]

  // --- Opportunity Management back-relation (additive; post-onboarding layer, Part O) ---
  opportunities Opportunity[]

  // --- Wealth Workspace back-relations (additive; post-onboarding layer, Part O Module 3) ---
  wealthHealthCheckup WealthHealthCheckup?
  smartAllvestProfile SmartAllvestProfile?
  pmsAifHoldings      PmsAifHolding[]
  intelligence        CustomerIntelligence?
  acceptances         AssetClassAcceptance[]
  insights            ConversationInsight[]
  interactionOutcomes InteractionOutcome[]
  segmentMemberships  SegmentMembership[]

  // --- Quality Audit back-relation (additive, Part AG) ---
  conversationReviews ConversationReview[]

  @@index([assignedToId])
  @@index([status])
  @@index([currentStageId])
  @@index([assignedToId, status])
  @@index([assignedToId, currentStageId])
  @@index([currentStageId, createdAt])
  @@index([status, createdAt])
  @@index([assignedToId, createdAt])
  @@index([nextActionDueAt])
  @@index([isDeleted])
  @@index([updatedAt])
  @@index([assignedToId, updatedAt])
  @@index([priority])
  @@index([clientType])
  @@index([investmentCategory])
  @@index([leadSource])
  @@index([status, stageEnteredAt])
  @@index([mobileKey])
  @@index([emailKey])
  deviceCalls DeviceCall[]
  payments ClientPayment[]
}

model Stage {
  id       String  @id @default(cuid())
  name     String  @unique
  sequence Int     @unique
  slaHours Int
  isActive Boolean @default(true)

  clients          Client[]
  stageHistoryTo   StageHistory[] @relation("ToStage")
  stageHistoryFrom StageHistory[] @relation("FromStage")
  exceptions       Exception[]
}

model StageHistory {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  fromStageId String?
  fromStage   Stage?   @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId   String
  toStage     Stage    @relation("ToStage", fields: [toStageId], references: [id])
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())
  reason      String?

  // Populated going forward only — historical rows before this field was added stay null.
  slaMet        Boolean?
  durationHours Float?

  @@index([clientId, changedAt])
}

enum DocumentStatus {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
  NOT_APPLICABLE
}

model Document {
  id              String         @id @default(cuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  // NULL = belongs to the First Holder (the Client row itself); set = belongs to a joint co-holder.
  holderId        String?
  holder          AccountHolder? @relation(fields: [holderId], references: [id])
  documentType    String
  mandatory       Boolean        @default(true)
  status          DocumentStatus @default(PENDING)
  receivedAt      DateTime?
  verifiedAt      DateTime?
  rejectionReason String?
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([holderId])
  @@index([clientId])
}

enum OperatingInstruction {
  JOINTLY
  EITHER_OR_SURVIVOR // valid only with exactly 2 total holders
  ANYONE_OR_SURVIVOR // valid with 2 or 3 total holders
}

enum HolderPosition {
  SECOND
  THIRD
}

// A joint account's Second/Third holder. The First Holder is the Client row itself — never a row
// here. Soft-delete only (isDeleted/deletedAt), same pattern as Client, for audit/compliance
// retention; documents stay attached to a removed holder for history.
model AccountHolder {
  id                     String         @id @default(cuid())
  clientId               String
  client                 Client         @relation(fields: [clientId], references: [id])
  // Nullable so a removed (soft-deleted) holder can be cleared to null, freeing that position slot
  // for a future holder — the @@unique([clientId, position]) constraint isn't partial, so an
  // inactive row must vacate its position rather than block reuse. Always set while isDeleted: false.
  position               HolderPosition?
  name                   String
  mobile                 String?
  email                  String?
  pan                    String? // normalized like Client.pan, but NOT globally unique — a person
  // can legitimately be both an independent client and a joint holder elsewhere.
  ckycRef                String?
  mobileKey              String? // see Client.mobileKey
  emailKey               String?
  relationToFirstHolder  String?
  isDeleted              Boolean        @default(false)
  deletedAt              DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  documents Document[]
  kycSteps  KycStep[]

  @@unique([clientId, position])
  @@index([clientId])
  @@index([mobileKey])
  @@index([emailKey])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  ADDITIONAL_INFO_REQUIRED
}

model KycRecord {
  id               String    @id @default(cuid())
  clientId         String    @unique
  client           Client    @relation(fields: [clientId], references: [id])
  referenceNumber  String?
  status           KycStatus @default(PENDING)
  submissionDate   DateTime?
  submissionMethod String?
  submittedBy      String?
  completionDate   DateTime?
  rejectionReason  String?
  remarks          String?
  updatedAt        DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// KYC pipeline v2 — one row per verification step, per holder. Step order, SLAs and which steps a joint
// holder needs live in code (src/lib/kyc/steps.ts), not here. Seeded on "Submit for KYC"; a client with
// no KycStep rows predates v2 and is approved the old way.
// ---------------------------------------------------------------------------

enum KycStepType {
  PAN_VERIFICATION
  ADDRESS_VERIFICATION // DigiLocker / Aadhaar
  BANK_VERIFICATION // penny-drop + name match
  RISK_PROFILE
  IPV // in-person / video verification
  ESIGN
  KRA
  CKYC
}

enum KycStepStatus {
  NOT_STARTED
  IN_PROGRESS
  VERIFIED
  FAILED
  SKIPPED // not applicable / waived by an approver, with a reason
}

model KycStep {
  id              String         @id @default(cuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  // NULL = the First Holder (the Client row itself), like Document.holderId.
  holderId        String?
  holder          AccountHolder? @relation(fields: [holderId], references: [id])
  // holderId ?? "PRIMARY" — Postgres treats NULLs as distinct, so the unique key can't use holderId directly.
  holderKey       String
  type            KycStepType
  status          KycStepStatus  @default(NOT_STARTED)
  // "manual" or an automation provider key (src/lib/kyc/providers). providerRef = the provider's request id.
  provider        String?
  providerRef     String?
  attempts        Int            @default(0)
  failureReason   String?
  // Non-PII outcome summary only (e.g. { nameMatch: true }) — never raw identity data.
  result          Json?
  decidedById     String?
  decidedAt       DateTime?
  // Drop-off timing: when the step last changed status, and how far re-engagement has escalated since
  // (0 none, 1 RM task + alert, 2 manager escalation). Reset on every status change.
  statusChangedAt DateTime       @default(now())
  reminderLevel   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([clientId, holderKey, type])
  @@index([status, statusChangedAt])
  @@index([holderId])
}

/// A helpdesk ticket (Freshdesk today) linked to a client: created by the ticket webhooks and by the history sync.
/// Status changes update this row and the one TICKET activity it created — never a new timeline row. The ticket's
/// description is deliberately not stored (it can carry personal data); it stays in Freshdesk.
model SupportTicket {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  provider        String // "freshdesk"
  externalId      String
  subject         String?
  status          String?
  priority        String?
  channel         String?
  ticketCreatedAt DateTime?
  ticketUpdatedAt DateTime?
  activityId      String? // the TICKET activity created on first sighting
  lastSyncedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([clientId, ticketCreatedAt])
}

enum FundingStatus {
  PENDING
  PARTIALLY_FUNDED
  FULLY_FUNDED
  NOT_PROCEEDING
}

model FundingRecord {
  id                  String        @id @default(cuid())
  clientId            String        @unique
  client              Client        @relation(fields: [clientId], references: [id])
  status              FundingStatus @default(PENDING)
  amount              Decimal?
  fundingDate         DateTime?
  fundingMethod       String?
  referenceNumber     String?
  remarks             String?
  bankAccountVerified Boolean       @default(false)
  bankAccountLast4    String? // masked reference only — never store a full account number
  bankVerifiedAt      DateTime?
  updatedAt           DateTime      @updatedAt
}

enum DealerIntroStatus {
  PENDING
  SCHEDULED
  COMPLETED
}

model DealerIntroduction {
  id                 String            @id @default(cuid())
  clientId           String            @unique
  client             Client            @relation(fields: [clientId], references: [id])
  dealerId           String? // FK to User (role DEALER); nullable since legacy rows may predate the link
  dealer             User?             @relation("DealerIntroDealer", fields: [dealerId], references: [id])
  dealerName         String?
  introductionMethod String? // Phone | WhatsApp | In-person | Video Call | Other
  scheduledDate      DateTime?
  completedDate      DateTime?
  status             DealerIntroStatus @default(PENDING)
  remarks            String?
  preferredSegments  String[]          @default([]) // Equity | F&O | Commodity | Currency
  riskProfile        String? // Conservative | Moderate | Aggressive
  maxOrderValue      Decimal?
  maxExposureLimit   Decimal?
  updatedAt          DateTime          @updatedAt

  @@index([dealerId])
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

model Exception {
  id                 String          @id @default(cuid())
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id])
  stageId            String
  stage              Stage           @relation(fields: [stageId], references: [id])
  reason             String
  notes              String?
  expectedResumeDate DateTime?
  status             ExceptionStatus @default(OPEN)
  createdAt          DateTime        @default(now())
  resolvedAt          DateTime?

  @@index([clientId, status])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entity    String // "Client" | "Document" | "KycRecord" | "FundingRecord" | "DealerIntroduction" | "Exception"
  entityId  String
  action    String // "stage_changed" | "stage_corrected" | "document_verified" | "hold_started" | "reopened" | ...
  oldValue  Json?
  newValue  Json?
  reason    String?
  timestamp DateTime @default(now())
  // Append-only + hash chain, enforced by DB triggers (migration 20261008000000_tamper_evident_audit_log).
  // seq/prevHash/hash are always set by the BEFORE INSERT trigger — never pass them from app code.
  seq       BigInt   @unique @default(0)
  prevHash  String   @default("")
  hash      String   @default("")

  @@index([entity, entityId])
  @@index([action, timestamp])
}

/// Single row (id = 1) holding the AuditLog chain tip. Written only by the AuditLog insert trigger.
model AuditLogChainHead {
  id   Int    @id @default(1)
  seq  BigInt @default(0)
  hash String @default("")
}

// ---------------------------------------------------------------------------
// Tasks & unified Activity timeline
// ---------------------------------------------------------------------------

enum TaskStatus {
  PENDING
  DONE
  OVERDUE
  CANCELLED
}

enum TaskCategory {
  FOLLOW_UP
  MEETING
  FUNDING
  OTHER
}

model Task {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  title      String
  dueAt      DateTime
  status     TaskStatus   @default(PENDING)
  category   TaskCategory @default(FOLLOW_UP) // powers the Daily RM Report's "Tomorrow's Priorities" breakdown
  slaMinutes Int?
  source     String? // "manual" | "journey:<journeyRunId>" | "stage-engine" | "jira"
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  externalProvider String? // "clickup" | "jira"
  externalId       String? // ClickUp task ID / Jira issue key
  externalUrl      String?

  conversationReview ConversationReview?

  @@index([assignedToId, status])
  @@index([dueAt, status])
  @@index([externalProvider, externalId])
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  CALL
  TICKET
  MESSAGE
  TASK_COMPLETED
  JOURNEY_EVENT
  MEETING // a logged, completed meeting with the client — distinct from a generic NOTE
  CONTACT // a deliberate "I contacted this client today" log, distinct from a generic NOTE
}

model Activity {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  conversationReview ConversationReview?
  deviceCall         DeviceCall?

  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Sentiment Analysis & Quality Audit — AI-driven review of calls (via Exotel's
// ExoVoiceAnalyze transcription) and WhatsApp threads, scored by Claude against a fixed
// rubric (src/lib/ai/quality-rubric.ts), with an optional human review/override on top.
// ---------------------------------------------------------------------------

enum ConversationSourceType {
  CALL
  WHATSAPP_THREAD
}

enum ConversationReviewStatus {
  PENDING_TRANSCRIPT // CALL only — waiting on Exotel's ExoVoiceAnalyze callback
  ANALYZING          // transcript/text ready, Claude call in flight
  ANALYZED
  FAILED
}

model ConversationReview {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  sourceType       ConversationSourceType
  sourceActivityId String?   @unique // CALL: the Activity.id (type CALL) this review covers; null for WHATSAPP_THREAD
  activity         Activity? @relation(fields: [sourceActivityId], references: [id])

  // WHATSAPP_THREAD only — the message-time window this review covers, so the periodic sweep
  // never re-reviews the same messages (watermarked off the max coveredToAt per client).
  coveredFromAt DateTime?
  coveredToAt   DateTime?

  assignedRmId String? // denormalized for getVisibleUserIds-style RM/manager filtering
  status       ConversationReviewStatus @default(PENDING_TRANSCRIPT)
  exotelCallSid String? // CALL only — lets the async callback and the stale-callback sweep find this row

  transcript String? @db.Text // null until Exotel's callback arrives (CALL); always populated at creation (WHATSAPP_THREAD)

  sentimentLabel     String? // "positive" | "neutral" | "negative" | "mixed"
  sentimentScore     Float? // -1..1
  sentimentReasoning String? @db.Text

  qualityScore     Int? // 0-100, sum of per-criterion scores from QUALITY_RUBRIC
  qualityBreakdown Json? // [{criterion, score, maxScore, notes}, ...]

  recommendationText  String?   @db.Text
  recommendationKind  String? // free-text, mirrors Task.source's string convention
  recommendationDueAt DateTime?

  aiModel       String? // recorded per-row for future model-change audits
  aiRawResponse Json? // full parsed Claude response, kept for debugging/re-processing without re-calling Claude
  analyzedAt    DateTime?
  /// Set once ConversationInsight rows have been extracted from this review's transcript (even if none were found).
  insightsExtractedAt DateTime?
  failureReason String? @db.Text

  reviewedById String?
  reviewedBy   User?     @relation("ConversationReviewReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?   @db.Text
  overriddenScore Int?

  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([status])
  @@index([assignedRmId, createdAt])
  @@index([sourceType, sourceActivityId])
  @@index([exotelCallSid])
}

// ---------------------------------------------------------------------------
// Journeys: visual builder graph + runtime state machine
// ---------------------------------------------------------------------------

model Journey {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(false)
  version     Int      @default(1)
  definition  Json // React Flow graph: { nodes: [...], edges: [...] }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  runs JourneyRun[]
}

enum JourneyRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model JourneyRun {
  id            String           @id @default(cuid())
  journeyId     String
  journey       Journey          @relation(fields: [journeyId], references: [id])
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id])
  currentNodeId String?
  status        JourneyRunStatus @default(RUNNING)
  context       Json             @default("{}")
  startedAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  steps JourneyRunStep[]

  @@index([journeyId, clientId])
  @@index([status])
}

model JourneyRunStep {
  id           String     @id @default(cuid())
  runId        String
  run          JourneyRun @relation(fields: [runId], references: [id])
  nodeId       String
  nodeType     String // "trigger" | "action" | "condition" | "wait"
  status       String // "pending" | "success" | "failed" | "skipped"
  result       Json?
  scheduledFor DateTime?
  executedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// Integrations (pluggable connector framework)
// ---------------------------------------------------------------------------

model IntegrationConfig {
  id          String   @id @default(cuid())
  provider    String   @unique // "clevertap" | "exotel" | "freshdesk" | "whatsapp_meta" | "sms_exotel" | ...
  mode        String   @default("mock") // "mock" | "live"
  credentials Json? // encrypted JSON blob (AES-256-GCM) — see src/lib/security/crypto.ts
  settings    Json?
  isEnabled   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Messaging (WhatsApp / SMS)
// ---------------------------------------------------------------------------

model MessageTemplate {
  id         String   @id @default(cuid())
  channel    String // "whatsapp" | "sms"
  provider   String // "meta_cloud" | "gupshup" | "exotel" | ...
  name       String
  externalId String? // provider-registered template id/name
  body       String
  variables  Json?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  channel    String
  provider   String
  direction  MessageDirection
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])
  body       String
  status     MessageStatus    @default(QUEUED)
  externalId String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  // --- WhatsApp inbox (Openwa multi-account) — all nullable so Meta/SMS rows are untouched ---
  accountId    String?
  account      WhatsAppAccount? @relation(fields: [accountId], references: [id])
  senderUserId String? // CRM user who sent it; null for customer messages and phone-mirrored ones
  sender       User?            @relation("MessageSender", fields: [senderUserId], references: [id])
  origin       String? // "customer" | "crm" | "phone" — free-text classifier, same convention as leadSource
  sentAt       DateTime? // WhatsApp's own timestamp; createdAt stays the receive time
  readAt       DateTime? // internal unread tracking for INBOUND messages
  claimedAt    DateTime? // outbox claim by the worker; re-claimable after 60s
  mediaType    String?
  mediaUrl     String?

  @@unique([accountId, externalId])
  @@index([clientId, createdAt])
  @@index([accountId, createdAt])
  @@index([status, accountId])
}

enum WhatsAppAccountStatus {
  DISCONNECTED
  QR_PENDING
  CONNECTING
  CONNECTED
  FAILED
}

// One Openwa session (one WhatsApp number). Owned by at most one RM.
model WhatsAppAccount {
  id          String                @id @default(cuid())
  sessionId   String                @unique // Openwa sessionId, e.g. "rm_1" (no spaces)
  label       String // "RM 1"
  ownerUserId String?               @unique
  owner       User?                 @relation("WhatsAppAccountOwner", fields: [ownerUserId], references: [id])
  phoneNumber String? // digits, filled once CONNECTED
  status      WhatsAppAccountStatus @default(DISCONNECTED)
  qrDataUrl   String? // latest QR — sensitive (grants account takeover); cleared on CONNECTED
  qrUpdatedAt DateTime?
  lastSeenAt  DateTime? // worker heartbeat
  lastError   String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  messages Message[]
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // "stage_sla_breach" | "document_rejected" | "kyc_update" | "funding_pending" | "funding_sla_pending_escalation" | "dealer_intro_pending" | "new_assignment" | "hold_started" | "client_reopened" | "task_overdue" | "task_overdue_escalation" | "inbound_message" | ...
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Idempotency marker for once-a-day scheduled jobs run off the 5-minute cron tick (see
// src/app/api/internal/cron/tick/route.ts). Distinct from Notification, which always requires a
// real User — a system-level "did we already do X today" flag doesn't fit that shape, and the
// unique constraint here doubles as a concurrency-safe mutex (create() races resolve via P2002).
model DailyJobRun {
  id         String   @id @default(cuid())
  jobName    String
  ranForDate String // IST calendar date, "yyyy-MM-dd"
  createdAt  DateTime @default(now())

  @@unique([jobName, ranForDate])
}

// ---------------------------------------------------------------------------
// Distribution OS — Identity & Hierarchy (Workstream 1)
//
// Additive extension of the CRM's identity model to support Partner/Affiliate/Distributor/
// Team Manager/Finance roles alongside the existing Admin/Manager/RM/Dealer roles. Nothing here
// touches User.managerId/manager/reports ("TeamHierarchy") — that relation keeps driving existing
// ADMIN/MANAGER/RM hierarchy exactly as before. HierarchyAssignment is separate, effective-dated
// plumbing for hierarchy shapes the old single self-FK on User can't express.
// ---------------------------------------------------------------------------

enum TeamType {
  RM_TEAM
  PARTNER_TEAM
  DISTRIBUTOR_NETWORK
  FINANCE_OPS
  MANAGEMENT
}

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]
}

model Team {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  code          String   @unique
  type          TeamType
  teamManagerId String?
  teamManager   User?    @relation("TeamManager", fields: [teamManagerId], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hierarchyAssignments HierarchyAssignment[]

  @@index([companyId])
}

enum PartnerType {
  PARTNER
  AFFILIATE
  DISTRIBUTOR
}

enum PartnerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum EmpanelmentStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

// The commercial/business-entity record for PARTNER/AFFILIATE/DISTRIBUTOR-role Users. 1:1 with
// User today. panNumber is intentionally NOT globally unique — a person can legitimately be both
// a Client and a Partner (unlike Client.pan, which is a hard dedup key for lead records).
model PartnerProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id])
  partnerCode       String            @unique // "PTR-00001" — mirrors Client.clientCode convention
  partnerType       PartnerType
  tier              PartnerTier       @default(BRONZE)
  empanelmentStatus EmpanelmentStatus @default(ONBOARDING)
  empanelmentDate   DateTime?
  region            String?
  arnCode           String? // AMFI Registration Number (SEBI/AMFI regulatory code for MF distribution)
  euinCode          String? // Employee Unique Identification Number
  gstin             String? // stored encrypted (encryptJson format) — see src/lib/security/encrypted-fields.ts
  panNumber         String? // stored encrypted (encryptJson format) — see src/lib/security/encrypted-fields.ts
  bankAccountLast4  String? // masked reference only — same convention as FundingRecord.bankAccountLast4
  bankVerifiedAt    DateTime?

  // Commercial roll-up for commission attribution (future Earnings Engine) — deliberately separate
  // from HierarchyAssignment, which drives RBAC/visibility; a partner's commission-parent and
  // RBAC-visibility-parent are allowed to differ.
  parentPartnerProfileId String?
  parentPartnerProfile   PartnerProfile?  @relation("PartnerRollup", fields: [parentPartnerProfileId], references: [id])
  subPartners            PartnerProfile[] @relation("PartnerRollup")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hierarchyAssignmentsAsAssignee HierarchyAssignment[] @relation("HierarchyAssignmentAssigneePartner")
  hierarchyAssignmentsAsParent   HierarchyAssignment[] @relation("HierarchyAssignmentParentPartner")
  sourcedTradingAccounts         TradingAccount[]

  // --- Earnings Engine back-relations (Workstream 3; additive) ---
  commissionAssignments PartnerCommissionAssignment[]
  commissionAccruals    CommissionAccrual[]
  payouts               Payout[]
  commissionAdjustments CommissionAdjustment[]

  @@index([partnerType, empanelmentStatus])
  @@index([parentPartnerProfileId])
}

enum HierarchyRelationType {
  MANAGES_TEAM   // parentUser is the TEAM_MANAGER of assigneeUser/assigneePartner
  TEAM_MEMBER    // assignee belongs to teamId
  SERVICING_RM   // assigneePartner's sourced clients are serviced by parentUser (an RM)
  SUB_PARTNER_OF // assigneePartner rolls up under parentPartner (RBAC view of the distributor network)
}

// Effective-dated hierarchy fabric. Exactly one of assigneeUserId/assigneePartnerId, and exactly
// one of parentUserId/parentPartnerId, is set depending on relationType — enforced in application
// code (src/lib/policy/visibility.ts), matching this codebase's existing convention of app-level
// invariants over DB CHECK constraints (e.g. AccountHolder.position nullability).
model HierarchyAssignment {
  id           String                @id @default(cuid())
  relationType HierarchyRelationType

  assigneeUserId    String?
  assigneeUser      User?           @relation("HierarchyAssignmentAssigneeUser", fields: [assigneeUserId], references: [id])
  assigneePartnerId String?
  assigneePartner   PartnerProfile? @relation("HierarchyAssignmentAssigneePartner", fields: [assigneePartnerId], references: [id])

  parentUserId    String?
  parentUser      User?           @relation("HierarchyAssignmentParentUser", fields: [parentUserId], references: [id])
  parentPartnerId String?
  parentPartner   PartnerProfile? @relation("HierarchyAssignmentParentPartner", fields: [parentPartnerId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  validFrom DateTime  @default(now())
  validTo   DateTime? // null = currently active

  createdById String
  createdBy   User     @relation("HierarchyAssignmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  notes       String?

  @@index([assigneeUserId, validFrom, validTo])
  @@index([assigneePartnerId, validFrom, validTo])
  @@index([parentUserId, validFrom, validTo])
  @@index([parentPartnerId, validFrom, validTo])
  @@index([teamId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

// Generic maker-checker ledger. actionType/entity are free-form Strings, following this
// codebase's existing convention for open-ended classifiers (AuditLog.action, Notification.type,
// Task.source) — new action types register in src/lib/policy/approvals/registry.ts, no migration.
model ApprovalRequest {
  id             String         @id @default(cuid())
  actionType     String         // registry key, e.g. "STAGE_OVERRIDE" | "COMMISSION_ADJUSTMENT"
  entity         String         // "Client" | "PartnerProfile" | "CommissionRule" | "Payout" | ...
  entityId       String
  status         ApprovalStatus @default(PENDING)
  payload        Json           // proposed change; shape defined per actionType by the registry
  reason         String?
  requestedById  String
  requestedBy    User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestedAt    DateTime       @default(now())
  decidedById    String?
  decidedBy      User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  expiresAt      DateTime?
  appliedAt      DateTime? // set once the underlying action actually executes, post-approval
  idempotencyKey String?   @unique // guards double-apply, same precedent as DailyJobRun's @@unique

  @@index([status, actionType])
  @@index([entity, entityId])
  @@index([requestedById])
}

// Append-only record of every time a masked/sensitive field (PAN, mobile, email, bank details)
// was viewed UNMASKED by a user. Distinct from AuditLog (which records changes to records) — this
// records reads of sensitive data, the other half of a real privacy audit trail.
model DataAccessLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("DataAccessLogUser", fields: [userId], references: [id])
  entity     String   // "Client" | "PartnerProfile" | ...
  entityId   String
  fieldName  String   // "pan" | "mobile" | "bankAccountLast4" | ...
  accessedAt DateTime @default(now())
  reason     String?

  @@index([entity, entityId])
  @@index([userId, accessedAt])
}

// ---------------------------------------------------------------------------
// Distribution OS — Client & Product 360 (Workstream 2)
//
// Household groups multiple existing Clients (family members); TradingAccount is the brokerage/
// demat account under a Client (named TradingAccount, not "Account", to avoid colliding with the
// existing AccountHolder model, which means a joint co-holder of a Client's KYC record — an
// unrelated concept). Product/Position/Transaction are new, wholly independent of the existing
// onboarding-pipeline models. ProductEntitlement and AdvisoryInteraction fill out the full
// "Client & Product 360" domain from the original spec (segment/product entitlement gating, and a
// SEBI-style compliance record of advice given) — both omitted from the first Workstream 2 design
// pass and added here.
//
// Position/Transaction are meant to sync from an external trading/back-office system via a
// generic batch-file adapter (vendor not yet chosen) — sourceSystem/externalRef on each row is
// the idempotent-upsert key for that future sync, mirroring Document.externalProvider/externalId
// (ClickUp/Jira) and DailyJobRun's precedent. Until that adapter exists, the same fields are
// populated by the CSV-based ingestion built alongside this schema (src/app/(dashboard)/households
// bulk-import, mirroring the existing Clients CSV Bulk Import pattern).
// ---------------------------------------------------------------------------

model Household {
  id            String   @id @default(cuid())
  householdCode String   @unique // "HH-00001"
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members HouseholdMember[]
}

// Many-to-many join: a Household groups multiple existing Clients (family members).
model HouseholdMember {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  relationship String? // "Self" | "Spouse" | "Child" | "Parent" | ...
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@unique([householdId, clientId])
  @@index([clientId])
}

enum TradingAccountType {
  EQUITY
  COMMODITY
  CURRENCY
  MUTUAL_FUND
  PMS
  INSURANCE
  NPS
  OTHER
}

enum TradingAccountStatus {
  ACTIVE
  DORMANT
  CLOSED
  SUSPENDED
}

enum Depository {
  NSDL
  CDSL
}

// The brokerage/demat account. Named TradingAccount (not "Account") specifically to avoid
// colliding with the existing AccountHolder model (a joint co-holder of a Client's KYC record).
model TradingAccount {
  id                String               @id @default(cuid())
  accountNumber     String               @unique
  clientId          String
  client            Client               @relation(fields: [clientId], references: [id])
  accountType       TradingAccountType
  status            TradingAccountStatus @default(ACTIVE)
  segments          String[]             @default([]) // mirrors DealerIntroduction.preferredSegments
  depository        Depository?
  dpId              String?
  boId              String?
  openedAt          DateTime?
  closedAt          DateTime?
  rmAtOpeningId     String?
  rmAtOpening       User?                @relation("TradingAccountRmAtOpening", fields: [rmAtOpeningId], references: [id])
  sourcingPartnerId String?
  sourcingPartner   PartnerProfile?      @relation(fields: [sourcingPartnerId], references: [id])
  // Idempotent-upsert keys for the batch-feed adapter / CSV ingestion.
  sourceSystem      String?
  externalRef       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  positions            Position[]
  transactions         Transaction[]
  entitlements         ProductEntitlement[]
  advisoryInteractions AdvisoryInteraction[]
  revenueEvents        RevenueEvent[]

  @@unique([sourceSystem, externalRef])
  @@index([clientId])
  @@index([sourcingPartnerId])
  payments ClientPayment[]
}

enum ProductCategory {
  EQUITY
  MUTUAL_FUND
  PMS
  INSURANCE
  BOND
  FIXED_DEPOSIT
  NPS
  AIF
  OTHER
}

// Instrument/product master data, eventually synced from AMC/back-office feeds.
model Product {
  id           String          @id @default(cuid())
  productCode  String          @unique
  name         String
  category     ProductCategory
  subCategory  String?
  isin         String?         @unique
  amcName      String?
  riskCategory String?
  sourceSystem String?
  externalRef  String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  positions            Position[]
  transactions         Transaction[]
  advisoryInteractions AdvisoryInteraction[]

  @@unique([sourceSystem, externalRef])
}

// Portfolio holding snapshot — unrelated to the existing HolderPosition enum (SECOND/THIRD
// co-holder ordinal); this "Position" is a quantity/value holding of a Product in a TradingAccount
// as of a given batch-feed date.
model Position {
  id               String         @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Decimal
  avgCost          Decimal?
  currentValue     Decimal?
  asOfDate         DateTime // batch-file snapshot date; rows accumulate per date (append-only, enables AUM trend)
  sourceSystem     String
  externalRef      String // source system's unique key for this holding row
  /// Sender's monotonic version of this row (portfolio feed); a feed update applies only when strictly newer. Null for other sources.
  feedRevision     Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceSystem, externalRef, asOfDate])
  @@index([tradingAccountId, asOfDate])
  @@index([productId])
}

enum TransactionType {
  BUY
  SELL
  SIP
  REDEMPTION
  DIVIDEND
  SWITCH_IN
  SWITCH_OUT
  CHARGES
  OTHER
}

// Brokerage/investment transaction fact — distinct from the existing Activity/StageHistory
// timeline models, which track onboarding-process events, not financial transactions.
model Transaction {
  id               String          @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount  @relation(fields: [tradingAccountId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  transactionType  TransactionType
  transactionDate  DateTime
  settlementDate   DateTime?
  quantity         Decimal?
  price            Decimal?
  grossAmount      Decimal
  netAmount        Decimal?
  brokerageAmount  Decimal?
  taxes            Json?
  sourceSystem     String
  externalRef      String
  /// Sender's monotonic version of this row (portfolio feed); a feed update applies only when strictly newer. Null for other sources.
  feedRevision     Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  revenueEvents RevenueEvent[]

  @@unique([sourceSystem, externalRef])
  @@index([tradingAccountId, transactionDate])
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// Which product categories/segments a TradingAccount is entitled to transact in — the standard
// broking-industry "segment enablement" concept (e.g. F&O requires a signed risk disclosure; PMS/
// AIF requires accredited-investor status). Gates what a future order/transaction pipeline should
// accept for an account; this table only records the entitlement decision itself.
model ProductEntitlement {
  id               String             @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount     @relation(fields: [tradingAccountId], references: [id])
  category         ProductCategory
  status           EntitlementStatus  @default(ACTIVE)
  grantedAt        DateTime           @default(now())
  revokedAt        DateTime?
  grantedById      String
  grantedBy        User               @relation("ProductEntitlementGrantedBy", fields: [grantedById], references: [id])
  notes            String?

  @@unique([tradingAccountId, category])
  @@index([tradingAccountId, status])
}

enum AdvisoryInteractionType {
  RECOMMENDATION
  PORTFOLIO_REVIEW
  RISK_PROFILING
  COMPLAINT_DISCUSSION
  OTHER
}

// A logged record of investment advice given to a client — distinct from the existing Activity
// timeline (onboarding/process events) and Message (communication log): this is the compliance
// record of what advice was given and why, the kind of record SEBI investment-adviser regulations
// expect to be traceable.
model AdvisoryInteraction {
  id                String                  @id @default(cuid())
  clientId          String
  client            Client                  @relation(fields: [clientId], references: [id])
  tradingAccountId  String?
  tradingAccount    TradingAccount?         @relation(fields: [tradingAccountId], references: [id])
  productId         String?
  product           Product?                @relation(fields: [productId], references: [id])
  advisorId         String
  advisor           User                    @relation("AdvisoryInteractionAdvisor", fields: [advisorId], references: [id])
  type              AdvisoryInteractionType
  recommendation    String?
  rationale         String?
  clientRiskProfile String?
  interactionDate   DateTime                @default(now())
  createdAt         DateTime                @default(now())

  @@index([clientId, interactionDate])
  @@index([tradingAccountId])
}

// ---------------------------------------------------------------------------
// Distribution OS — Workstream 1 completion: security hardening (contained pieces only)
//
// Full MFA and IP-allowlist enforcement are deliberately NOT modeled here — MFA needs a real
// enrollment/verification UI of its own, and IP enforcement needs request-IP plumbing this app
// has no mechanism for today (no middleware.ts exists anywhere in the project). Both are follow-up
// work; see the plan's "Security hardening — built vs. deferred" section.
// ---------------------------------------------------------------------------

enum RetentionAction {
  ARCHIVE
  ANONYMIZE
  DELETE
}

model DataRetentionPolicy {
  id            String          @id @default(cuid())
  entity        String          // "Client" | "PartnerProfile" | "Transaction" | ...
  retentionDays Int
  action        RetentionAction
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum ErasureStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

// Routes through the existing ApprovalRequest maker-checker flow — erasure is exactly the kind of
// sensitive, hard-to-reverse action that engine exists for. approvalRequestId is an app-level
// reference (mirrors AuditLog.entityId's polymorphic-reference convention), not a DB FK.
model ErasureRequest {
  id                String        @id @default(cuid())
  subjectType       String        // "Client" | "PartnerProfile"
  subjectId         String
  requestedById     String
  requestedBy       User          @relation("ErasureRequestedBy", fields: [requestedById], references: [id])
  status            ErasureStatus @default(PENDING)
  approvalRequestId String?
  requestedAt       DateTime      @default(now())
  completedAt       DateTime?
  notes             String?
}

/// One row per accepted webhook delivery, keyed by source + a delivery key (the provider's event id, or a
/// SHA-256 of the raw body). A provider retry of the same delivery hits the unique key and is acknowledged
/// without being processed twice. Pruned after 7 days by the cron tick.
model WebhookDelivery {
  id         String   @id @default(cuid())
  source     String
  eventKey   String
  receivedAt DateTime @default(now())

  @@unique([source, eventKey])
  @@index([receivedAt])
}

/// Fixed-window request counters for rate limiting (src/lib/security/rate-limit.ts). key = name:identifier:window.
model RateLimitCounter {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// Every sign-in attempt, success or failure — the audit trail backing the lockout fields on User
// and the first real answer to "who's trying to log in as me".
model LoginAttempt {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation("LoginAttemptUser", fields: [userId], references: [id])
  email       String   // captured even on failed attempts where no user matches
  success     Boolean
  ipAddress   String?
  userAgent   String?
  attemptedAt DateTime @default(now())

  @@index([userId, attemptedAt])
  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

// Android app call-log sync. Each phone registers once (after in-app consent) and gets a revocable
// token; only the SHA-256 hash is stored. See src/lib/device/*.
model DeviceToken {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation("DeviceTokenUser", fields: [userId], references: [id])
  tokenHash       String       @unique
  label           String // "Android phone"
  appVersion      String?
  createdAt       DateTime     @default(now())
  lastSeenAt      DateTime?
  lastSyncAt      DateTime?
  lastSyncMatched Int          @default(0)
  revokedAt       DateTime?
  calls           DeviceCall[]

  @@index([userId])
}

// Dedupe ledger + link to the CALL Activity each synced call produced. Only calls whose number matches
// one of the caller's clients are ever stored — everything else is discarded at ingest.
model DeviceCall {
  id              String      @id @default(cuid())
  userId          String
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])
  deviceTokenId   String
  deviceToken     DeviceToken @relation(fields: [deviceTokenId], references: [id])
  activityId      String      @unique
  activity        Activity    @relation(fields: [activityId], references: [id])
  phoneKey        String // last 10 digits of the client's number
  direction       String // INCOMING | OUTGOING | MISSED | REJECTED | OTHER
  startedAt       DateTime
  durationSeconds Int
  createdAt       DateTime    @default(now())

  @@unique([userId, phoneKey, startedAt, direction])
  @@index([clientId, startedAt])
}

// Firebase (FCM) registration token of a phone running the Android app. A token belongs to whoever is
// signed in on that phone — registering it again under another user moves it (shared phones).
model PushToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("PushTokenUser", fields: [userId], references: [id])
  token      String    @unique
  platform   String    @default("android")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([userId])
}

enum AssignmentMode {
  LOAD_BASED // fewest active clients among eligible RMs (the original behaviour)
  ROUND_ROBIN // rotate through eligible RMs in a fixed order
  MANUAL // no automatic assignment — leads wait unassigned and Admins/Managers are alerted
}

// Singleton (id = "default") holding how new leads are assigned. Read through getAssignmentSettings().
model AssignmentSettings {
  id                 String         @id @default("default")
  mode               AssignmentMode @default(LOAD_BASED)
  roundRobinCursorId String? // last RM handed a lead in ROUND_ROBIN mode
  updatedAt          DateTime       @updatedAt
  updatedById        String?
}

enum PaymentType {
  FUNDS_IN
  FUNDS_OUT
  FEE
  OTHER
}

// A money movement for a client (funds received, withdrawals, fees) as recorded in the back office.
// Imported idempotently by (sourceSystem, externalRef) — CSV today, a live feed adapter later.
model ClientPayment {
  id               String          @id @default(cuid())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  tradingAccountId String?
  tradingAccount   TradingAccount? @relation(fields: [tradingAccountId], references: [id])
  paymentType      PaymentType     @default(FUNDS_IN)
  amount           Decimal
  paidAt           DateTime
  mode             String? // UPI | NEFT | RTGS | IMPS | CHEQUE ...
  referenceNumber  String?
  status           String          @default("SUCCESS") // SUCCESS | PENDING | FAILED
  sourceSystem     String
  externalRef      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([sourceSystem, externalRef])
  @@index([clientId, paidAt])
}

// Cached AI page summaries. Keyed by a hash of the exact facts sent, so unchanged data is served from
// here without another API call; also used to rate-limit generations per user.
model AiSummary {
  id          String   @id @default(cuid())
  kind        String // client | my_day | management | reports | quality_review
  subjectKey  String // clientId | userId | "<period>" | reviewId ...
  contentHash String
  summary     String   @db.Text
  model       String
  userId      String?
  user        User?    @relation("AiSummaryUser", fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([kind, subjectKey, contentHash])
  @@index([userId, createdAt])
}

enum UserEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PAGE_VIEW
  DATA_CREATE
  DATA_UPDATE
  DATA_DELETE
  EXPORT
}

// Append-only "who did what, when, from where" feed: sign-ins/outs, page views, downloads, and every
// data change made by a signed-in user (captured centrally by the Prisma client extension in
// src/lib/db/prisma.ts). `details` holds field NAMES / row counts only — never values — so this log
// can't leak PAN/mobile/password hashes; old->new values stay in AuditLog.
model UserEvent {
  id        String        @id @default(cuid())
  userId    String? // null for failed logins where the email matches no user
  user      User?         @relation("UserEventUser", fields: [userId], references: [id])
  userEmail String? // snapshot — needed for failed logins
  userRole  Role? // snapshot at event time
  type      UserEventType
  entity    String? // model name for DATA_* events, e.g. "Client"
  entityId  String?
  path      String? // PAGE_VIEW / EXPORT pathname (no query string)
  summary   String? // "Updated Client: priority, region"
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Earnings Engine (Workstream 3): internal estimation & reporting ledger only.
// Never executes a real bank transfer — Payout.status only ever reaches
// RECONCILED_EXTERNALLY once Allvest's real external finance system confirms it there.
// Full traceability: Payout -> PayoutLine -> CommissionAccrual -> RevenueEvent -> Transaction.
// ---------------------------------------------------------------------------

model CommissionPlan {
  id                   String       @id @default(cuid())
  code                 String       @unique
  name                 String
  description          String?
  appliesToPartnerType PartnerType? // null = generic/any
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  rules       CommissionRule[]
  assignments PartnerCommissionAssignment[]
}

enum CommissionRateType {
  PERCENT_OF_GROSS
  PERCENT_OF_NET
  FLAT_PER_TRANSACTION
  SLAB
}

// Effective-dated — a rule's rate can change over time without losing the historical rate that
// applied when a given RevenueEvent was accrued (CommissionAccrual always records which rule +
// computationVersion it used).
model CommissionRule {
  id               String             @id @default(cuid())
  commissionPlanId String
  commissionPlan   CommissionPlan     @relation(fields: [commissionPlanId], references: [id])
  productCategory  ProductCategory?   // null = all categories
  transactionType  TransactionType?   // null = all types
  rateType         CommissionRateType
  percentRate      Decimal?
  flatRate         Decimal?
  validFrom        DateTime           @default(now())
  validTo          DateTime?
  createdById      String
  createdBy        User               @relation("CommissionRuleCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  slabs    CommissionSlab[]
  accruals CommissionAccrual[]

  @@index([commissionPlanId, validFrom, validTo])
}

// Tiered/volume-based rates for rateType = SLAB. Also effective-dated.
model CommissionSlab {
  id               String         @id @default(cuid())
  commissionRuleId String
  commissionRule   CommissionRule @relation(fields: [commissionRuleId], references: [id])
  minAmount        Decimal
  maxAmount        Decimal?
  rate             Decimal
  validFrom        DateTime       @default(now())
  validTo          DateTime?

  @@index([commissionRuleId, validFrom, validTo])
}

// Effective-dated mapping of which plan a partner is on — partners can move plans over time and
// the ledger must recompute/audit correctly against whichever plan was active on a given date.
model PartnerCommissionAssignment {
  id               String         @id @default(cuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  commissionPlanId String
  commissionPlan   CommissionPlan @relation(fields: [commissionPlanId], references: [id])
  validFrom        DateTime       @default(now())
  validTo          DateTime?
  assignedById     String
  assignedBy       User           @relation("PartnerCommissionAssignmentAssignedBy", fields: [assignedById], references: [id])
  createdAt        DateTime       @default(now())

  @@index([partnerProfileId, validFrom, validTo])
}

enum RevenueType {
  BROKERAGE
  TRAIL_COMMISSION
  UPFRONT_COMMISSION
  AMC_PAYOUT
  ADVISORY_FEE
  OTHER
}

// Append-only raw revenue/brokerage fact, ingested idempotently either by syncing from an
// existing Transaction.brokerageAmount (sourceSystem = "txn_sync") or by CSV import
// (sourceSystem = "csv_import") for revenue types with no natural Transaction link. Never updated
// in place — a correction is a new reversal row (reversesEventId) with a negative amount, same
// immutable-ledger discipline as the rest of this design.
model RevenueEvent {
  id                 String          @id @default(cuid())
  sourceSystem       String
  externalRef        String
  transactionId      String?
  transaction        Transaction?    @relation(fields: [transactionId], references: [id])
  tradingAccountId   String?
  tradingAccount     TradingAccount? @relation(fields: [tradingAccountId], references: [id])
  clientId           String?
  client             Client?         @relation(fields: [clientId], references: [id]) // denormalized for query/masking convenience
  revenueType        RevenueType
  grossRevenueAmount Decimal
  eventDate          DateTime
  ingestedAt         DateTime        @default(now())
  rawPayload         Json
  reversesEventId    String?         @unique
  reverses           RevenueEvent?   @relation("RevenueReversal", fields: [reversesEventId], references: [id])
  reversedBy         RevenueEvent?   @relation("RevenueReversal")

  accruals CommissionAccrual[]

  @@unique([sourceSystem, externalRef])
  @@index([tradingAccountId, eventDate])
  @@index([clientId])
}

enum AccrualStatus {
  ACCRUED
  ADJUSTED
  REVERSED
  INCLUDED_IN_PAYOUT
}

// The computed "estimation" layer: applying a CommissionRule to a RevenueEvent for a specific
// partner. computationVersion records a tag of the rule-matching logic used, for reproducibility.
model CommissionAccrual {
  id                 String          @id @default(cuid())
  revenueEventId     String
  revenueEvent       RevenueEvent    @relation(fields: [revenueEventId], references: [id])
  partnerProfileId   String
  partnerProfile     PartnerProfile  @relation(fields: [partnerProfileId], references: [id])
  commissionRuleId   String?
  commissionRule     CommissionRule? @relation(fields: [commissionRuleId], references: [id])
  accrualAmount      Decimal
  accrualDate        DateTime
  status             AccrualStatus   @default(ACCRUED)
  computationVersion String
  computedAt         DateTime        @default(now())

  payoutLines PayoutLine[]

  @@unique([revenueEventId, partnerProfileId, commissionRuleId])
  @@index([partnerProfileId, accrualDate])
}

enum PayoutRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  FINALIZED
  CANCELLED
}

model PayoutRun {
  id           String          @id @default(cuid())
  periodStart  DateTime
  periodEnd    DateTime
  status       PayoutRunStatus @default(DRAFT)
  createdById  String
  createdBy    User            @relation("PayoutRunCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?           @relation("PayoutRunApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  finalizedAt  DateTime?
  notes        String?
  createdAt    DateTime        @default(now())

  payouts Payout[]

  @@unique([periodStart, periodEnd])
}

enum PayoutStatus {
  ESTIMATED
  APPROVED
  RECONCILED_EXTERNALLY // reconciled against Allvest's real external finance/payroll system —
  // this model NEVER executes a transfer itself, per the "estimation & reporting" scope decision
}

model Payout {
  id                 String         @id @default(cuid())
  payoutRunId        String
  payoutRun          PayoutRun      @relation(fields: [payoutRunId], references: [id])
  partnerProfileId   String
  partnerProfile     PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  totalAccrualAmount Decimal
  adjustmentAmount   Decimal        @default(0)
  netPayableAmount   Decimal
  status             PayoutStatus   @default(ESTIMATED)
  externalPayoutRef  String? // filled in once reconciled against the external finance system
  reconciledAt       DateTime?

  lines       PayoutLine[]
  adjustments CommissionAdjustment[]

  @@unique([payoutRunId, partnerProfileId])
}

// The join that makes "full trace from Payout back to raw source transactions" concrete.
model PayoutLine {
  id                  String            @id @default(cuid())
  payoutId            String
  payout              Payout            @relation(fields: [payoutId], references: [id])
  commissionAccrualId String
  commissionAccrual   CommissionAccrual @relation(fields: [commissionAccrualId], references: [id])
  amount              Decimal

  @@unique([payoutId, commissionAccrualId])
}

// Manual corrections (e.g. clawbacks) — always gated by an ApprovalRequest (maker-checker),
// never written directly.
model CommissionAdjustment {
  id                String         @id @default(cuid())
  partnerProfileId  String
  partnerProfile    PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  payoutId          String?
  payout            Payout?        @relation(fields: [payoutId], references: [id])
  amount            Decimal // signed: negative = clawback
  reason            String
  approvalRequestId String? // app-level reference to ApprovalRequest.id, mirroring AuditLog's convention
  createdById       String
  createdBy         User           @relation("CommissionAdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Debugger: any signed-in user can report an issue they hit; Admins are
// notified immediately via the existing Notification bell and triage it here.
// ---------------------------------------------------------------------------

enum BugReportStatus {
  OPEN
  RESOLVED
}

model BugReport {
  id              String          @id @default(cuid())
  reportedById    String
  reportedBy      User            @relation("BugReportReportedBy", fields: [reportedById], references: [id])
  pageUrl         String // window.location.pathname at the moment of reporting
  description     String
  attachmentUrl   String? // Vercel Blob public URL, e.g. a screenshot — optional
  attachmentName  String? // original filename, shown as the link text
  status          BugReportStatus @default(OPEN)
  resolvedById    String?
  resolvedBy      User?           @relation("BugReportResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime        @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Opportunity Management (Module 2 of the RM/Wealth CRM spec, Part O) — a post-onboarding
// layer: applies once a client is Active/Completed in the existing 5-stage onboarding pipeline,
// which this never touches. Client.currentStageId is a single scalar (one stage per client) and
// Stage.name/sequence are globally unique, so that engine isn't reusable for "many concurrent
// records per client across products" — this is a new model family instead, mirroring
// StageHistory's audit shape.
// ---------------------------------------------------------------------------

enum OpportunityProduct {
  MUTUAL_FUND
  BROKING
  PMS
  AIF
  BONDS
  FIXED_INCOME
  UNLISTED_PRE_IPO
  OTHER
}

enum OpportunityStage {
  IDENTIFIED
  DISCUSSED
  INTERESTED
  RECOMMENDATION
  DECISION_PENDING
  COMMITTED
  FUNDED
  INVESTED
  LOST_DEFERRED
}

model Opportunity {
  id             String             @id @default(cuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])
  product        OpportunityProduct
  estimatedValue Decimal
  estimatedAum   Decimal? // forward-looking AUM this opportunity is expected to bring under management —
                          // distinct from estimatedValue (that one product's revenue/transaction size)
  stage          OpportunityStage   @default(IDENTIFIED)
  stageEnteredAt DateTime           @default(now())
  lostReason     String? // populated only when stage = LOST_DEFERRED
  ownerId        String
  owner          User               @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  history OpportunityStageHistory[]

  @@index([clientId, stage])
  @@index([ownerId, stage])
}

// Mirrors StageHistory's shape exactly — one row per transition, for pipeline-value
// re-evaluation and stage-ageing/conversion reporting identical in spirit to the onboarding
// funnel's, computed on read (pure aggregation over these rows, no cached total to keep in sync).
model OpportunityStageHistory {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id])
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  changedById   String
  changedBy     User              @relation("OpportunityStageHistoryChangedBy", fields: [changedById], references: [id])
  changedAt     DateTime          @default(now())
  reason        String?

  @@index([opportunityId, changedAt])
}

// ---------------------------------------------------------------------------
// Wealth Workspace (Module 3 of the RM/Wealth CRM spec, Part O) — another post-onboarding
// layer, independent of Opportunity Management. Section (1) "Existing Portfolio" is a pure
// read/compute over the existing Position/Product/TradingAccount tables (no new schema needed —
// see src/lib/wealth/portfolio-analytics.ts); these two models cover the 0-to-1 pieces the spec
// calls for (a health-checkup workflow and a structured risk-profiling record), each 1:1 with
// Client, string-typed status fields matching this codebase's existing free-form-classifier
// convention (AuditLog.action, Notification.type) rather than a narrow enum that would need a
// migration every time a workflow status is added.
// ---------------------------------------------------------------------------

model WealthHealthCheckup {
  id            String    @id @default(cuid())
  clientId      String    @unique
  client        Client    @relation(fields: [clientId], references: [id])
  status        String    @default("NOT_STARTED") // "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"
  completedAt   DateTime?
  reportUrl     String?
  keyFindings   String?
  performedById String?
  performedBy   User?     @relation("WealthHealthCheckupPerformedBy", fields: [performedById], references: [id])
  updatedAt     DateTime  @updatedAt
}

model SmartAllvestProfile {
  id                     String   @id @default(cuid())
  clientId               String   @unique
  client                 Client   @relation(fields: [clientId], references: [id])
  status                 String   @default("NOT_STARTED") // "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"
  investorRiskProfile    String? // "Conservative" | "Moderate" | "Aggressive"
  goals                  Json? // structured list of {goal, targetAmount, targetDate}
  investmentHorizonYears Int?
  liquidityRequirement   String?
  updatedAt              DateTime @updatedAt
}

// One row per (client, product) — manually-tracked, fixed-list holdings distinct from the
// CSV-fed Position/Product/TradingAccount catalog, which would be overkill for 4 named schemes.
model PmsAifHolding {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  productName  String // "PMS (Allvest)" | "PMS (Walfort)" | "AIF II" | "AIF III" — fixed list, free-text column
  status       String    @default("NOT_INVESTED") // "NOT_INVESTED" | "INVESTED" | "REDEEMED"
  amount       Decimal?
  investedDate DateTime?
  remarks      String?
  updatedAt    DateTime  @updatedAt

  @@unique([clientId, productName])
}

// ---------------------------------------------------------------------------
// Lead intake (ads, website and forms) and go-live readiness
// ---------------------------------------------------------------------------

enum LeadIntakeStatus {
  CREATED
  DUPLICATE
  REJECTED
  ERROR
}

/// Ledger of every lead submission from Meta/Instagram/Google/website forms. (source, externalId) makes a replay or
/// a provider retry idempotent, and rawPayload + status let a failed lead be inspected and retried.
model LeadIntake {
  id          String           @id @default(cuid())
  source      String
  externalId  String
  status      LeadIntakeStatus
  clientId    String?
  rawPayload  Json
  error       String?
  attempts    Int              @default(1)
  receivedAt  DateTime         @default(now())
  processedAt DateTime?

  @@unique([source, externalId])
  @@index([status, receivedAt])
  @@index([source, receivedAt])
  @@index([clientId, source])
}

/// Last time a background loop proved it is alive (key "cron_tick"). Read by /api/health and the Go-Live page.
model SystemHeartbeat {
  key    String   @id
  lastAt DateTime
}

/// Manual go-live checklist ticks (automatic items are computed live and never stored).
model GoLiveCheck {
  itemId     String    @id
  done       Boolean   @default(false)
  note       String?
  doneById   String?
  doneAt     DateTime?
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Customer Intelligence: lifecycle, asset-class acceptance, conversation insights, Next Best Action,
// interaction outcomes and segments (see src/lib/intelligence/*)
// ---------------------------------------------------------------------------

enum AcceptanceLevel {
  HIGH
  MEDIUM
  LOW
}

enum InsightKind {
  INTEREST
  OBJECTION
  QUESTION
  CONCERN
  COMMITMENT
  COMPLAINT
  PRODUCT_DISCUSSED
  DECLINED
  EXTERNAL_HOLDING
  INCORRECT_INFO
  COMPLIANCE_CONCERN
  MISSED_OPPORTUNITY
}

enum InsightStatus {
  OPEN
  DONE
  DISMISSED
}

enum InteractionOutcomeType {
  INTERESTED
  NOT_INTERESTED
  FOLLOW_UP
  CONVERTED
  NOT_RELEVANT
  RM_HANDOVER
  SERVICE_ISSUE
}

/// One live row per client: lifecycle stage, estimates of what the client holds elsewhere, and the cached
/// Next Best Action + situations so lists and management questions don't recompute every client.
model CustomerIntelligence {
  clientId                  String    @id
  client                    Client    @relation(fields: [clientId], references: [id])
  lifecycleStage            String
  lifecycleUpdatedAt        DateTime  @default(now())
  dematTransferStatus       String? // NOT_STARTED | IN_PROGRESS | COMPLETED
  mfTransferStatus          String?
  externalPortfolioEstimate Decimal? // held outside Allvest — an estimate from a conversation, the RM, or an import
  mfTransferEstimate        Decimal? // mutual-fund holdings that could be transferred in
  idleCashEstimate          Decimal?
  estimatesSource           String? // "rm" | "ai" | "import"
  estimatesUpdatedAt        DateTime?
  nbaProgramme              String
  nbaAction                 String // Call | WhatsApp | Review | Follow-up | No Action
  nbaTopic                  String?
  nbaReason                 String
  nbaPriority               String // High | Medium | Low
  nbaOwner                  String // RM | CRM | AI Bot | Support
  nbaTiming                 String // Today | This Week | Later | Trigger-based
  priorityScore             Int       @default(0)
  talkingPoints             Json
  situations                Json
  doNotDiscuss              Json
  computedAt                DateTime  @default(now())
  /// Watermark: notes/tickets created before this have already been read for insights.
  lastInsightAt             DateTime?
  nudgerConsideredAt        DateTime? // rotation marker for the nudger cron: when it last considered this customer; null = never

  @@index([nbaPriority, priorityScore])
  @@index([lifecycleStage])
  @@index([computedAt])
}

/// High / Medium / Low per asset class (Mutual Funds, PMS, AIF, Bonds, Broking, Global Investments, Tax Planning).
model AssetClassAcceptance {
  id        String          @id @default(cuid())
  clientId  String
  client    Client          @relation(fields: [clientId], references: [id])
  assetClass String
  level     AcceptanceLevel
  source    String // rule | insight | outcome | manual
  reason    String
  /// An RM's own call: kept until they change it (automatic updates never overwrite it).
  isManual  Boolean         @default(false)
  updatedAt DateTime        @updatedAt

  @@unique([clientId, assetClass])
  @@index([assetClass, level])
}

/// Something a customer said, or something in a conversation worth acting on, extracted by Claude from calls,
/// WhatsApp threads, RM notes and support tickets.
model ConversationInsight {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  kind        InsightKind
  assetClass  String?
  text        String
  status      InsightStatus @default(OPEN)
  /// COMMITMENT: when it was promised for. Others: unused.
  dueAt       DateTime?
  /// COMPLIANCE_CONCERN / INCORRECT_INFO / COMPLAINT: low | medium | high.
  severity    String?
  sourceType  String // CALL | WHATSAPP_THREAD | NOTE | TICKET
  sourceRef   String // ConversationReview id or Activity id
  dedupeKey   String        @unique
  occurredAt  DateTime
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolvedById String?

  @@index([clientId, kind, status])
  @@index([kind, status, occurredAt])
  @@index([assetClass, kind])
}

/// A structured result after any RM / CRM / AI-agent interaction — the feedback that keeps acceptance and the
/// next action honest. RM_HANDOVER carries the AI's summary for the RM.
model InteractionOutcome {
  id         String                 @id @default(cuid())
  clientId   String
  client     Client                 @relation(fields: [clientId], references: [id])
  outcome    InteractionOutcomeType
  channel    String // CALL | WHATSAPP | MEETING | EMAIL | AI_BOT | OTHER
  actorType  String // RM | CRM | AI_AGENT
  actorId    String?
  assetClass String?
  programme  String?
  note       String?
  summary    String?
  followUpAt DateTime?
  createdAt  DateTime               @default(now())

  @@index([clientId, createdAt])
  @@index([outcome, createdAt])
}

/// Which saved customer segment a client is currently in (KYC drop-off, unfunded, dormant…). Entering a segment
/// is what triggers a journey's "customer enters segment" trigger.
model SegmentMembership {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  segment   String
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?

  @@unique([clientId, segment])
  @@index([segment, exitedAt])
}

enum AgentProposalStatus {
  DRAFT
  APPROVED
  SENT
  REJECTED
  EXPIRED
  BLOCKED
}

model AgentProposal {
  id           String              @id @default(cuid())
  agentKey     String
  clientId     String
  client       Client              @relation(fields: [clientId], references: [id])
  programme    String?
  channel      String              @default("whatsapp")
  body         String
  originalBody String
  reason       String
  status       AgentProposalStatus @default(DRAFT)
  blockedReason String?
  provider     String
  model        String
  inputTokens  Int                 @default(0)
  outputTokens Int                 @default(0)
  decidedById  String?
  decidedBy    User?               @relation("AgentProposalDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  messageId    String?
  createdAt    DateTime            @default(now())
  expiresAt    DateTime

  @@index([status, createdAt])
  @@index([clientId, createdAt])
}

model AgentSetting {
  agentKey    String   @id
  enabled     Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Suggest-only duplicate-customer pair (see src/lib/identity). Never causes a merge by itself.
model MergeSuggestion {
  id        String    @id @default(cuid())
  clientAId String
  clientA   Client    @relation("MergeA", fields: [clientAId], references: [id])
  clientBId String
  clientB   Client    @relation("MergeB", fields: [clientBId], references: [id])
  score     Float
  reasons   String[]
  status    String    @default("OPEN") // OPEN | MERGED | DISMISSED
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@unique([clientAId, clientBId])
  @@index([status, score])
}

model CleverTapSync {
  id           String   @id @default(cuid())
  clientId     String   @unique
  client       Client   @relation(fields: [clientId], references: [id])
  lastHash     String
  lastPushedAt DateTime @default(now())
  lastError    String?
  lastCheckedAt DateTime?
}

/// Consent and do-not-contact ledger. Append-only: a withdrawal is a new row, and the current state is the latest
/// row per (clientId, purpose, channel). purpose, status and source are enum-like text (see src/lib/consent/policy.ts).
/// capturedById is a plain id (no FK) so removing a user never touches the evidence.
model ConsentRecord {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  purpose        String
  channel        String?
  status         String
  source         String
  noticeVersion  String?
  noticeTextHash String?
  capturedAt     DateTime @default(now())
  capturedById   String?
  evidenceRef    String?
  reason         String?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([clientId, purpose, channel, capturedAt(sort: Desc)])
  @@index([purpose, status, capturedAt])
}

// ---------------------------------------------------------------------------
// Marketing: ad-platform reporting (read-only). One row per campaign per account-local calendar day, upserted by the
// sync job (src/lib/marketing/sync-meta.ts). Deliberately no foreign key to Client: this holds platform-reported
// numbers only, never personal data, so the data-privacy erasure transaction needs no change.
// ---------------------------------------------------------------------------
model AdCampaignDaily {
  id              String   @id @default(cuid())
  provider        String // "meta"
  accountId       String // ad account id, without the "act_" prefix
  campaignId      String
  campaignName    String
  /// Calendar day in the ad account's own timezone (the platform reports days that way).
  date            DateTime @db.Date
  /// Spend in minor units of `currency` (paise, cents ...).
  spendMinor      BigInt
  currency        String // ISO 4217, as reported by the account
  impressions     Int
  clicks          Int
  reach           Int
  /// Leads as reported by the platform (can lag the CRM; re-synced over a trailing window).
  leads           Int
  accountTimezone String?
  syncedAt        DateTime

  @@unique([provider, accountId, campaignId, date])
  @@index([provider, accountId, date])
  @@index([date])
}

// One row per sync attempt. status: SUCCESS | PARTIAL | FAILED | RATE_LIMITED.
model AdSyncRun {
  id              String    @id @default(cuid())
  provider        String
  accountId       String?
  windowStart     DateTime? @db.Date
  windowEnd       DateTime? @db.Date
  status          String
  error           String? // short, sanitised message only (never a response body or token)
  rowsUpserted    Int       @default(0)
  campaignsSeen   Int       @default(0)
  windowsOk       Int       @default(0)
  windowsFailed   Int       @default(0)
  startedAt       DateTime
  finishedAt      DateTime?

  @@index([provider, startedAt])
}

/// Back-office file import (BACKOFFICE_IMPORT_ENABLED). Singleton (id = "default"): the column-mapping config an Admin edits in Settings.
model BackOfficeImportConfig {
  id          String   @id @default("default")
  mapping     Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// One row per import attempt (dry run or real). `seq` is the monotonic revision stamped on rows that carry no revision column.
/// Holds counts and per-row error codes only: never file contents, identifiers or values.
model BackOfficeImportRun {
  id         String    @id @default(cuid())
  seq        Int       @unique @default(autoincrement())
  kind       String // CLIENTS | HOLDINGS | TRANSACTIONS
  fileName   String
  checksum   String // sha256 of the file bytes
  dryRun     Boolean   @default(false)
  trigger    String // CRON | UPLOAD
  status     String // RUNNING | SUCCESS | PARTIAL | FAILED | SKIPPED_DUPLICATE
  counts     Json?
  errors     Json?
  userId     String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([checksum, kind, status])
  @@index([startedAt])
}
