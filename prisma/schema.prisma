// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  RM
  DEALER
  // --- Allvest Distribution OS additions (additive; existing 4 values and all their
  // behavior are completely unchanged) ---
  TEAM_MANAGER // heads a Team spanning RMs and/or Partners; broader than MANAGER's direct-report chain
  PARTNER // external referral/distribution partner (IFA-style), has a PartnerProfile
  AFFILIATE // lighter-weight referral-only partner tier, has a PartnerProfile
  DISTRIBUTOR // partner who manages a network of sub-partners/affiliates, has a PartnerProfile
  FINANCE // internal finance/ops role for Earnings Engine review & reconciliation
  MARKETING // internal marketing hire: the Marketing workspace only, aggregated and pseudonymous data, no customer or RM work (src/lib/access)
}

enum AvailabilityStatus {
  AVAILABLE
  ON_LEAVE
  UNAVAILABLE
}

model User {
  id                  String             @id @default(cuid())
  decidedProposals    AgentProposal[]    @relation("AgentProposalDecider")
  auditFindingsAbout  AuditFinding[]     @relation("AuditFindingSubject")
  auditFindingsResolved AuditFinding[]   @relation("AuditFindingResolver")
  name                String
  email               String             @unique
  passwordHash        String
  role                Role               @default(RM)
  isActive            Boolean            @default(true)
  capacity            Int? // max active clients this RM should carry — enforced by src/lib/assignment/routing-engine.ts (falls back to 50 when unset)
  availabilityStatus  AvailabilityStatus @default(AVAILABLE) // routing/reassignment signal, independent of isActive (which gates login)
  regions             String[]           @default([]) // empty = no region constraint, matches any client
  languages           String[]           @default([]) // empty = no language constraint, matches any client
  handlesHni          Boolean            @default(false) // required to be routed HNI-tier clients
  hasSeenTour         Boolean            @default(false)
  lastLoginAt         DateTime? // Distribution OS: set on successful sign-in; basis for the Users detail page's "Last signed in" line
  callPhone          String? // the user's own phone for click-to-call: Exotel rings this first, then connects the client
  callSessions       CallSession[]
  failedLoginAttempts Int                @default(0) // reset to 0 on any successful sign-in
  lockedUntil         DateTime? // set after too many consecutive failures; checked (and cleared once past) in authorize()
  // Forced password change: set by an Admin reset, a new account's temporary password, or a security response;
  // every page and action redirects to /change-password until the user sets a new one.
  mustChangePassword  Boolean            @default(false)
  // Sessions signed in before this instant are rejected on their next request (password changed, reset, or a
  // forced sign-out) — see the jwt callback in src/lib/auth/config.ts.
  sessionsValidFrom   DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  managerId String?
  manager   User?   @relation("TeamHierarchy", fields: [managerId], references: [id])
  reports   User[]  @relation("TeamHierarchy")

  assignedClients     Client[]             @relation("AssignedRM")
  nextActionFor       Client[]             @relation("NextActionOwner")
  tasks               Task[]
  activities          Activity[]
  notifications       Notification[]
  createdJourneys     Journey[]
  stageChanges        StageHistory[]
  auditLogs           AuditLog[]
  dealerIntroductions DealerIntroduction[] @relation("DealerIntroDealer")

  // --- Distribution OS back-relations (additive; no existing scalar fields touched) ---
  partnerProfile PartnerProfile?
  teamsManaged   Team[]          @relation("TeamManager")
  dataAccessLogs DataAccessLog[] @relation("DataAccessLogUser")

  hierarchyAssignmentsAsAssignee HierarchyAssignment[] @relation("HierarchyAssignmentAssigneeUser")
  hierarchyAssignmentsAsParent   HierarchyAssignment[] @relation("HierarchyAssignmentParentUser")
  hierarchyAssignmentsCreated    HierarchyAssignment[] @relation("HierarchyAssignmentCreatedBy")

  approvalsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsDecided   ApprovalRequest[] @relation("ApprovalDecidedBy")

  tradingAccountsOpened TradingAccount[]      @relation("TradingAccountRmAtOpening")
  entitlementsGranted   ProductEntitlement[]  @relation("ProductEntitlementGrantedBy")
  advisoryInteractions  AdvisoryInteraction[] @relation("AdvisoryInteractionAdvisor")

  loginAttempts       LoginAttempt[]   @relation("LoginAttemptUser")
  userEvents          UserEvent[]      @relation("UserEventUser")
  deviceTokens        DeviceToken[]    @relation("DeviceTokenUser")
  pushTokens          PushToken[]      @relation("PushTokenUser")
  aiSummaries         AiSummary[]      @relation("AiSummaryUser")
  pushMutedCategories String[]         @default([]) // notification categories this user has muted for phone push (see src/lib/notifications/describe.ts)
  erasureRequested    ErasureRequest[] @relation("ErasureRequestedBy")

  // --- Earnings Engine back-relations (Workstream 3; additive) ---
  commissionRulesCreated       CommissionRule[]              @relation("CommissionRuleCreatedBy")
  commissionAssignmentsMade    PartnerCommissionAssignment[] @relation("PartnerCommissionAssignmentAssignedBy")
  payoutRunsCreated            PayoutRun[]                   @relation("PayoutRunCreatedBy")
  payoutRunsApproved           PayoutRun[]                   @relation("PayoutRunApprovedBy")
  commissionAdjustmentsCreated CommissionAdjustment[]        @relation("CommissionAdjustmentCreatedBy")

  // --- Debugger back-relations (additive) ---
  bugReportsFiled    BugReport[] @relation("BugReportReportedBy")
  bugReportsResolved BugReport[] @relation("BugReportResolvedBy")

  // --- Opportunity Management back-relations (additive) ---
  opportunitiesOwned      Opportunity[]             @relation("OpportunityOwner")
  rmTargets              RmTarget[]                @relation("RmTargetUser")
  rmTargetsSet           RmTarget[]                @relation("RmTargetSetBy")
  opportunityStageChanges OpportunityStageHistory[] @relation("OpportunityStageHistoryChangedBy")

  // --- Wealth Workspace back-relation (additive) ---
  wealthHealthCheckupsPerformed WealthHealthCheckup[] @relation("WealthHealthCheckupPerformedBy")

  // --- WhatsApp inbox back-relations (additive) ---
  whatsappAccount WhatsAppAccount? @relation("WhatsAppAccountOwner")
  messagesSent    Message[]        @relation("MessageSender")

  // --- Quality Audit back-relation (additive) ---
  conversationReviewsAsReviewer ConversationReview[] @relation("ConversationReviewReviewer")
  dataExportsRequested DataExport[] @relation("DataExportRequestedBy")
}

// ---------------------------------------------------------------------------
// Client Onboarding: the core domain
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  NOT_PROCEEDING
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Client {
  id                 String       @id @default(cuid())
  agentProposals     AgentProposal[]
  auditFindings      AuditFinding[]
  cleverTapSync      CleverTapSync?
  referrer           Referrer?
  referredBy         Referral?
  referralDevices    ReferralDevice[]
  consentRecords     ConsentRecord[]
  conversionOutbox   ConversionOutbox[]
  mergeSuggestionsA  MergeSuggestion[] @relation("MergeA")
  mergeSuggestionsB  MergeSuggestion[] @relation("MergeB")
  clientCode         String       @unique // generated "CL-00001"
  name               String
  mobile             String? // optional: an inbound Email/Live Chat contact may have no phone at all
  email              String?
  pan                String?      @unique // normalized (trim+uppercase) at write time; exact match is a hard dedup block
  // Matching keys for mobile/email (src/lib/clients/identity-keys.ts) — set automatically on every write by the
  // query extension in src/lib/db/prisma.ts; never written by hand. Every lead source matches on these.
  mobileKey            String?
  emailKey             String?
  // Freshdesk history sync (src/lib/support/freshdesk-sync.ts): when this client's tickets were last pulled, and
  // for which identity — a changed phone/email makes the scheduler pull again.
  freshdeskSyncedAt    DateTime?
  freshdeskSyncKey     String?
  ckycRef              String?           @unique // CKYC reference; exact match is a hard dedup block
  region               String?
  preferredLanguage    String?
  city                 String?
  state                String?
  clientType           String?
  investmentCategory   String? // "Wealth" | "Broking" | "Wealth & Broking" — free-text, same convention as clientType
  leadSource           String?
  /// Campaign / UTM / platform details for paid and web leads (see src/lib/leads/ingest.ts); null for manual entry.
  leadAttribution      Json?
  /// Broking | Wealth | Mutual Funds | HNI | Existing Customer | Support | Other (see src/lib/intelligence/categories.ts).
  customerCategory     String?
  /// Consent captured at the lead form (DPDP) — null when the lead was entered by hand.
  marketingConsentAt   DateTime?
  marketingConsentText String?
  productInterest      String?
  existingBroker       String?
  tradingExperience    String?
  expectedInvestment   Decimal?
  referralSource       String?
  notes                String?
  priority             Priority          @default(MEDIUM)
  status               ClientStatus      @default(ACTIVE)
  currentStageId       String
  currentStage         Stage             @relation(fields: [currentStageId], references: [id])
  stageEnteredAt       DateTime          @default(now())
  assignedToId         String?
  assignedTo           User?             @relation("AssignedRM", fields: [assignedToId], references: [id])
  mergedIntoId         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  completedAt          DateTime?

  // Soft-delete/archive — Admin only. Hidden from active views via buildClientWhere(), never
  // physically removed (audit/compliance retention).
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // Joint account holding — null means single-holder (the common case). The Client row itself is
  // always the First Holder's identity; additional holders are AccountHolder rows.
  operatingInstruction OperatingInstruction?
  accountHolders       AccountHolder[]

  // Read-optimized cache of the earliest open Task for this client — written only by
  // syncNextAction(); never trusted for compliance-critical gating (query Task directly there).
  nextActionTitle   String?
  nextActionDueAt   DateTime?
  nextActionOwnerId String?
  nextActionOwner   User?     @relation("NextActionOwner", fields: [nextActionOwnerId], references: [id])

  activities         Activity[]
  tasks              Task[]
  journeyRuns        JourneyRun[]
  messages           Message[]
  documents          Document[]
  stageHistory       StageHistory[]
  kycRecord          KycRecord?
  supportTickets     SupportTicket[]
  callSessions       CallSession[]
  kycSteps           KycStep[]
  fundingRecord      FundingRecord?
  dealerIntroduction DealerIntroduction?
  exceptions         Exception[]

  // --- Distribution OS back-relations (additive; no existing scalar fields touched) ---
  householdMemberships HouseholdMember[]
  tradingAccounts      TradingAccount[]
  advisoryInteractions AdvisoryInteraction[]
  revenueEvents        RevenueEvent[]

  // --- Opportunity Management back-relation (additive; post-onboarding layer, Part O) ---
  opportunities Opportunity[]

  // --- Wealth Workspace back-relations (additive; post-onboarding layer, Part O Module 3) ---
  wealthHealthCheckup WealthHealthCheckup?
  smartAllvestProfile SmartAllvestProfile?
  pmsAifHoldings      PmsAifHolding[]
  intelligence        CustomerIntelligence?
  acceptances         AssetClassAcceptance[]
  insights            ConversationInsight[]
  interactionOutcomes InteractionOutcome[]
  segmentMemberships  SegmentMembership[]

  // --- Quality Audit back-relation (additive, Part AG) ---
  conversationReviews ConversationReview[]

  // --- Partner referral attribution (additive): at most one first-touch record per person ---
  partnerReferralTouch PartnerReferralTouch?
  deviceCalls          DeviceCall[]
  payments             ClientPayment[]

  // --- Customer outcomes and goals (additive; flag NEXT_PUBLIC_OUTCOMES) ---
  customerGoals        CustomerGoal[]
  customerReviews      CustomerReview[]
  suggestionDismissals SuggestionDismissal[]
  outcomeEvents        OutcomeEvent[]

  // --- Campaign attribution: lead push to the assigned RM with a speed-to-lead timer (flag NEXT_PUBLIC_ATTRIBUTION) ---
  leadPushes LeadPush[]

  // --- Wave 2 customer memory and service state (additive back-relations only; no column on Client) ---
  memoryItems                 CustomerMemoryItem[]
  complaints                  Complaint[]
  commitments                 Commitment[]
  householdConsentsAsSubject  HouseholdRelationshipConsent[] @relation("HouseholdConsentSubject")
  householdConsentsAsGrantee  HouseholdRelationshipConsent[] @relation("HouseholdConsentGrantee")

  @@index([assignedToId])
  @@index([status])
  @@index([currentStageId])
  @@index([assignedToId, status])
  @@index([assignedToId, currentStageId])
  @@index([currentStageId, createdAt])
  @@index([status, createdAt])
  @@index([assignedToId, createdAt])
  @@index([nextActionDueAt])
  @@index([isDeleted])
  @@index([updatedAt])
  @@index([assignedToId, updatedAt])
  @@index([priority])
  @@index([clientType])
  @@index([investmentCategory])
  @@index([leadSource])
  @@index([status, stageEnteredAt])
  @@index([mobileKey])
  @@index([emailKey])

  decisionRecords        DecisionRecord[]

}

model Stage {
  id       String  @id @default(cuid())
  name     String  @unique
  sequence Int     @unique
  slaHours Int
  isActive Boolean @default(true)

  clients          Client[]
  stageHistoryTo   StageHistory[] @relation("ToStage")
  stageHistoryFrom StageHistory[] @relation("FromStage")
  exceptions       Exception[]
}

model StageHistory {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  fromStageId String?
  fromStage   Stage?   @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId   String
  toStage     Stage    @relation("ToStage", fields: [toStageId], references: [id])
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())
  reason      String?

  // Populated going forward only — historical rows before this field was added stay null.
  slaMet        Boolean?
  durationHours Float?

  @@index([clientId, changedAt])
}

enum DocumentStatus {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
  NOT_APPLICABLE
}

model Document {
  id              String         @id @default(cuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  // NULL = belongs to the First Holder (the Client row itself); set = belongs to a joint co-holder.
  holderId        String?
  holder          AccountHolder? @relation(fields: [holderId], references: [id])
  documentType    String
  mandatory       Boolean        @default(true)
  status          DocumentStatus @default(PENDING)
  receivedAt      DateTime?
  verifiedAt      DateTime?
  rejectionReason String?
  remarks         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([holderId])
  @@index([clientId])
}

enum OperatingInstruction {
  JOINTLY
  EITHER_OR_SURVIVOR // valid only with exactly 2 total holders
  ANYONE_OR_SURVIVOR // valid with 2 or 3 total holders
}

enum HolderPosition {
  SECOND
  THIRD
}

// A joint account's Second/Third holder. The First Holder is the Client row itself — never a row
// here. Soft-delete only (isDeleted/deletedAt), same pattern as Client, for audit/compliance
// retention; documents stay attached to a removed holder for history.
model AccountHolder {
  id                    String          @id @default(cuid())
  clientId              String
  client                Client          @relation(fields: [clientId], references: [id])
  // Nullable so a removed (soft-deleted) holder can be cleared to null, freeing that position slot
  // for a future holder — the @@unique([clientId, position]) constraint isn't partial, so an
  // inactive row must vacate its position rather than block reuse. Always set while isDeleted: false.
  position              HolderPosition?
  name                  String
  mobile                String?
  email                 String?
  pan                   String? // normalized like Client.pan, but NOT globally unique — a person
  // can legitimately be both an independent client and a joint holder elsewhere.
  ckycRef               String?
  mobileKey             String? // see Client.mobileKey
  emailKey              String?
  relationToFirstHolder String?
  isDeleted             Boolean         @default(false)
  deletedAt             DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  documents Document[]
  kycSteps  KycStep[]

  @@unique([clientId, position])
  @@index([clientId])
  @@index([mobileKey])
  @@index([emailKey])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  ADDITIONAL_INFO_REQUIRED
}

model KycRecord {
  id               String    @id @default(cuid())
  clientId         String    @unique
  client           Client    @relation(fields: [clientId], references: [id])
  referenceNumber  String?
  status           KycStatus @default(PENDING)
  submissionDate   DateTime?
  submissionMethod String?
  submittedBy      String?
  completionDate   DateTime?
  rejectionReason  String?
  remarks          String?
  updatedAt        DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// KYC pipeline v2 — one row per verification step, per holder. Step order, SLAs and which steps a joint
// holder needs live in code (src/lib/kyc/steps.ts), not here. Seeded on "Submit for KYC"; a client with
// no KycStep rows predates v2 and is approved the old way.
// ---------------------------------------------------------------------------

enum KycStepType {
  PAN_VERIFICATION
  ADDRESS_VERIFICATION // DigiLocker / Aadhaar
  BANK_VERIFICATION // penny-drop + name match
  RISK_PROFILE
  IPV // in-person / video verification
  ESIGN
  KRA
  CKYC
}

enum KycStepStatus {
  NOT_STARTED
  IN_PROGRESS
  VERIFIED
  FAILED
  SKIPPED // not applicable / waived by an approver, with a reason
}

model KycStep {
  id              String         @id @default(cuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  // NULL = the First Holder (the Client row itself), like Document.holderId.
  holderId        String?
  holder          AccountHolder? @relation(fields: [holderId], references: [id])
  // holderId ?? "PRIMARY" — Postgres treats NULLs as distinct, so the unique key can't use holderId directly.
  holderKey       String
  type            KycStepType
  status          KycStepStatus  @default(NOT_STARTED)
  // "manual" or an automation provider key (src/lib/kyc/providers). providerRef = the provider's request id.
  provider        String?
  providerRef     String?
  attempts        Int            @default(0)
  failureReason   String?
  // Non-PII outcome summary only (e.g. { nameMatch: true }) — never raw identity data.
  result          Json?
  decidedById     String?
  decidedAt       DateTime?
  // Drop-off timing: when the step last changed status, and how far re-engagement has escalated since
  // (0 none, 1 RM task + alert, 2 manager escalation). Reset on every status change.
  statusChangedAt DateTime       @default(now())
  reminderLevel   Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([clientId, holderKey, type])
  @@index([status, statusChangedAt])
  @@index([holderId])
}

/// A helpdesk ticket (Freshdesk today) linked to a client: created by the ticket webhooks and by the history sync.
/// Status changes update this row and the one TICKET activity it created — never a new timeline row. The ticket's
/// description is deliberately not stored (it can carry personal data); it stays in Freshdesk.
model SupportTicket {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  provider        String // "freshdesk"
  externalId      String
  subject         String?
  status          String?
  priority        String?
  channel         String?
  ticketCreatedAt DateTime?
  ticketUpdatedAt DateTime?
  activityId      String? // the TICKET activity created on first sighting
  lastSyncedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, externalId])
  @@index([clientId, ticketCreatedAt])
}

enum FundingStatus {
  PENDING
  PARTIALLY_FUNDED
  FULLY_FUNDED
  NOT_PROCEEDING
}

model FundingRecord {
  id                  String        @id @default(cuid())
  clientId            String        @unique
  client              Client        @relation(fields: [clientId], references: [id])
  status              FundingStatus @default(PENDING)
  amount              Decimal?
  fundingDate         DateTime?
  fundingMethod       String?
  referenceNumber     String?
  remarks             String?
  bankAccountVerified Boolean       @default(false)
  bankAccountLast4    String? // masked reference only — never store a full account number
  bankVerifiedAt      DateTime?
  updatedAt           DateTime      @updatedAt
}

enum DealerIntroStatus {
  PENDING
  SCHEDULED
  COMPLETED
}

model DealerIntroduction {
  id                 String            @id @default(cuid())
  clientId           String            @unique
  client             Client            @relation(fields: [clientId], references: [id])
  dealerId           String? // FK to User (role DEALER); nullable since legacy rows may predate the link
  dealer             User?             @relation("DealerIntroDealer", fields: [dealerId], references: [id])
  dealerName         String?
  introductionMethod String? // Phone | WhatsApp | In-person | Video Call | Other
  scheduledDate      DateTime?
  completedDate      DateTime?
  status             DealerIntroStatus @default(PENDING)
  remarks            String?
  preferredSegments  String[]          @default([]) // Equity | F&O | Commodity | Currency
  riskProfile        String? // Conservative | Moderate | Aggressive
  maxOrderValue      Decimal?
  maxExposureLimit   Decimal?
  updatedAt          DateTime          @updatedAt

  @@index([dealerId])
}

enum ExceptionStatus {
  OPEN
  RESOLVED
}

model Exception {
  id                 String          @id @default(cuid())
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id])
  stageId            String
  stage              Stage           @relation(fields: [stageId], references: [id])
  reason             String
  notes              String?
  expectedResumeDate DateTime?
  status             ExceptionStatus @default(OPEN)
  createdAt          DateTime        @default(now())
  resolvedAt         DateTime?

  @@index([clientId, status])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entity    String // "Client" | "Document" | "KycRecord" | "FundingRecord" | "DealerIntroduction" | "Exception"
  entityId  String
  action    String // "stage_changed" | "stage_corrected" | "document_verified" | "hold_started" | "reopened" | ...
  oldValue  Json?
  newValue  Json?
  reason    String?
  timestamp DateTime @default(now())
  // Append-only + hash chain, enforced by DB triggers (migration 20261008000000_tamper_evident_audit_log).
  // seq/prevHash/hash are always set by the BEFORE INSERT trigger — never pass them from app code.
  seq       BigInt   @unique @default(0)
  prevHash  String   @default("")
  hash      String   @default("")

  @@index([entity, entityId])
  @@index([action, timestamp])
}

/// Single row (id = 1) holding the AuditLog chain tip. Written only by the AuditLog insert trigger.
model AuditLogChainHead {
  id   Int    @id @default(1)
  seq  BigInt @default(0)
  hash String @default("")
}

// ---------------------------------------------------------------------------
// Tasks & unified Activity timeline
// ---------------------------------------------------------------------------

enum TaskStatus {
  PENDING
  DONE
  OVERDUE
  CANCELLED
}

enum TaskCategory {
  FOLLOW_UP
  MEETING
  FUNDING
  OTHER
}

model Task {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  title      String
  dueAt      DateTime
  status     TaskStatus   @default(PENDING)
  category   TaskCategory @default(FOLLOW_UP) // powers the Daily RM Report's "Tomorrow's Priorities" breakdown
  slaMinutes Int?
  source     String? // "manual" | "journey:<journeyRunId>" | "stage-engine" | "jira"
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  externalProvider String? // "clickup" | "jira"
  externalId       String? // ClickUp task ID / Jira issue key
  externalUrl      String?

  conversationReview ConversationReview?

  @@index([assignedToId, status])
  @@index([dueAt, status])
  @@index([externalProvider, externalId])
  @@index([clientId, createdAt])
}

enum ActivityType {
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  CALL
  TICKET
  MESSAGE
  TASK_COMPLETED
  JOURNEY_EVENT
  MEETING // a logged, completed meeting with the client — distinct from a generic NOTE
  CONTACT // a deliberate "I contacted this client today" log, distinct from a generic NOTE
}

model Activity {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now())

  conversationReview ConversationReview?
  deviceCall         DeviceCall?

  @@index([clientId, createdAt])
}

// ---------------------------------------------------------------------------
// Sentiment Analysis & Quality Audit — AI-driven review of calls (via Exotel's
// ExoVoiceAnalyze transcription) and WhatsApp threads, scored by Claude against a fixed
// rubric (src/lib/ai/quality-rubric.ts), with an optional human review/override on top.
// ---------------------------------------------------------------------------

enum ConversationSourceType {
  CALL
  WHATSAPP_THREAD
}

enum ConversationReviewStatus {
  PENDING_TRANSCRIPT // CALL only — waiting on Exotel's ExoVoiceAnalyze callback
  ANALYZING // transcript/text ready, Claude call in flight
  ANALYZED
  FAILED
}

model ConversationReview {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  sourceType       ConversationSourceType
  sourceActivityId String?                @unique // CALL: the Activity.id (type CALL) this review covers; null for WHATSAPP_THREAD
  activity         Activity?              @relation(fields: [sourceActivityId], references: [id])

  // WHATSAPP_THREAD only — the message-time window this review covers, so the periodic sweep
  // never re-reviews the same messages (watermarked off the max coveredToAt per client).
  coveredFromAt DateTime?
  coveredToAt   DateTime?

  assignedRmId  String? // denormalized for getVisibleUserIds-style RM/manager filtering
  status        ConversationReviewStatus @default(PENDING_TRANSCRIPT)
  exotelCallSid String? // CALL only — lets the async callback and the stale-callback sweep find this row

  transcript String? @db.Text // null until Exotel's callback arrives (CALL); always populated at creation (WHATSAPP_THREAD)

  sentimentLabel     String? // "positive" | "neutral" | "negative" | "mixed"
  sentimentScore     Float? // -1..1
  sentimentReasoning String? @db.Text

  qualityScore     Int? // 0-100, sum of per-criterion scores from QUALITY_RUBRIC
  qualityBreakdown Json? // [{criterion, score, maxScore, notes}, ...]

  recommendationText  String?   @db.Text
  recommendationKind  String? // free-text, mirrors Task.source's string convention
  recommendationDueAt DateTime?

  aiModel             String? // recorded per-row for future model-change audits
  aiRawResponse       Json? // full parsed Claude response, kept for debugging/re-processing without re-calling Claude
  analyzedAt          DateTime?
  /// Set once ConversationInsight rows have been extracted from this review's transcript (even if none were found).
  insightsExtractedAt DateTime?
  failureReason       String?   @db.Text

  reviewedById    String?
  reviewedBy      User?     @relation("ConversationReviewReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  reviewNotes     String?   @db.Text
  overriddenScore Int?

  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, createdAt])
  @@index([status])
  @@index([assignedRmId, createdAt])
  @@index([sourceType, sourceActivityId])
  @@index([exotelCallSid])
}

// ---------------------------------------------------------------------------
// Journeys: visual builder graph + runtime state machine
// ---------------------------------------------------------------------------

model Journey {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(false)
  version     Int      @default(1)
  definition  Json // React Flow graph: { nodes: [...], edges: [...] }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  runs JourneyRun[]
}

enum JourneyRunStatus {
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model JourneyRun {
  id            String           @id @default(cuid())
  journeyId     String
  journey       Journey          @relation(fields: [journeyId], references: [id])
  clientId      String
  client        Client           @relation(fields: [clientId], references: [id])
  currentNodeId String?
  status        JourneyRunStatus @default(RUNNING)
  context       Json             @default("{}")
  startedAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  steps JourneyRunStep[]

  @@index([journeyId, clientId])
  @@index([status])
}

model JourneyRunStep {
  id           String     @id @default(cuid())
  runId        String
  run          JourneyRun @relation(fields: [runId], references: [id])
  nodeId       String
  nodeType     String // "trigger" | "action" | "condition" | "wait"
  status       String // "pending" | "success" | "failed" | "skipped"
  result       Json?
  scheduledFor DateTime?
  executedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([status, scheduledFor])
}

// ---------------------------------------------------------------------------
// Integrations (pluggable connector framework)
// ---------------------------------------------------------------------------

model IntegrationConfig {
  id          String   @id @default(cuid())
  provider    String   @unique // "clevertap" | "exotel" | "freshdesk" | "whatsapp_meta" | "sms_exotel" | ...
  mode        String   @default("mock") // "mock" | "live"
  credentials Json? // encrypted JSON blob (AES-256-GCM) — see src/lib/security/crypto.ts
  settings    Json?
  isEnabled   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Messaging (WhatsApp / SMS)
// ---------------------------------------------------------------------------

model MessageTemplate {
  id         String   @id @default(cuid())
  channel    String // "whatsapp" | "sms"
  provider   String // "meta_cloud" | "gupshup" | "exotel" | ...
  name       String
  externalId String? // provider-registered template id/name
  body       String
  variables  Json?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  channel    String
  provider   String
  direction  MessageDirection
  templateId String?
  template   MessageTemplate? @relation(fields: [templateId], references: [id])
  body       String
  status     MessageStatus    @default(QUEUED)
  externalId String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  // --- WhatsApp inbox (Openwa multi-account) — all nullable so Meta/SMS rows are untouched ---
  accountId    String?
  account      WhatsAppAccount? @relation(fields: [accountId], references: [id])
  senderUserId String? // CRM user who sent it; null for customer messages and phone-mirrored ones
  sender       User?            @relation("MessageSender", fields: [senderUserId], references: [id])
  origin       String? // "customer" | "crm" | "phone" — free-text classifier, same convention as leadSource
  sentAt       DateTime? // WhatsApp's own timestamp; createdAt stays the receive time
  readAt       DateTime? // internal unread tracking for INBOUND messages
  claimedAt    DateTime? // outbox claim by the worker; re-claimable after 60s
  mediaType    String?
  mediaUrl     String?

  @@unique([accountId, externalId])
  @@index([clientId, createdAt])
  @@index([accountId, createdAt])
  @@index([status, accountId])
  @@index([direction, channel, createdAt])
}

enum WhatsAppAccountStatus {
  DISCONNECTED
  QR_PENDING
  CONNECTING
  CONNECTED
  FAILED
}

// One Openwa session (one WhatsApp number). Owned by at most one RM.
model WhatsAppAccount {
  id          String                @id @default(cuid())
  sessionId   String                @unique // Openwa sessionId, e.g. "rm_1" (no spaces)
  label       String // "RM 1"
  ownerUserId String?               @unique
  owner       User?                 @relation("WhatsAppAccountOwner", fields: [ownerUserId], references: [id])
  phoneNumber String? // digits, filled once CONNECTED
  status      WhatsAppAccountStatus @default(DISCONNECTED)
  qrDataUrl   String? // latest QR — sensitive (grants account takeover); cleared on CONNECTED
  qrUpdatedAt DateTime?
  lastSeenAt  DateTime? // worker heartbeat
  lastError   String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  messages Message[]
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String // "stage_sla_breach" | "document_rejected" | "kyc_update" | "funding_pending" | "funding_sla_pending_escalation" | "dealer_intro_pending" | "new_assignment" | "hold_started" | "client_reopened" | "task_overdue" | "task_overdue_escalation" | "inbound_message" | ...
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Idempotency marker for once-a-day scheduled jobs run off the 5-minute cron tick (see
// src/app/api/internal/cron/tick/route.ts). Distinct from Notification, which always requires a
// real User — a system-level "did we already do X today" flag doesn't fit that shape, and the
// unique constraint here doubles as a concurrency-safe mutex (create() races resolve via P2002).
model DailyJobRun {
  id         String   @id @default(cuid())
  jobName    String
  ranForDate String // IST calendar date, "yyyy-MM-dd"
  createdAt  DateTime @default(now())

  @@unique([jobName, ranForDate])
}

// ---------------------------------------------------------------------------
// Distribution OS — Identity & Hierarchy (Workstream 1)
//
// Additive extension of the CRM's identity model to support Partner/Affiliate/Distributor/
// Team Manager/Finance roles alongside the existing Admin/Manager/RM/Dealer roles. Nothing here
// touches User.managerId/manager/reports ("TeamHierarchy") — that relation keeps driving existing
// ADMIN/MANAGER/RM hierarchy exactly as before. HierarchyAssignment is separate, effective-dated
// plumbing for hierarchy shapes the old single self-FK on User can't express.
// ---------------------------------------------------------------------------

enum TeamType {
  RM_TEAM
  PARTNER_TEAM
  DISTRIBUTOR_NETWORK
  FINANCE_OPS
  MANAGEMENT
}

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]
}

model Team {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  code          String   @unique
  type          TeamType
  teamManagerId String?
  teamManager   User?    @relation("TeamManager", fields: [teamManagerId], references: [id])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hierarchyAssignments HierarchyAssignment[]

  @@index([companyId])
}

enum PartnerType {
  PARTNER
  AFFILIATE
  DISTRIBUTOR
}

enum PartnerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum EmpanelmentStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

// The commercial/business-entity record for PARTNER/AFFILIATE/DISTRIBUTOR-role Users. 1:1 with
// User today. panNumber is intentionally NOT globally unique — a person can legitimately be both
// a Client and a Partner (unlike Client.pan, which is a hard dedup key for lead records).
model PartnerProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id])
  partnerCode       String            @unique // "PTR-00001" — mirrors Client.clientCode convention
  partnerType       PartnerType
  tier              PartnerTier       @default(BRONZE)
  empanelmentStatus EmpanelmentStatus @default(ONBOARDING)
  empanelmentDate   DateTime?
  region            String?
  arnCode           String? // AMFI Registration Number (SEBI/AMFI regulatory code for MF distribution)
  euinCode          String? // Employee Unique Identification Number
  gstin             String? // stored encrypted (encryptJson format) — see src/lib/security/encrypted-fields.ts
  panNumber         String? // stored encrypted (encryptJson format) — see src/lib/security/encrypted-fields.ts
  bankAccountLast4  String? // masked reference only — same convention as FundingRecord.bankAccountLast4
  bankVerifiedAt    DateTime?

  // Commercial roll-up for commission attribution (future Earnings Engine) — deliberately separate
  // from HierarchyAssignment, which drives RBAC/visibility; a partner's commission-parent and
  // RBAC-visibility-parent are allowed to differ.
  parentPartnerProfileId String?
  parentPartnerProfile   PartnerProfile?  @relation("PartnerRollup", fields: [parentPartnerProfileId], references: [id])
  subPartners            PartnerProfile[] @relation("PartnerRollup")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hierarchyAssignmentsAsAssignee HierarchyAssignment[] @relation("HierarchyAssignmentAssigneePartner")
  hierarchyAssignmentsAsParent   HierarchyAssignment[] @relation("HierarchyAssignmentParentPartner")
  sourcedTradingAccounts         TradingAccount[]

  // --- Earnings Engine back-relations (Workstream 3; additive) ---
  commissionAssignments PartnerCommissionAssignment[]
  commissionAccruals    CommissionAccrual[]
  payouts               Payout[]
  commissionAdjustments CommissionAdjustment[]
  referralTouches       PartnerReferralTouch[]

  @@index([partnerType, empanelmentStatus])
  @@index([parentPartnerProfileId])
}

enum HierarchyRelationType {
  MANAGES_TEAM // parentUser is the TEAM_MANAGER of assigneeUser/assigneePartner
  TEAM_MEMBER // assignee belongs to teamId
  SERVICING_RM // assigneePartner's sourced clients are serviced by parentUser (an RM)
  SUB_PARTNER_OF // assigneePartner rolls up under parentPartner (RBAC view of the distributor network)
}

// Effective-dated hierarchy fabric. Exactly one of assigneeUserId/assigneePartnerId, and exactly
// one of parentUserId/parentPartnerId, is set depending on relationType — enforced in application
// code (src/lib/policy/visibility.ts), matching this codebase's existing convention of app-level
// invariants over DB CHECK constraints (e.g. AccountHolder.position nullability).
model HierarchyAssignment {
  id           String                @id @default(cuid())
  relationType HierarchyRelationType

  assigneeUserId    String?
  assigneeUser      User?           @relation("HierarchyAssignmentAssigneeUser", fields: [assigneeUserId], references: [id])
  assigneePartnerId String?
  assigneePartner   PartnerProfile? @relation("HierarchyAssignmentAssigneePartner", fields: [assigneePartnerId], references: [id])

  parentUserId    String?
  parentUser      User?           @relation("HierarchyAssignmentParentUser", fields: [parentUserId], references: [id])
  parentPartnerId String?
  parentPartner   PartnerProfile? @relation("HierarchyAssignmentParentPartner", fields: [parentPartnerId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  validFrom DateTime  @default(now())
  validTo   DateTime? // null = currently active

  createdById String
  createdBy   User     @relation("HierarchyAssignmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  notes       String?

  @@index([assigneeUserId, validFrom, validTo])
  @@index([assigneePartnerId, validFrom, validTo])
  @@index([parentUserId, validFrom, validTo])
  @@index([parentPartnerId, validFrom, validTo])
  @@index([teamId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

// Generic maker-checker ledger. actionType/entity are free-form Strings, following this
// codebase's existing convention for open-ended classifiers (AuditLog.action, Notification.type,
// Task.source) — new action types register in src/lib/policy/approvals/registry.ts, no migration.
model ApprovalRequest {
  id             String         @id @default(cuid())
  actionType     String // registry key, e.g. "STAGE_OVERRIDE" | "COMMISSION_ADJUSTMENT"
  entity         String // "Client" | "PartnerProfile" | "CommissionRule" | "Payout" | ...
  entityId       String
  status         ApprovalStatus @default(PENDING)
  payload        Json // proposed change; shape defined per actionType by the registry
  reason         String?
  requestedById  String
  requestedBy    User           @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestedAt    DateTime       @default(now())
  decidedById    String?
  decidedBy      User?          @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  expiresAt      DateTime?
  appliedAt      DateTime? // set once the underlying action actually executes, post-approval
  idempotencyKey String?        @unique // guards double-apply, same precedent as DailyJobRun's @@unique
  /// Canonical approval fields (additive, all optional): the chain this approval belongs to, what caused it, and the autonomy level it ran at.
  correlationId  String?
  causationId    String?
  autonomyLevel  String?

  @@index([status, actionType])
  @@index([entity, entityId])
  @@index([requestedById])
  @@index([correlationId])
}

// Append-only record of every time a masked/sensitive field (PAN, mobile, email, bank details)
// was viewed UNMASKED by a user. Distinct from AuditLog (which records changes to records) — this
// records reads of sensitive data, the other half of a real privacy audit trail.
model DataAccessLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("DataAccessLogUser", fields: [userId], references: [id])
  entity     String // "Client" | "PartnerProfile" | ...
  entityId   String
  fieldName  String // "pan" | "mobile" | "bankAccountLast4" | ...
  accessedAt DateTime @default(now())
  reason     String?

  @@index([entity, entityId])
  @@index([userId, accessedAt])
}

// ---------------------------------------------------------------------------
// Distribution OS — Client & Product 360 (Workstream 2)
//
// Household groups multiple existing Clients (family members); TradingAccount is the brokerage/
// demat account under a Client (named TradingAccount, not "Account", to avoid colliding with the
// existing AccountHolder model, which means a joint co-holder of a Client's KYC record — an
// unrelated concept). Product/Position/Transaction are new, wholly independent of the existing
// onboarding-pipeline models. ProductEntitlement and AdvisoryInteraction fill out the full
// "Client & Product 360" domain from the original spec (segment/product entitlement gating, and a
// SEBI-style compliance record of advice given) — both omitted from the first Workstream 2 design
// pass and added here.
//
// Position/Transaction are meant to sync from an external trading/back-office system via a
// generic batch-file adapter (vendor not yet chosen) — sourceSystem/externalRef on each row is
// the idempotent-upsert key for that future sync, mirroring Document.externalProvider/externalId
// (ClickUp/Jira) and DailyJobRun's precedent. Until that adapter exists, the same fields are
// populated by the CSV-based ingestion built alongside this schema (src/app/(dashboard)/households
// bulk-import, mirroring the existing Clients CSV Bulk Import pattern).
// ---------------------------------------------------------------------------

model Household {
  id            String   @id @default(cuid())
  householdCode String   @unique // "HH-00001"
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members HouseholdMember[]
  relationshipConsents HouseholdRelationshipConsent[]
}

// Many-to-many join: a Household groups multiple existing Clients (family members).
model HouseholdMember {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  relationship String? // "Self" | "Spouse" | "Child" | "Parent" | ...
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@unique([householdId, clientId])
  @@index([clientId])
}

enum TradingAccountType {
  EQUITY
  COMMODITY
  CURRENCY
  MUTUAL_FUND
  PMS
  INSURANCE
  NPS
  OTHER
}

enum TradingAccountStatus {
  ACTIVE
  DORMANT
  CLOSED
  SUSPENDED
}

enum Depository {
  NSDL
  CDSL
}

// The brokerage/demat account. Named TradingAccount (not "Account") specifically to avoid
// colliding with the existing AccountHolder model (a joint co-holder of a Client's KYC record).
model TradingAccount {
  id                String               @id @default(cuid())
  accountNumber     String               @unique
  clientId          String
  client            Client               @relation(fields: [clientId], references: [id])
  accountType       TradingAccountType
  status            TradingAccountStatus @default(ACTIVE)
  segments          String[]             @default([]) // mirrors DealerIntroduction.preferredSegments
  depository        Depository?
  dpId              String?
  boId              String?
  openedAt          DateTime?
  closedAt          DateTime?
  rmAtOpeningId     String?
  rmAtOpening       User?                @relation("TradingAccountRmAtOpening", fields: [rmAtOpeningId], references: [id])
  sourcingPartnerId String?
  sourcingPartner   PartnerProfile?      @relation(fields: [sourcingPartnerId], references: [id])
  // Idempotent-upsert keys for the batch-feed adapter / CSV ingestion.
  sourceSystem      String?
  externalRef       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  positions            Position[]
  transactions         Transaction[]
  entitlements         ProductEntitlement[]
  advisoryInteractions AdvisoryInteraction[]
  revenueEvents        RevenueEvent[]
  payments             ClientPayment[]

  @@unique([sourceSystem, externalRef])
  @@index([clientId])
  @@index([sourcingPartnerId])
  @@index([sourcingPartnerId, clientId])
}

enum ProductCategory {
  EQUITY
  MUTUAL_FUND
  PMS
  INSURANCE
  BOND
  FIXED_DEPOSIT
  NPS
  AIF
  OTHER
}

// Instrument/product master data, eventually synced from AMC/back-office feeds.
model Product {
  id           String          @id @default(cuid())
  productCode  String          @unique
  name         String
  category     ProductCategory
  subCategory  String?
  isin         String?         @unique
  amcName      String?
  riskCategory String?
  sourceSystem String?
  externalRef  String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  positions            Position[]
  transactions         Transaction[]
  advisoryInteractions AdvisoryInteraction[]

  @@unique([sourceSystem, externalRef])
}

// Portfolio holding snapshot — unrelated to the existing HolderPosition enum (SECOND/THIRD
// co-holder ordinal); this "Position" is a quantity/value holding of a Product in a TradingAccount
// as of a given batch-feed date.
model Position {
  id               String         @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Decimal
  avgCost          Decimal?
  currentValue     Decimal?
  asOfDate         DateTime // batch-file snapshot date; rows accumulate per date (append-only, enables AUM trend)
  sourceSystem     String
  externalRef      String // source system's unique key for this holding row
  /// Sender's monotonic version of this row (portfolio feed); a feed update applies only when strictly newer. Null for other sources.
  feedRevision     Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([sourceSystem, externalRef, asOfDate])
  @@index([tradingAccountId, asOfDate])
  @@index([productId])
}

enum TransactionType {
  BUY
  SELL
  SIP
  REDEMPTION
  DIVIDEND
  SWITCH_IN
  SWITCH_OUT
  CHARGES
  OTHER
}

// Brokerage/investment transaction fact — distinct from the existing Activity/StageHistory
// timeline models, which track onboarding-process events, not financial transactions.
model Transaction {
  id               String          @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount  @relation(fields: [tradingAccountId], references: [id])
  productId        String?
  product          Product?        @relation(fields: [productId], references: [id])
  transactionType  TransactionType
  transactionDate  DateTime
  settlementDate   DateTime?
  quantity         Decimal?
  price            Decimal?
  grossAmount      Decimal
  netAmount        Decimal?
  brokerageAmount  Decimal?
  taxes            Json?
  sourceSystem     String
  externalRef      String
  /// Sender's monotonic version of this row (portfolio feed); a feed update applies only when strictly newer. Null for other sources.
  feedRevision     Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  revenueEvents RevenueEvent[]

  @@unique([sourceSystem, externalRef])
  @@index([tradingAccountId, transactionDate])
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// Which product categories/segments a TradingAccount is entitled to transact in — the standard
// broking-industry "segment enablement" concept (e.g. F&O requires a signed risk disclosure; PMS/
// AIF requires accredited-investor status). Gates what a future order/transaction pipeline should
// accept for an account; this table only records the entitlement decision itself.
model ProductEntitlement {
  id               String            @id @default(cuid())
  tradingAccountId String
  tradingAccount   TradingAccount    @relation(fields: [tradingAccountId], references: [id])
  category         ProductCategory
  status           EntitlementStatus @default(ACTIVE)
  grantedAt        DateTime          @default(now())
  revokedAt        DateTime?
  grantedById      String
  grantedBy        User              @relation("ProductEntitlementGrantedBy", fields: [grantedById], references: [id])
  notes            String?

  @@unique([tradingAccountId, category])
  @@index([tradingAccountId, status])
}

enum AdvisoryInteractionType {
  RECOMMENDATION
  PORTFOLIO_REVIEW
  RISK_PROFILING
  COMPLAINT_DISCUSSION
  OTHER
}

// A logged record of investment advice given to a client — distinct from the existing Activity
// timeline (onboarding/process events) and Message (communication log): this is the compliance
// record of what advice was given and why, the kind of record SEBI investment-adviser regulations
// expect to be traceable.
model AdvisoryInteraction {
  id                String                  @id @default(cuid())
  clientId          String
  client            Client                  @relation(fields: [clientId], references: [id])
  tradingAccountId  String?
  tradingAccount    TradingAccount?         @relation(fields: [tradingAccountId], references: [id])
  productId         String?
  product           Product?                @relation(fields: [productId], references: [id])
  advisorId         String
  advisor           User                    @relation("AdvisoryInteractionAdvisor", fields: [advisorId], references: [id])
  type              AdvisoryInteractionType
  recommendation    String?
  rationale         String?
  clientRiskProfile String?
  interactionDate   DateTime                @default(now())
  createdAt         DateTime                @default(now())

  @@index([clientId, interactionDate])
  @@index([tradingAccountId])
}

// ---------------------------------------------------------------------------
// Distribution OS — Workstream 1 completion: security hardening (contained pieces only)
//
// Full MFA and IP-allowlist enforcement are deliberately NOT modeled here — MFA needs a real
// enrollment/verification UI of its own, and IP enforcement needs request-IP plumbing this app
// has no mechanism for today (no middleware.ts exists anywhere in the project). Both are follow-up
// work; see the plan's "Security hardening — built vs. deferred" section.
// ---------------------------------------------------------------------------

enum RetentionAction {
  ARCHIVE
  ANONYMIZE
  DELETE
}

model DataRetentionPolicy {
  id            String          @id @default(cuid())
  entity        String // "Client" | "PartnerProfile" | "Transaction" | ...
  retentionDays Int
  action        RetentionAction
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum ErasureStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

// Routes through the existing ApprovalRequest maker-checker flow — erasure is exactly the kind of
// sensitive, hard-to-reverse action that engine exists for. approvalRequestId is an app-level
// reference (mirrors AuditLog.entityId's polymorphic-reference convention), not a DB FK.
model ErasureRequest {
  id                String        @id @default(cuid())
  subjectType       String // "Client" | "PartnerProfile"
  subjectId         String
  requestedById     String
  requestedBy       User          @relation("ErasureRequestedBy", fields: [requestedById], references: [id])
  status            ErasureStatus @default(PENDING)
  approvalRequestId String?
  requestedAt       DateTime      @default(now())
  completedAt       DateTime?
  notes             String?
}

/// One row per accepted webhook delivery, keyed by source + a delivery key (the provider's event id, or a
/// SHA-256 of the raw body). A provider retry of the same delivery hits the unique key and is acknowledged
/// without being processed twice. Pruned after 7 days by the cron tick.
model WebhookDelivery {
  id         String   @id @default(cuid())
  source     String
  eventKey   String
  receivedAt DateTime @default(now())

  @@unique([source, eventKey])
  @@index([receivedAt])
}

/// Fixed-window request counters for rate limiting (src/lib/security/rate-limit.ts). key = name:identifier:window.
model RateLimitCounter {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

// Every sign-in attempt, success or failure — the audit trail backing the lockout fields on User
// and the first real answer to "who's trying to log in as me".
model LoginAttempt {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation("LoginAttemptUser", fields: [userId], references: [id])
  email       String // captured even on failed attempts where no user matches
  success     Boolean
  ipAddress   String?
  userAgent   String?
  attemptedAt DateTime @default(now())

  @@index([userId, attemptedAt])
  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
}

// Android app call-log sync. Each phone registers once (after in-app consent) and gets a revocable
// token; only the SHA-256 hash is stored. See src/lib/device/*.
model DeviceToken {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation("DeviceTokenUser", fields: [userId], references: [id])
  tokenHash       String       @unique
  label           String // "Android phone"
  appVersion      String?
  createdAt       DateTime     @default(now())
  lastSeenAt      DateTime?
  lastSyncAt      DateTime?
  lastSyncMatched Int          @default(0)
  revokedAt       DateTime?
  calls           DeviceCall[]

  @@index([userId])
}

// Dedupe ledger + link to the CALL Activity each synced call produced. Only calls whose number matches
// one of the caller's clients are ever stored — everything else is discarded at ingest.
model DeviceCall {
  id              String      @id @default(cuid())
  userId          String
  clientId        String
  client          Client      @relation(fields: [clientId], references: [id])
  deviceTokenId   String
  deviceToken     DeviceToken @relation(fields: [deviceTokenId], references: [id])
  activityId      String      @unique
  activity        Activity    @relation(fields: [activityId], references: [id])
  phoneKey        String // last 10 digits of the client's number
  direction       String // INCOMING | OUTGOING | MISSED | REJECTED | OTHER
  startedAt       DateTime
  durationSeconds Int
  createdAt       DateTime    @default(now())

  @@unique([userId, phoneKey, startedAt, direction])
  @@index([clientId, startedAt])
}

// Firebase (FCM) registration token of a phone running the Android app. A token belongs to whoever is
// signed in on that phone — registering it again under another user moves it (shared phones).
model PushToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("PushTokenUser", fields: [userId], references: [id])
  token      String    @unique
  platform   String    @default("android")
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  @@index([userId])
}

enum AssignmentMode {
  LOAD_BASED // fewest active clients among eligible RMs (the original behaviour)
  ROUND_ROBIN // rotate through eligible RMs in a fixed order
  MANUAL // no automatic assignment — leads wait unassigned and Admins/Managers are alerted
}

// Singleton (id = "default") holding how new leads are assigned. Read through getAssignmentSettings().
model AssignmentSettings {
  id                 String         @id @default("default")
  mode               AssignmentMode @default(LOAD_BASED)
  roundRobinCursorId String? // last RM handed a lead in ROUND_ROBIN mode
  updatedAt          DateTime       @updatedAt
  updatedById        String?
}

enum PaymentType {
  FUNDS_IN
  FUNDS_OUT
  FEE
  OTHER
}

// A money movement for a client (funds received, withdrawals, fees) as recorded in the back office.
// Imported idempotently by (sourceSystem, externalRef) — CSV today, a live feed adapter later.
model ClientPayment {
  id               String          @id @default(cuid())
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  tradingAccountId String?
  tradingAccount   TradingAccount? @relation(fields: [tradingAccountId], references: [id])
  paymentType      PaymentType     @default(FUNDS_IN)
  amount           Decimal
  paidAt           DateTime
  mode             String? // UPI | NEFT | RTGS | IMPS | CHEQUE ...
  referenceNumber  String?
  status           String          @default("SUCCESS") // SUCCESS | PENDING | FAILED
  sourceSystem     String
  externalRef      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([sourceSystem, externalRef])
  @@index([clientId, paidAt])
}

// Cached AI page summaries. Keyed by a hash of the exact facts sent, so unchanged data is served from
// here without another API call; also used to rate-limit generations per user.
model AiSummary {
  id          String   @id @default(cuid())
  kind        String // client | my_day | management | reports | quality_review
  subjectKey  String // clientId | userId | "<period>" | reviewId ...
  contentHash String
  summary     String   @db.Text
  model       String
  userId      String?
  user        User?    @relation("AiSummaryUser", fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([kind, subjectKey, contentHash])
  @@index([userId, createdAt])
}

enum UserEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PAGE_VIEW
  DATA_CREATE
  DATA_UPDATE
  DATA_DELETE
  EXPORT
}

// Append-only "who did what, when, from where" feed: sign-ins/outs, page views, downloads, and every
// data change made by a signed-in user (captured centrally by the Prisma client extension in
// src/lib/db/prisma.ts). `details` holds field NAMES / row counts only — never values — so this log
// can't leak PAN/mobile/password hashes; old->new values stay in AuditLog.
model UserEvent {
  id        String        @id @default(cuid())
  userId    String? // null for failed logins where the email matches no user
  user      User?         @relation("UserEventUser", fields: [userId], references: [id])
  userEmail String? // snapshot — needed for failed logins
  userRole  Role? // snapshot at event time
  type      UserEventType
  entity    String? // model name for DATA_* events, e.g. "Client"
  entityId  String?
  path      String? // PAGE_VIEW / EXPORT pathname (no query string)
  summary   String? // "Updated Client: priority, region"
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Earnings Engine (Workstream 3): internal estimation & reporting ledger only.
// Never executes a real bank transfer — Payout.status only ever reaches
// RECONCILED_EXTERNALLY once Allvest's real external finance system confirms it there.
// Full traceability: Payout -> PayoutLine -> CommissionAccrual -> RevenueEvent -> Transaction.
// ---------------------------------------------------------------------------

model CommissionPlan {
  id                   String       @id @default(cuid())
  code                 String       @unique
  name                 String
  description          String?
  appliesToPartnerType PartnerType? // null = generic/any
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  rules       CommissionRule[]
  assignments PartnerCommissionAssignment[]
}

enum CommissionRateType {
  PERCENT_OF_GROSS
  PERCENT_OF_NET
  FLAT_PER_TRANSACTION
  SLAB
}

// Effective-dated — a rule's rate can change over time without losing the historical rate that
// applied when a given RevenueEvent was accrued (CommissionAccrual always records which rule +
// computationVersion it used).
model CommissionRule {
  id               String             @id @default(cuid())
  commissionPlanId String
  commissionPlan   CommissionPlan     @relation(fields: [commissionPlanId], references: [id])
  productCategory  ProductCategory? // null = all categories
  transactionType  TransactionType? // null = all types
  rateType         CommissionRateType
  percentRate      Decimal?
  flatRate         Decimal?
  validFrom        DateTime           @default(now())
  validTo          DateTime?
  createdById      String
  createdBy        User               @relation("CommissionRuleCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  slabs    CommissionSlab[]
  accruals CommissionAccrual[]

  @@index([commissionPlanId, validFrom, validTo])
}

// Tiered/volume-based rates for rateType = SLAB. Also effective-dated.
model CommissionSlab {
  id               String         @id @default(cuid())
  commissionRuleId String
  commissionRule   CommissionRule @relation(fields: [commissionRuleId], references: [id])
  minAmount        Decimal
  maxAmount        Decimal?
  rate             Decimal
  validFrom        DateTime       @default(now())
  validTo          DateTime?

  @@index([commissionRuleId, validFrom, validTo])
}

// Effective-dated mapping of which plan a partner is on — partners can move plans over time and
// the ledger must recompute/audit correctly against whichever plan was active on a given date.
model PartnerCommissionAssignment {
  id               String         @id @default(cuid())
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  commissionPlanId String
  commissionPlan   CommissionPlan @relation(fields: [commissionPlanId], references: [id])
  validFrom        DateTime       @default(now())
  validTo          DateTime?
  assignedById     String
  assignedBy       User           @relation("PartnerCommissionAssignmentAssignedBy", fields: [assignedById], references: [id])
  createdAt        DateTime       @default(now())

  @@index([partnerProfileId, validFrom, validTo])
}

enum RevenueType {
  BROKERAGE
  TRAIL_COMMISSION
  UPFRONT_COMMISSION
  AMC_PAYOUT
  ADVISORY_FEE
  OTHER
}

// Append-only raw revenue/brokerage fact, ingested idempotently either by syncing from an
// existing Transaction.brokerageAmount (sourceSystem = "txn_sync") or by CSV import
// (sourceSystem = "csv_import") for revenue types with no natural Transaction link. Never updated
// in place — a correction is a new reversal row (reversesEventId) with a negative amount, same
// immutable-ledger discipline as the rest of this design.
model RevenueEvent {
  id                 String          @id @default(cuid())
  sourceSystem       String
  externalRef        String
  transactionId      String?
  transaction        Transaction?    @relation(fields: [transactionId], references: [id])
  tradingAccountId   String?
  tradingAccount     TradingAccount? @relation(fields: [tradingAccountId], references: [id])
  clientId           String?
  client             Client?         @relation(fields: [clientId], references: [id]) // denormalized for query/masking convenience
  revenueType        RevenueType
  grossRevenueAmount Decimal
  eventDate          DateTime
  ingestedAt         DateTime        @default(now())
  rawPayload         Json
  reversesEventId    String?         @unique
  reverses           RevenueEvent?   @relation("RevenueReversal", fields: [reversesEventId], references: [id])
  reversedBy         RevenueEvent?   @relation("RevenueReversal")

  accruals CommissionAccrual[]

  @@unique([sourceSystem, externalRef])
  @@index([tradingAccountId, eventDate])
  @@index([clientId])
}

enum AccrualStatus {
  ACCRUED
  ADJUSTED
  REVERSED
  INCLUDED_IN_PAYOUT
}

// The computed "estimation" layer: applying a CommissionRule to a RevenueEvent for a specific
// partner. computationVersion records a tag of the rule-matching logic used, for reproducibility.
model CommissionAccrual {
  id                 String          @id @default(cuid())
  revenueEventId     String
  revenueEvent       RevenueEvent    @relation(fields: [revenueEventId], references: [id])
  partnerProfileId   String
  partnerProfile     PartnerProfile  @relation(fields: [partnerProfileId], references: [id])
  commissionRuleId   String?
  commissionRule     CommissionRule? @relation(fields: [commissionRuleId], references: [id])
  accrualAmount      Decimal
  accrualDate        DateTime
  status             AccrualStatus   @default(ACCRUED)
  computationVersion String
  computedAt         DateTime        @default(now())

  // Override accruals (additive): an ancestor's share of a sub-partner's commission accrual. commissionRuleId stays null for these;
  // overrideRuleId and sourceAccrualId are app-level references (no FK, like approvalRequestId) and overrideKey, "<source accrual>:<rule>:<ancestor>",
  // makes the generator idempotent (a unique column ignores NULLs, so ordinary accruals are unaffected).
  overrideRuleId  String?
  sourceAccrualId String?
  overrideKey     String? @unique

  payoutLines PayoutLine[]

  @@unique([revenueEventId, partnerProfileId, commissionRuleId])
  @@index([partnerProfileId, accrualDate])
  @@index([sourceAccrualId])
  @@index([accrualDate])
}

enum PayoutRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  FINALIZED
  CANCELLED
}

model PayoutRun {
  id           String          @id @default(cuid())
  periodStart  DateTime
  periodEnd    DateTime
  status       PayoutRunStatus @default(DRAFT)
  createdById  String
  createdBy    User            @relation("PayoutRunCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?           @relation("PayoutRunApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  finalizedAt  DateTime?
  notes        String?
  createdAt    DateTime        @default(now())

  payouts Payout[]

  @@unique([periodStart, periodEnd])
}

enum PayoutStatus {
  ESTIMATED
  APPROVED
  RECONCILED_EXTERNALLY // reconciled against Allvest's real external finance/payroll system —
  // this model NEVER executes a transfer itself, per the "estimation & reporting" scope decision
}

model Payout {
  id                 String         @id @default(cuid())
  payoutRunId        String
  payoutRun          PayoutRun      @relation(fields: [payoutRunId], references: [id])
  partnerProfileId   String
  partnerProfile     PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  totalAccrualAmount Decimal
  adjustmentAmount   Decimal        @default(0)
  netPayableAmount   Decimal
  status             PayoutStatus   @default(ESTIMATED)
  externalPayoutRef  String? // filled in once reconciled against the external finance system
  reconciledAt       DateTime?

  lines       PayoutLine[]
  adjustments CommissionAdjustment[]

  @@unique([payoutRunId, partnerProfileId])
  @@index([partnerProfileId])
}

// The join that makes "full trace from Payout back to raw source transactions" concrete.
model PayoutLine {
  id                  String            @id @default(cuid())
  payoutId            String
  payout              Payout            @relation(fields: [payoutId], references: [id])
  commissionAccrualId String
  commissionAccrual   CommissionAccrual @relation(fields: [commissionAccrualId], references: [id])
  amount              Decimal

  @@unique([payoutId, commissionAccrualId])
  @@index([commissionAccrualId])
}

// Manual corrections (e.g. clawbacks) — always gated by an ApprovalRequest (maker-checker),
// never written directly.
model CommissionAdjustment {
  id                String         @id @default(cuid())
  partnerProfileId  String
  partnerProfile    PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  payoutId          String?
  payout            Payout?        @relation(fields: [payoutId], references: [id])
  amount            Decimal // signed: negative = clawback
  reason            String
  approvalRequestId String? // app-level reference to ApprovalRequest.id, mirroring AuditLog's convention
  createdById       String
  createdBy         User           @relation("CommissionAdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime       @default(now())

  @@index([partnerProfileId, createdAt])
  @@index([payoutId])
}

// ---------------------------------------------------------------------------
// Partner finance configuration and attribution (additive). Nothing here has a default value that
// changes any figure: no tax rule and no override rule exists until Finance configures it and a
// different person approves it (maker-checker through ApprovalRequest).
// ---------------------------------------------------------------------------

enum PartnerTaxKind {
  TDS
  GST
}

enum PartnerPanStatus {
  ANY
  PRESENT
  ABSENT
}

enum PartnerGstRegistration {
  ANY
  REGISTERED
  UNREGISTERED
}

enum PartnerGstMode {
  REVERSE_CHARGE // the firm pays the tax itself: shown on the statement, does not change the partner's net
  SELF_INVOICE // the firm raises the invoice for the partner: shown on the statement, does not change the net
  PARTNER_INVOICED // the partner charges GST on top: added to the net payable
}

/// One effective-dated tax rule. The rate, the threshold and every other value are typed by Finance; the code has no default.
/// createdById / approvedById / approvalRequestId are app-level references (no FK), like CommissionAdjustment.approvalRequestId.
model PartnerTaxRule {
  id                String                 @id @default(cuid())
  kind              PartnerTaxKind
  label             String // section or tax label as Finance wants it printed
  ratePercent       Decimal                @db.Decimal(8, 4)
  thresholdAmount   Decimal?               @db.Decimal(18, 2) // TDS only: per financial year, in rupees
  partnerTypes      PartnerType[] // empty = every type
  panStatus         PartnerPanStatus       @default(ANY)
  gstRegistration   PartnerGstRegistration @default(ANY)
  gstMode           PartnerGstMode? // GST only
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  approvalRequestId String?
  createdById       String
  approvedById      String
  createdAt         DateTime               @default(now())

  @@index([kind, effectiveFrom])
}

/// An optional override: a percentage of a sub-partner's commission accrual, paid to the ancestor `level` steps above, with a cap per accrual.
model PartnerOverrideRule {
  id                String    @id @default(cuid())
  level             Int // 1 = the direct parent, 2 = the parent's parent, ...
  ratePercent       Decimal   @db.Decimal(8, 4)
  capPerAccrual     Decimal?  @db.Decimal(18, 2) // rupees; blank = no cap
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  approvalRequestId String?
  createdById       String
  approvedById      String
  createdAt         DateTime  @default(now())

  @@index([level, effectiveFrom])
}

/// Small key/value settings for the Partner workspace: statement letterhead and registration text, the public form link, the
/// attribution lapse window, who receives statement queries. Kept in the database so nothing identifying lives in the repository.
model PartnerWorkspaceSetting {
  key         String   @id
  value       Json
  updatedById String
  updatedAt   DateTime @updatedAt
}

/// First-touch referral attribution of a person to a partner: at most one row per person, replaced only after it lapsed.
model PartnerReferralTouch {
  id               String         @id @default(cuid())
  clientId         String         @unique
  client           Client         @relation(fields: [clientId], references: [id])
  partnerProfileId String
  partnerProfile   PartnerProfile @relation(fields: [partnerProfileId], references: [id])
  code             String
  source           String // "web" | "app"
  touchedAt        DateTime
  expiresAt        DateTime

  @@index([partnerProfileId, expiresAt])
  @@index([expiresAt])
}

/// Append-only trail of every referral-code decision (recorded, kept the first touch, replaced a lapsed one, ignored). clientId is a plain
/// string so the trail never blocks an erasure; the erasure transaction deletes a person's rows.
model PartnerAttributionEvent {
  id               String   @id @default(cuid())
  clientId         String?
  partnerProfileId String?
  code             String?
  decision         String
  source           String
  createdAt        DateTime @default(now())

  @@index([clientId])
  @@index([createdAt])
}

/// A partner's "Raise a query" on a statement line. The query lands on Finance as an ordinary Task (taskId).
model PartnerStatementQuery {
  id               String   @id @default(cuid())
  partnerProfileId String
  periodKey        String
  lineRef          String // accrual id, or "adjustment:<id>"
  message          String
  taskId           String?
  raisedById       String
  createdAt        DateTime @default(now())

  @@index([partnerProfileId, createdAt])
  @@index([raisedById, lineRef])
}

// ---------------------------------------------------------------------------
// Debugger: any signed-in user can report an issue they hit; Admins are
// notified immediately via the existing Notification bell and triage it here.
// ---------------------------------------------------------------------------

enum BugReportStatus {
  OPEN
  RESOLVED
}

model BugReport {
  id              String          @id @default(cuid())
  reportedById    String
  reportedBy      User            @relation("BugReportReportedBy", fields: [reportedById], references: [id])
  pageUrl         String // window.location.pathname at the moment of reporting
  description     String
  attachmentUrl   String? // Vercel Blob public URL, e.g. a screenshot — optional
  attachmentName  String? // original filename, shown as the link text
  status          BugReportStatus @default(OPEN)
  resolvedById    String?
  resolvedBy      User?           @relation("BugReportResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime        @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Opportunity Management (Module 2 of the RM/Wealth CRM spec, Part O) — a post-onboarding
// layer: applies once a client is Active/Completed in the existing 5-stage onboarding pipeline,
// which this never touches. Client.currentStageId is a single scalar (one stage per client) and
// Stage.name/sequence are globally unique, so that engine isn't reusable for "many concurrent
// records per client across products" — this is a new model family instead, mirroring
// StageHistory's audit shape.
// ---------------------------------------------------------------------------

enum OpportunityProduct {
  MUTUAL_FUND
  BROKING
  PMS
  AIF
  BONDS
  FIXED_INCOME
  UNLISTED_PRE_IPO
  OTHER
}

enum OpportunityStage {
  IDENTIFIED
  DISCUSSED
  INTERESTED
  RECOMMENDATION
  DECISION_PENDING
  COMMITTED
  FUNDED
  INVESTED
  LOST_DEFERRED
}

model Opportunity {
  id             String             @id @default(cuid())
  clientId       String
  client         Client             @relation(fields: [clientId], references: [id])
  product        OpportunityProduct
  estimatedValue Decimal
  estimatedAum   Decimal? // forward-looking AUM this opportunity is expected to bring under management —
  // distinct from estimatedValue (that one product's revenue/transaction size)
  stage          OpportunityStage   @default(IDENTIFIED)
  stageEnteredAt DateTime           @default(now())
  lostReason     String? // populated only when stage = LOST_DEFERRED
  ownerId        String
  owner          User               @relation("OpportunityOwner", fields: [ownerId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  history OpportunityStageHistory[]

  @@index([clientId, stage])
  @@index([ownerId, stage])
}

// Mirrors StageHistory's shape exactly — one row per transition, for pipeline-value
// re-evaluation and stage-ageing/conversion reporting identical in spirit to the onboarding
// funnel's, computed on read (pure aggregation over these rows, no cached total to keep in sync).
model OpportunityStageHistory {
  id            String            @id @default(cuid())
  opportunityId String
  opportunity   Opportunity       @relation(fields: [opportunityId], references: [id])
  fromStage     OpportunityStage?
  toStage       OpportunityStage
  changedById   String
  changedBy     User              @relation("OpportunityStageHistoryChangedBy", fields: [changedById], references: [id])
  changedAt     DateTime          @default(now())
  reason        String?

  @@index([opportunityId, changedAt])
}

// ---------------------------------------------------------------------------
// Wealth Workspace (Module 3 of the RM/Wealth CRM spec, Part O) — another post-onboarding
// layer, independent of Opportunity Management. Section (1) "Existing Portfolio" is a pure
// read/compute over the existing Position/Product/TradingAccount tables (no new schema needed —
// see src/lib/wealth/portfolio-analytics.ts); these two models cover the 0-to-1 pieces the spec
// calls for (a health-checkup workflow and a structured risk-profiling record), each 1:1 with
// Client, string-typed status fields matching this codebase's existing free-form-classifier
// convention (AuditLog.action, Notification.type) rather than a narrow enum that would need a
// migration every time a workflow status is added.
// ---------------------------------------------------------------------------

model WealthHealthCheckup {
  id            String    @id @default(cuid())
  clientId      String    @unique
  client        Client    @relation(fields: [clientId], references: [id])
  status        String    @default("NOT_STARTED") // "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"
  completedAt   DateTime?
  reportUrl     String?
  keyFindings   String?
  performedById String?
  performedBy   User?     @relation("WealthHealthCheckupPerformedBy", fields: [performedById], references: [id])
  updatedAt     DateTime  @updatedAt
}

model SmartAllvestProfile {
  id                     String   @id @default(cuid())
  clientId               String   @unique
  client                 Client   @relation(fields: [clientId], references: [id])
  status                 String   @default("NOT_STARTED") // "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"
  investorRiskProfile    String? // "Conservative" | "Moderate" | "Aggressive"
  goals                  Json? // structured list of {goal, targetAmount, targetDate}
  investmentHorizonYears Int?
  liquidityRequirement   String?
  updatedAt              DateTime @updatedAt
}

// One row per (client, product) — manually-tracked, fixed-list holdings distinct from the
// CSV-fed Position/Product/TradingAccount catalog, which would be overkill for 4 named schemes.
model PmsAifHolding {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  productName  String // "PMS (Allvest)" | "PMS (Walfort)" | "AIF II" | "AIF III" — fixed list, free-text column
  status       String    @default("NOT_INVESTED") // "NOT_INVESTED" | "INVESTED" | "REDEEMED"
  amount       Decimal?
  investedDate DateTime?
  remarks      String?
  updatedAt    DateTime  @updatedAt

  @@unique([clientId, productName])
}

// ---------------------------------------------------------------------------
// Lead intake (ads, website and forms) and go-live readiness
// ---------------------------------------------------------------------------

enum LeadIntakeStatus {
  CREATED
  DUPLICATE
  REJECTED
  ERROR
}

/// Ledger of every lead submission from Meta/Instagram/Google/website forms. (source, externalId) makes a replay or
/// a provider retry idempotent, and rawPayload + status let a failed lead be inspected and retried.
model LeadIntake {
  id          String           @id @default(cuid())
  source      String
  externalId  String
  status      LeadIntakeStatus
  clientId    String?
  rawPayload  Json
  error       String?
  attempts    Int              @default(1)
  receivedAt  DateTime         @default(now())
  processedAt DateTime?

  @@unique([source, externalId])
  @@index([status, receivedAt])
  @@index([source, receivedAt])
  @@index([clientId, source])
}

/// Last time a background loop proved it is alive (key "cron_tick"). Read by /api/health and the Go-Live page.
model SystemHeartbeat {
  key    String   @id
  lastAt DateTime
}

/// Manual go-live checklist ticks (automatic items are computed live and never stored).
model GoLiveCheck {
  itemId    String    @id
  done      Boolean   @default(false)
  note      String?
  doneById  String?
  doneAt    DateTime?
  updatedAt DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Customer Intelligence: lifecycle, asset-class acceptance, conversation insights, Next Best Action,
// interaction outcomes and segments (see src/lib/intelligence/*)
// ---------------------------------------------------------------------------

enum AcceptanceLevel {
  HIGH
  MEDIUM
  LOW
}

enum InsightKind {
  INTEREST
  OBJECTION
  QUESTION
  CONCERN
  COMMITMENT
  COMPLAINT
  PRODUCT_DISCUSSED
  DECLINED
  EXTERNAL_HOLDING
  INCORRECT_INFO
  COMPLIANCE_CONCERN
  MISSED_OPPORTUNITY
}

enum InsightStatus {
  OPEN
  DONE
  DISMISSED
}

enum InteractionOutcomeType {
  INTERESTED
  NOT_INTERESTED
  FOLLOW_UP
  CONVERTED
  NOT_RELEVANT
  RM_HANDOVER
  SERVICE_ISSUE
}

/// One live row per client: lifecycle stage, estimates of what the client holds elsewhere, and the cached
/// Next Best Action + situations so lists and management questions don't recompute every client.
model CustomerIntelligence {
  clientId                  String    @id
  client                    Client    @relation(fields: [clientId], references: [id])
  lifecycleStage            String
  lifecycleUpdatedAt        DateTime  @default(now())
  dematTransferStatus       String? // NOT_STARTED | IN_PROGRESS | COMPLETED
  mfTransferStatus          String?
  externalPortfolioEstimate Decimal? // held outside Allvest — an estimate from a conversation, the RM, or an import
  mfTransferEstimate        Decimal? // mutual-fund holdings that could be transferred in
  idleCashEstimate          Decimal?
  estimatesSource           String? // "rm" | "ai" | "import"
  estimatesUpdatedAt        DateTime?
  nbaProgramme              String
  nbaAction                 String // Call | WhatsApp | Review | Follow-up | No Action
  nbaTopic                  String?
  nbaReason                 String
  nbaPriority               String // High | Medium | Low
  nbaOwner                  String // RM | CRM | AI Bot | Support
  nbaTiming                 String // Today | This Week | Later | Trigger-based
  priorityScore             Int       @default(0)
  talkingPoints             Json
  situations                Json
  doNotDiscuss              Json
  computedAt                DateTime  @default(now())
  /// Watermark: notes/tickets created before this have already been read for insights.
  lastInsightAt             DateTime?
  nudgerConsideredAt        DateTime? // rotation marker for the nudger cron: when it last considered this customer; null = never

  @@index([nbaPriority, priorityScore])
  @@index([lifecycleStage])
  @@index([computedAt])
}

/// High / Medium / Low per asset class (Mutual Funds, PMS, AIF, Bonds, Broking, Global Investments, Tax Planning).
model AssetClassAcceptance {
  id         String          @id @default(cuid())
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id])
  assetClass String
  level      AcceptanceLevel
  source     String // rule | insight | outcome | manual
  reason     String
  /// An RM's own call: kept until they change it (automatic updates never overwrite it).
  isManual   Boolean         @default(false)
  updatedAt  DateTime        @updatedAt

  @@unique([clientId, assetClass])
  @@index([assetClass, level])
}

/// Something a customer said, or something in a conversation worth acting on, extracted by Claude from calls,
/// WhatsApp threads, RM notes and support tickets.
model ConversationInsight {
  id           String        @id @default(cuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  kind         InsightKind
  assetClass   String?
  text         String
  status       InsightStatus @default(OPEN)
  /// COMMITMENT: when it was promised for. Others: unused.
  dueAt        DateTime?
  /// COMPLIANCE_CONCERN / INCORRECT_INFO / COMPLAINT: low | medium | high.
  severity     String?
  sourceType   String // CALL | WHATSAPP_THREAD | NOTE | TICKET
  sourceRef    String // ConversationReview id or Activity id
  dedupeKey    String        @unique
  occurredAt   DateTime
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([clientId, kind, status])
  @@index([kind, status, occurredAt])
  @@index([assetClass, kind])
}

/// A structured result after any RM / CRM / AI-agent interaction — the feedback that keeps acceptance and the
/// next action honest. RM_HANDOVER carries the AI's summary for the RM.
model InteractionOutcome {
  id         String                 @id @default(cuid())
  clientId   String
  client     Client                 @relation(fields: [clientId], references: [id])
  outcome    InteractionOutcomeType
  channel    String // CALL | WHATSAPP | MEETING | EMAIL | AI_BOT | OTHER
  actorType  String // RM | CRM | AI_AGENT
  actorId    String?
  assetClass String?
  programme  String?
  note       String?
  summary    String?
  followUpAt DateTime?
  createdAt  DateTime               @default(now())

  @@index([clientId, createdAt])
  @@index([outcome, createdAt])
  @@index([createdAt])
}

/// Which saved customer segment a client is currently in (KYC drop-off, unfunded, dormant…). Entering a segment
/// is what triggers a journey's "customer enters segment" trigger.
model SegmentMembership {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  segment   String
  enteredAt DateTime  @default(now())
  exitedAt  DateTime?

  @@unique([clientId, segment])
  @@index([segment, exitedAt])
}

enum AgentProposalStatus {
  DRAFT
  APPROVED
  SENT
  REJECTED
  EXPIRED
  BLOCKED
}

model AgentProposal {
  id            String              @id @default(cuid())
  agentKey      String
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id])
  programme     String?
  channel       String              @default("whatsapp")
  body          String
  originalBody  String
  reason        String
  status        AgentProposalStatus @default(DRAFT)
  blockedReason String?
  provider     String
  model        String
  inputTokens  Int                 @default(0)
  outputTokens Int                 @default(0)
  decidedById  String?
  decidedBy    User?               @relation("AgentProposalDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  messageId    String?
  createdAt    DateTime            @default(now())
  expiresAt    DateTime
  /// The decision this draft executes (Decision Engine v2). Nullable: drafts made before the engine existed, or while it is off, have none.
  nbaDecisionId String?
  nbaDecision   DecisionRecord?     @relation(fields: [nbaDecisionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([clientId, createdAt])
  @@index([decidedAt])
  @@index([nbaDecisionId])
}

/// Weekly marketing read (marketing_analyst agent): text recommendations built from campaign aggregates only. No client id, no action:
/// a person reads it on the Marketing page. It is not an AgentProposal because that row needs a client.
model MarketingAnalysis {
  id           String   @id @default(cuid())
  rangeFrom    String
  rangeTo      String
  currency     String?
  /// "model" (the gateway wrote it) or "deterministic" (rules over the same aggregates).
  source       String
  provider     String?
  model        String?
  body         String
  /// Why the deterministic text was used, when a model was not (no key, abstained, failed, or its text was refused).
  note         String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model AgentSetting {
  agentKey    String   @id
  enabled     Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum AgentRunStatus {
  OK
  ABSTAINED
  FAILED
  BLOCKED
}

/// One row per model call made through the AI gateway (src/lib/ai/gateway). Ids, classes and counts only: never a prompt, an output or customer text.
/// Detail rows are deleted after `retainUntil` (AI_RUN_RETENTION_DAYS, default 90) by the retention job, which first folds them into AgentRunRollup.
model AgentRun {
  id               String         @id @default(cuid())
  createdAt        DateTime       @default(now())
  agentKey         String?
  purposeId        String
  provider         String
  model            String
  promptId         String
  promptVersion    String
  promptHash       String?
  /// Data class sent to the model: none | aggregate | customer_facts | customer_text | customer_identifiers.
  inputClass       String
  /// Counts per redaction kind, e.g. {"email":1,"pan":2}. Never the redacted text.
  redactionSummary Json?
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  /// An ESTIMATE from the price table in src/lib/ai/gateway/pricing.ts, not an invoice.
  costUsdEstimate  Decimal        @default(0) @db.Decimal(12, 6)
  latencyMs        Int            @default(0)
  attempts         Int            @default(1)
  status           AgentRunStatus
  /// Abstain reason code or block reason, when the status is ABSTAINED or BLOCKED.
  reasonCode       String?
  errorClass       String?
  evalOutcome      String?
  approvalRef      String?
  correlationId    String
  causationId      String?
  /// An internal reference only (for example "client" + the client id): never a name, phone, email or PAN.
  subjectType      String?
  subjectId        String?
  retainUntil      DateTime

  @@index([createdAt])
  @@index([purposeId, createdAt])
  @@index([agentKey, createdAt])
  @@index([correlationId])
  @@index([retainUntil])
  @@index([subjectType, subjectId, createdAt])
}

/// Daily aggregates kept after the detail rows expire. agentKey is "" when a purpose has no agent.
model AgentRunRollup {
  day             DateTime       @db.Date
  agentKey        String         @default("")
  purposeId       String
  status          AgentRunStatus
  runs            Int            @default(0)
  inputTokens     BigInt         @default(0)
  outputTokens    BigInt         @default(0)
  costUsdEstimate Decimal        @default(0) @db.Decimal(14, 6)
  latencyMsTotal  BigInt         @default(0)

  @@id([day, agentKey, purposeId, status])
}

/// The autonomy ladder level per (agent, action type), L0 to L5. No row means the registry default. Ceilings are enforced in code (src/lib/agents/autonomy.ts); raising a level is an audited Admin action.
model AgentAutonomy {
  agentKey    String
  actionType  String
  level       Int
  reason      String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([agentKey, actionType])
}

/// AI reply-assist pilot: the people allowed to use the draft-only reply assistant. An empty table means nobody (src/lib/agents/pilot.ts).
model AiPilotUser {
  userId    String   @id
  addedById String
  addedAt   DateTime @default(now())
}

/// Compliance sign-off of the pilot wording: who, when and the exact wording. Rows are never edited; revoking sets revokedAt.
model AiPilotSignoff {
  id               String    @id @default(cuid())
  statementVersion String
  statement        String
  acknowledgedById String
  acknowledgedAt   DateTime  @default(now())
  revokedAt        DateTime?
  revokedById      String?

  @@index([acknowledgedAt])
}

/// Suggest-only duplicate-customer pair (see src/lib/identity). Never causes a merge by itself.
model MergeSuggestion {
  id        String    @id @default(cuid())
  clientAId String
  clientA   Client    @relation("MergeA", fields: [clientAId], references: [id])
  clientBId String
  clientB   Client    @relation("MergeB", fields: [clientBId], references: [id])
  score     Float
  reasons   String[]
  status    String    @default("OPEN") // OPEN | MERGED | DISMISSED
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@unique([clientAId, clientBId])
  @@index([status, score])
}

model CleverTapSync {
  id            String    @id @default(cuid())
  clientId      String    @unique
  client        Client    @relation(fields: [clientId], references: [id])
  lastHash      String
  lastPushedAt  DateTime  @default(now())
  lastError     String?
  lastCheckedAt DateTime?
}

/// Consent and do-not-contact ledger. Append-only: a withdrawal is a new row, and the current state is the latest
/// row per (clientId, purpose, channel). purpose, status and source are enum-like text (see src/lib/consent/policy.ts).
/// capturedById is a plain id (no FK) so removing a user never touches the evidence.
model ConsentRecord {
  id             String    @id @default(cuid())
  clientId       String
  client         Client    @relation(fields: [clientId], references: [id])
  purpose        String
  channel        String?
  status         String
  source         String
  noticeVersion  String?
  noticeTextHash String?
  capturedAt     DateTime  @default(now())
  capturedById   String?
  evidenceRef    String?
  reason         String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([clientId, purpose, channel, capturedAt(sort: Desc)])
  @@index([purpose, status, capturedAt])
}

// ---------------------------------------------------------------------------
// Marketing: ad-platform reporting (read-only). One row per campaign per account-local calendar day, upserted by the
// sync job (src/lib/marketing/sync-meta.ts). Deliberately no foreign key to Client: this holds platform-reported
// numbers only, never personal data, so the data-privacy erasure transaction needs no change.
// ---------------------------------------------------------------------------
model AdCampaignDaily {
  id              String   @id @default(cuid())
  provider        String // "meta"
  accountId       String // ad account id, without the "act_" prefix
  campaignId      String
  campaignName    String
  /// Calendar day in the ad account's own timezone (the platform reports days that way).
  date            DateTime @db.Date
  /// Spend in minor units of `currency` (paise, cents ...).
  spendMinor      BigInt
  currency        String // ISO 4217, as reported by the account
  impressions     Int
  clicks          Int
  reach           Int
  /// Leads as reported by the platform (can lag the CRM; re-synced over a trailing window).
  leads           Int
  accountTimezone String?
  syncedAt        DateTime

  @@unique([provider, accountId, campaignId, date])
  @@index([provider, accountId, date])
  @@index([date])
}

// One row per sync attempt. status: SUCCESS | PARTIAL | FAILED | RATE_LIMITED.
model AdSyncRun {
  id            String    @id @default(cuid())
  provider      String
  accountId     String?
  windowStart   DateTime? @db.Date
  windowEnd     DateTime? @db.Date
  status        String
  error         String? // short, sanitised message only (never a response body or token)
  rowsUpserted  Int       @default(0)
  campaignsSeen Int       @default(0)
  windowsOk     Int       @default(0)
  windowsFailed Int       @default(0)
  startedAt     DateTime
  finishedAt    DateTime?

  @@index([provider, startedAt])
}

/// Back-office file import (BACKOFFICE_IMPORT_ENABLED). Singleton (id = "default"): the column-mapping config an Admin edits in Settings.
model BackOfficeImportConfig {
  id          String   @id @default("default")
  mapping     Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// One row per import attempt (dry run or real). `seq` is the monotonic revision stamped on rows that carry no revision column.
/// Holds counts and per-row error codes only: never file contents, identifiers or values.
model BackOfficeImportRun {
  id         String    @id @default(cuid())
  seq        Int       @unique @default(autoincrement())
  kind       String // CLIENTS | HOLDINGS | TRANSACTIONS
  fileName   String
  checksum   String // sha256 of the file bytes
  dryRun     Boolean   @default(false)
  trigger    String // CRON | UPLOAD
  status     String // RUNNING | SUCCESS | PARTIAL | FAILED | SKIPPED_DUPLICATE
  counts     Json?
  errors     Json?
  userId     String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([checksum, kind, status])
  @@index([startedAt])
}

/// One ad (creative) on one day, from a platform that can report per ad. Holds no personal data and has no link to a customer.
model AdCreativeDaily {
  id           String   @id @default(cuid())
  provider     String // "google"
  accountId    String
  campaignId   String
  campaignName String
  adId         String
  adName       String
  /// Platform ad format, free text (e.g. RESPONSIVE_SEARCH_AD).
  format       String   @default("")
  /// Calendar day in the ad account's own timezone.
  date         DateTime @db.Date
  spendMinor   BigInt
  currency     String
  impressions  Int
  clicks       Int
  /// The platform's own lead or conversion count; the CRM can only attribute leads to a campaign, not to an ad.
  leads        Int
  syncedAt     DateTime

  @@unique([provider, accountId, adId, date])
  @@index([provider, accountId, date])
  @@index([date])
}

/// A social post draft. Nothing is ever published from here: the workflow ends at SCHEDULED, which records intent only.
/// No foreign key to Client (no customer data), so the data-privacy erasure transaction is unaffected.
model SocialPost {
  id               String            @id @default(cuid())
  /// linkedin | instagram | facebook | x | youtube
  channel          String
  title            String?
  body             String
  /// DRAFT | NEEDS_REVIEW | APPROVED | SCHEDULED
  status           String            @default("DRAFT")
  /// STAFF | AI
  source           String            @default("STAFF")
  scheduledFor     DateTime?
  createdById      String
  approvedById     String?
  approvedAt       DateTime?
  /// Reviewer's note when changes were requested.
  reviewNote       String?
  /// The last compliance scan: [{ code, message }].
  complianceIssues Json?
  /// For AI drafts: the (minimised) brief the draft was made from.
  brief            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  events           SocialPostEvent[]

  @@index([status, scheduledFor])
  @@index([createdAt])
}

/// Append-only trail of what happened to a post and who did it.
model SocialPostEvent {
  id         String     @id @default(cuid())
  postId     String
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String?
  note       String?
  createdAt  DateTime   @default(now())
  post       SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ---------------------------------------------------------------------------
// Customer outcomes and goals. Goals are kept by the customer's relationship manager; progress is worked out in code
// (src/lib/outcomes) from the portfolio feed's holdings, so nothing here stores a value or a projection. Linked
// accounts and holdings are plain references (ids) that the loader checks against the customer's own accounts.
// Every table has a RESTRICT foreign key to Client, so the erasure transaction deletes each of them.
// ---------------------------------------------------------------------------
enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
  ARCHIVED
}

model CustomerGoal {
  id                   String     @id @default(cuid())
  clientId             String
  client               Client     @relation(fields: [clientId], references: [id])
  name                 String
  targetAmount         Decimal
  targetDate           DateTime
  priority             Priority   @default(MEDIUM)
  status               GoalStatus @default(ACTIVE)
  /// Assumed growth rate per year, in percent, chosen for this goal. Null means the configured default. An assumption, never a forecast.
  assumedAnnualRatePct Decimal?
  /// What the customer says they put towards the goal each month. Null when nothing is stated.
  plannedMonthly       Decimal?
  notes                String?
  /// Whole trading accounts whose holdings count towards the goal (read-only references).
  linkedAccountIds     String[]   @default([])
  /// Single holdings as "tradingAccountId:productId" (read-only references).
  linkedHoldingKeys    String[]   @default([])
  createdById          String?
  updatedById          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([clientId, status])
  @@index([targetDate])
}

/// A review the relationship manager marked as done. The latest one restarts the review cadence.
model CustomerReview {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  reviewedAt   DateTime @default(now())
  reviewedById String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([clientId, reviewedAt(sort: Desc)])
}

/// A suggestion an RM dismissed: hides one rule in one situation (its fingerprint) until `snoozeUntil`.
model SuggestionDismissal {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  ruleKey       String
  fingerprint   String
  reason        String?
  dismissedById String?
  dismissedAt   DateTime @default(now())
  snoozeUntil   DateTime

  @@index([clientId, ruleKey])
  @@index([snoozeUntil])
}

/// Outcome events, recorded for internal reporting only. Names and ids, never amounts, names or text. Never sent to any vendor.
model OutcomeEvent {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  goalId    String?
  actorId   String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([name, createdAt])
}

// ---------------------------------------------------------------------------
// Referral programme (flag REFERRAL_PROGRAM_ENABLED). A referrer is an existing Client. Money is never moved by the CRM:
// the ledger and statements only record what is owed and, at the end, that finance paid it elsewhere (bank reference).
// Ledger and statement rows carry plain ids (no foreign keys) on purpose: they hold no personal data and survive the
// erasure of a person as anonymous financial records.
// ---------------------------------------------------------------------------

model Referrer {
  id          String         @id @default(cuid())
  clientId    String         @unique
  client      Client         @relation(fields: [clientId], references: [id])
  /// ACTIVE | SUSPENDED
  status      String         @default("ACTIVE")
  createdById String
  createdAt   DateTime       @default(now())
  codes       ReferralCode[]
  referrals   Referral[]
}

model ReferralCode {
  id           String    @id @default(cuid())
  referrerId   String
  referrer     Referrer  @relation(fields: [referrerId], references: [id])
  /// 8 characters, no look-alikes (src/lib/referrals/code.ts)
  code         String    @unique
  /// ACTIVE | REVOKED
  status       String    @default("ACTIVE")
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?

  @@index([referrerId])
}

/// One row per signup that carried a code. (idempotencyKey) makes a replayed signup a no-op; a person can be attributed once (first touch wins).
model Referral {
  id               String          @id @default(cuid())
  idempotencyKey   String          @unique
  referrerId       String?
  referrer         Referrer?       @relation(fields: [referrerId], references: [id])
  codeId           String?
  referredClientId String?         @unique
  referredClient   Client?         @relation(fields: [referredClientId], references: [id])
  /// ATTRIBUTED | REJECTED
  outcome          String
  /// For REJECTED: UNKNOWN_CODE, SELF_REFERRAL, ALREADY_CUSTOMER, ...
  reason           String?
  attributedAt     DateTime        @default(now())
  /// Review flags decided when the signup was credited (for example a partner code arrived with it). They carry onto every reward accrued from this referral.
  flags            String[]        @default([])
  /// Hash of the signup device (never the raw identifier); null when the app sent none.
  deviceHash       String?
  events           ReferralEvent[]

  @@index([referrerId, attributedAt])
  @@index([deviceHash])
}

/// SIGNED_UP | KYC_COMPLETE | FIRST_FUNDING, derived from existing KYC and funding data; never edited.
model ReferralEvent {
  id          String   @id @default(cuid())
  referralId  String
  referral    Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  type        String
  occurredAt  DateTime
  amountPaise Int?
  createdAt   DateTime @default(now())

  @@unique([referralId, type])
}

model RewardRule {
  id                       String    @id @default(cuid())
  name                     String
  /// SIGNED_UP | KYC_COMPLETE | FIRST_FUNDING
  event                    String
  /// FIXED | PERCENT
  kind                     String
  fixedPaise               Int?
  percentBps               Int?
  maxRewardPaise           Int?
  capPerReferrerMonthPaise Int?
  validFrom                DateTime?
  validTo                  DateTime?
  /// Clawback window in days after the qualifying event; null means rewards under this rule are never clawed back.
  clawbackDays             Int?
  active                   Boolean   @default(false)
  createdById              String
  updatedById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

/// Append-only (a database trigger refuses UPDATE). kind: ACCRUED | REVIEW_CLEARED | REVERSED | APPROVED | PAID_MARKED.
model RewardLedgerEntry {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  kind           String
  referrerId     String
  referralId     String?
  eventType      String?
  ruleId         String?
  /// The accrual this entry acts on (for every kind except ACCRUED).
  refEntryId     String?
  statementId    String?
  amountPaise    Int
  /// India-time month of the event ("2027-01"); the monthly cap and statements group by it.
  periodMonth    String
  flags          String[]  @default([])
  note           String?
  actorId        String?
  /// For an accrual: the end of its clawback window, fixed when it accrued (a later rule edit never moves it).
  clawbackUntil  DateTime?
  createdAt      DateTime  @default(now())

  @@index([referrerId, periodMonth])
  @@index([refEntryId])
}

/// One statement per referrer per month. PREPARED > APPROVED (a different person) > PAID (a marker with a bank reference).
model RewardStatement {
  id             String    @id @default(cuid())
  referrerId     String
  period         String
  status         String    @default("PREPARED")
  totalPaise     Int
  /// [{ entryId, amountPaise, event, periodMonth }]
  lines          Json
  preparedById   String
  preparedAt     DateTime  @default(now())
  approvedById   String?
  approvedAt     DateTime?
  paidMarkedById String?
  paidMarkedAt   DateTime?
  bankReference  String?

  @@unique([referrerId, period])
  @@index([status])
}

/// Admin-editable text and numbers for the programme (key "disclaimer", "velocity_limit").
model ReferralSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// A hashed device identifier seen on a customer's app signup (never the raw value). Used only to raise Needs-review flags: the same device on a referrer and their referral, or across different referrers. Removed with the customer.
model ReferralDevice {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  deviceHash String
  seenAt     DateTime @default(now())

  @@unique([clientId, deviceHash])
  @@index([deviceHash])
}

/// Closed-loop conversions: one row per customer event per ad destination, waiting to be sent or already sent. It holds hashed identifiers and event facts only (never a name, PAN, raw phone or raw email) and is deleted with the customer.
model ConversionOutbox {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  destination   String // "meta_capi" | "google_ads" | "fake"
  eventType     String // KYC_COMPLETE | FIRST_FUNDING | AUM_BAND
  qualifier     String    @default("") // the band label for AUM_BAND
  dedupId       String
  occurredAt    DateTime
  status        String    @default("PENDING") // PENDING | SENDING | FAILED | SENT | DEAD | SKIPPED
  reason        String? // why it was skipped, or the last failure code
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  claimedAt     DateTime?
  sentAt        DateTime?
  lastError     String? // a short code or message, never a request or response body
  matched       Boolean? // set only when the platform reports whether it matched the event
  identity      Json // hashed identifiers prepared for this destination's platform
  value         Int? // rounded rupees, only when the destination is set to send values
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([destination, dedupId])
  @@index([status, nextAttemptAt])
  @@index([clientId])
  @@index([eventType, status])
}

// ---------------------------------------------------------------------------------------------------------------------
// Creative intelligence, compliant ad copy drafts, experiments and director reports (flags NEXT_PUBLIC_CREATIVE_INTEL and
// DIRECTOR_REPORTS_ENABLED, both off by default). None of these tables references a Client: they hold staff-written copy and
// aggregate numbers only, so the data-privacy erasure transaction is unaffected.
// ---------------------------------------------------------------------------------------------------------------------

/// One brief: a master hook, USP and call to action, plus a variant per channel format.
model CreativeBrief {
  id           String            @id @default(cuid())
  title        String
  topic        String
  audience     String
  /// en | hinglish
  language     String
  hookType     String
  usp          String?
  cta          String?
  /// { hook, usp, cta }
  master       Json
  formats      String[]
  /// Ids of CompetitorAd rows attached as inspiration. Their wording is never copied into a draft.
  referenceIds String[]          @default([])
  /// The brand profile version the drafts were checked against.
  brandVersion Int?
  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  variants     CreativeVariant[]

  @@index([createdAt])
}

/// One channel variant of a brief. complianceStatus is the result of the rules on the text as saved; it is recomputed at every gate.
model CreativeVariant {
  id               String          @id @default(cuid())
  briefId          String
  brief            CreativeBrief   @relation(fields: [briefId], references: [id], onDelete: Cascade)
  /// google_rsa | meta_feed | linkedin_single | youtube_video | tiktok_feed
  format           String
  language         String
  /// { fieldKey: string[] }
  fields           Json
  disclaimer       String          @default("")
  /// DRAFT | NEEDS_REVIEW | APPROVED
  status           String          @default("DRAFT")
  /// STAFF | AI
  source           String          @default("STAFF")
  /// PASS | FAIL
  complianceStatus String          @default("FAIL")
  /// [{ id, label, status, matched?, message }]
  complianceChecks Json?
  score            Int?
  /// scale | iterate | rewrite
  verdict          String?
  authorId         String
  approvedById     String?
  approvedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           CreativeEvent[]

  @@index([briefId])
  @@index([status, updatedAt])
}

/// Append-only trail of what happened to a variant and who did it.
model CreativeEvent {
  id         String          @id @default(cuid())
  variantId  String
  variant    CreativeVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  action     String
  fromStatus String?
  toStatus   String?
  actorId    String
  note       String?
  createdAt  DateTime        @default(now())

  @@index([variantId, createdAt])
}

/// A tag on a live ad (format, hook, offer, length, call to action). status DRAFT until a person confirms it.
model CreativeTag {
  id          String   @id @default(cuid())
  /// channel:adId
  adKey       String
  channel     String
  adId        String
  adName      String?
  tagType     String
  value       String
  /// DRAFT | CONFIRMED
  status      String   @default("DRAFT")
  /// HUMAN | RULE | AI
  source      String   @default("HUMAN")
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([adKey, tagType])
  @@index([channel])
}

/// The brand profile, versioned: a change is a new row.
model BrandProfileVersion {
  id          String   @id @default(cuid())
  version     Int      @unique
  profile     Json
  createdById String
  createdAt   DateTime @default(now())
}

/// A saved competitor (a page name or id). Ads are added by hand or from a CSV; nothing is scraped.
model CompetitorWatch {
  id          String         @id @default(cuid())
  name        String         @unique
  pageId      String?
  notes       String?
  createdById String
  createdAt   DateTime       @default(now())
  ads         CompetitorAd[]
}

model CompetitorAd {
  id           String          @id @default(cuid())
  competitorId String
  competitor   CompetitorWatch @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  copy         String
  format       String
  startDate    DateTime?       @db.Date
  link         String?
  /// A pointer (web address or reference), never the media itself.
  thumbnailRef String?
  hookTag      String?
  offerTag     String?
  /// DRAFT | CONFIRMED
  tagStatus    String          @default("DRAFT")
  /// HUMAN | RULE | AI
  tagSource    String          @default("RULE")
  importedById String
  createdAt    DateTime        @default(now())

  @@index([competitorId, startDate])
}

model Experiment {
  id               String    @id @default(cuid())
  name             String
  hypothesis       String
  metric           String
  baselineRate     Float?
  mde              Float?
  /// absolute | relative
  mdeKind          String    @default("relative")
  visitorsPerDay   Int?
  sampleSizePerArm Int?
  startAt          DateTime? @db.Date
  endAt            DateTime? @db.Date
  /// PLANNED | RUNNING | DECIDED
  status           String    @default("PLANNED")
  /// ADOPT | KEEP_CONTROL | INCONCLUSIVE | STOPPED
  decision         String?
  learning         String?
  campaignIds      String[]  @default([])
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, updatedAt])
}

/// A shareable director report. The link carries an unguessable token; only its SHA-256 is stored. The snapshot is the
/// report as it was made (aggregate numbers, no customer data), so opening a link reads no live customer tables.
model ReportShare {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  label            String?
  periodFrom       DateTime  @db.Date
  periodTo         DateTime  @db.Date
  snapshot         Json
  createdById      String
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedById      String?
  /// True from creation until a person approves the publication (canonical approval kind director-report). A link awaiting approval opens nothing.
  awaitingApproval Boolean   @default(false)
  approvedAt       DateTime?
  approvedById     String?
  /// The reviewer's reason when a pending link was declined (it is then revoked).
  decisionNote     String?
  viewCount        Int       @default(0)
  lastViewedAt     DateTime?
  createdAt        DateTime  @default(now())

  @@index([expiresAt])
  @@index([createdAt])
}

/// The Monday summary. Prepared by the weekly job, never sent by it: a person approves, then sends it themselves.
model DirectorDigest {
  id           String    @id @default(cuid())
  /// The Monday that starts the week the digest is about.
  weekStart    DateTime  @unique @db.Date
  report       Json
  subject      String
  bodyText     String
  recipients   String[]
  /// DRAFT | APPROVED | DISCARDED
  status       String    @default("DRAFT")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
}

/// Settings for this module (thresholds, rule settings, digest recipients), as JSON strings keyed by name.
model CreativeSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Campaign planner (additive; flag NEXT_PUBLIC_PLANNER). Admin and Marketing only. Plans, audiences, promises, destinations,
// creators, copy drafts and routing rules hold staff-written text and pseudonymous campaign codes. No table here points at a
// Client, so the data-privacy erasure transaction has nothing to add. User references are plain ids (as on SocialPost).
// ---------------------------------------------------------------------------

/// A group of people a campaign speaks to. Three are seeded; an Admin can add more or edit them.
model PlannerAudience {
  id             String        @id @default(cuid())
  /// Stable machine key, e.g. "salaried". Routing rules and the funnel history use it.
  key            String        @unique
  name           String
  description    String
  languages      String[]
  cities         String[]
  /// Typical channel kinds (see src/lib/planner/channels.ts).
  channels       String[]
  tone           String
  productFit     String
  objections     String
  complianceNote String
  sortOrder      Int           @default(0)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  plans          PlannerPlan[]
}

/// A page, app screen or chat a campaign lands on. Registered here; the tools behind it are built elsewhere.
model PlannerDestination {
  id               String            @id @default(cuid())
  name             String
  /// APP_DEEP_LINK | WEB_LANDING | WHATSAPP_CHAT
  kind             String
  urlPattern       String
  ownerId          String?
  /// LIVE | PLANNED | OFF
  status           String            @default("PLANNED")
  notes            String?
  lastCheckedAt    DateTime?
  lastCheckOk      Boolean?
  lastCheckMessage String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  promises         PlannerPromise[]
  plans            PlannerPlan[]
}

/// A reusable promise (the hook) with the evidence it needs and the claims it may and may not make.
model PlannerPromise {
  id               String              @id @default(cuid())
  hook             String
  evidence         String
  product          String
  /// The promise names an investment product: it must cite the Product Registry (no registry on this base yet, so it fails closed).
  mentionsProduct  Boolean             @default(false)
  /// The Product Registry id the promise cites (an opaque id, never a copy of product facts).
  productRegistryId String?
  destinationId    String?
  destination      PlannerDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  allowedClaims    String[]
  disallowedClaims String[]
  archivedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  plans            PlannerPlan[]
}

/// Short-video creators a campaign may use. A creator without a valid SEBI registration number can never be attached to a plan.
model PlannerCreator {
  id                String        @id @default(cuid())
  name              String
  handle            String
  platform          String
  sebiRegistration  String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  plans             PlannerPlan[]
}

/// One campaign plan: an audience, a promise, a channel and a destination, with an owner and a status.
model PlannerPlan {
  id             String             @id @default(cuid())
  /// The campaign code that tracked links carry and the lead intake captures, e.g. "ALV-7K3Q9X".
  code           String             @unique
  title          String
  audienceId     String
  audience       PlannerAudience    @relation(fields: [audienceId], references: [id])
  promiseId      String
  promise        PlannerPromise     @relation(fields: [promiseId], references: [id])
  /// A channel kind key (src/lib/planner/channels.ts).
  channel        String
  destinationId  String
  destination    PlannerDestination @relation(fields: [destinationId], references: [id])
  creatorId      String?
  creator        PlannerCreator?    @relation(fields: [creatorId], references: [id])
  budgetInr      Int?
  startDate      DateTime?          @db.Date
  endDate        DateTime?          @db.Date
  /// The person responsible (a User id).
  ownerId        String
  /// DRAFT | NEEDS_REVIEW | APPROVED | SCHEDULED
  status         String             @default("DRAFT")
  /// The consent purpose the follow-up relies on (a key of src/lib/consent/policy.ts).
  consentPurpose String?
  /// The synced ad campaign (CampaignOutcomeProvider row key) whose outcomes belong to this plan. Null: not measured.
  outcomeKey     String?
  /// A person tested the tracked links; any change to the plan clears it.
  linksTestedAt  DateTime?
  linksTestedById String?
  approvedById   String?
  approvedAt     DateTime?
  notes          String?
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  copies         PlannerCopy[]
  events         PlannerEvent[]

  @@index([status, startDate])
  @@index([audienceId, channel])
}

/// A copy draft for a plan: a person writes it or the draft-only AI does; a person approves it.
model PlannerCopy {
  id           String      @id @default(cuid())
  planId       String
  plan         PlannerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  body         String
  /// STAFF | AI
  source       String      @default("STAFF")
  /// DRAFT | NEEDS_REVIEW | APPROVED
  status       String      @default("DRAFT")
  /// The last compliance scan: [{ code, message }].
  issues       Json?
  createdById  String
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([planId, createdAt])
}

/// Append-only audit trail of what happened to a plan and who did it.
model PlannerEvent {
  id         String      @id @default(cuid())
  planId     String
  plan       PlannerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  actorId    String
  /// CREATED | EDITED | STATUS | COPY_APPROVED | LINKS_TESTED | ...
  kind       String
  fromStatus String?
  toStatus   String?
  note       String?
  createdAt  DateTime    @default(now())

  @@index([planId, createdAt])
}

/// Who owns a lead that arrives with a campaign code. First matching rule by priority wins; one rule is the fallback.
model PlannerRoutingRule {
  id          String   @id @default(cuid())
  name        String
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  cities      String[]
  languages   String[]
  products    String[]
  audienceKey String?
  /// A User id; null means the rule names nobody yet.
  ownerId     String?
  ownerLabel  String?
  isFallback  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, priority])
}

// ---------------------------------------------------------------------------
// Campaign attribution (additive; flag NEXT_PUBLIC_ATTRIBUTION). Customer-level attribution is computed from existing data
// and stores nothing; only the lead push (timer, escalation, the draft) needs rows.
// ---------------------------------------------------------------------------

/// One row per new lead that was pushed to its RM: the campaign context shown to them, the speed-to-lead clock and what
/// happened when it ran out. Holds what the lead typed (their answers), so it is erased with the client.
model LeadPush {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  /// "source:externalId" of the submission that created the lead; makes a replayed webhook a no-op.
  intakeKey        String    @unique
  assignedToId     String?
  /// Campaign, creative, form and the lead's own answers at the time of the push.
  context          Json
  slaMinutes       Int
  dueAt            DateTime
  /// OPEN | CONTACTED | ESCALATED
  status           String    @default("OPEN")
  contactedAt      DateTime?
  escalatedAt      DateTime?
  escalationTaskId String?
  /// The draft first message (AgentProposal), when one was written. Only ever a draft.
  draftProposalId  String?
  createdAt        DateTime  @default(now())

  @@index([status, dueAt])
  @@index([clientId])
}

/// Attribution settings an Admin can change (speed-to-lead SLA, escalation grace). Key/value, like the other settings tables.
model AttributionSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Admin control plane (first slice). Both tables are additive, carry no foreign key and no customer reference, so they can
// never block a User or Client erasure or merge. Strings rather than enums on purpose (enum values cannot be dropped cheaply).
// ---------------------------------------------------------------------------

/// One row per execution of a cron job, an inbound webhook or a manual run. Counts and error CLASSES only: never a payload,
/// a customer value, a secret or a driver message.
model JobRun {
  id           String    @id @default(cuid())
  kind         String // "CRON" | "WEBHOOK" | "MANUAL" | "RETRY"
  job          String // registry key, e.g. "meta-ads-sync", "webhook:app-signup", "__tick"
  tickId       String? // groups the rows of one cron tick; the "__tick" row has id = tickId
  status       String // "RUNNING" | "OK" | "SKIPPED" | "FAILED" | "TIMEOUT" | "ABANDONED" | "REJECTED"
  skipReason   String? // "flag off" | "not due" | "lease held" | "already ran today"
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  attempt      Int       @default(1)
  retryOfId    String? // JobRun.id this retries (chain for dead-letter style capping)
  errorClass   String? // constructor name or code, e.g. "PrismaClientKnownRequestError:P2002"
  errorMessage String? // scrubbed, max 300 chars
  summary      Json? // counts only; max 2 KB
  trigger      String? // "cron-job.org" | "github-actions" | "manual-wait" | provider name | "admin:<userId>"
  deployRef    String? // short commit sha

  @@index([job, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@index([tickId])
  @@index([startedAt])
}

/// De-duplicated operational alerts. One open row per `key`; raised by the control plane evaluator, never by customer data.
model ControlPlaneAlert {
  id               String    @id @default(cuid())
  key              String // stable dedupe key, e.g. "job-failing:meta-ads-sync", "heartbeat-stale"
  severity         String // "INFO" | "WARN" | "CRITICAL"
  title            String
  detail           Json? // counts, thresholds, job key; no customer data
  firstRaisedAt    DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  resolvedAt       DateTime?
  notifiedAt       DateTime? // last time in-app Notification rows were created
  acknowledgedById String?
  acknowledgedAt   DateTime?

  @@index([resolvedAt, severity])
  @@index([key])
}

// ---- Customer events -----------------------------------------------------------------------------------------
/// The integration/event FACT layer (the event taxonomy). Append-only; it never replaces a domain table. `clientId` is a plain id, deliberately NOT a foreign key:
/// the fact outlives the customer's erasure (id, type and times stay for audit, everything else is nulled by the erasure transaction).
model CustomerEvent {
  id             String   @id @default(cuid())
  /// Monotonic cursor for consumers (a settle window protects against commits that land out of order).
  seq            BigInt   @unique @default(autoincrement())
  eventId        String   @unique // deterministic from (source, dedupeKey)
  eventType      String
  occurredAt     DateTime // when it happened in the world (source clock)
  receivedAt     DateTime @default(now())
  actorType      String
  actorId        String?
  clientId       String?
  source         String
  correlationId  String
  causationId    String?
  schemaVersion  Int      @default(1)
  consentContext Json?
  metadata       Json?
  dataClass      String
  dedupeKey      String
  late           Boolean  @default(false) // older than the late horizon at receipt: stored, triggers nothing
  clockSkew      Boolean  @default(false)

  deadLetters EventDeadLetter[]

  @@unique([source, dedupeKey])
  @@index([clientId, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt])
  @@index([correlationId])
  @@index([receivedAt])
}

/// One cursor per consumer. At-least-once: the cursor moves only after a batch's handlers succeeded (or their event was dead-lettered).
model EventCursor {
  consumer       String    @id
  lastSeq        BigInt    @default(0)
  lastReceivedAt DateTime?
  lastRunAt      DateTime?
  lastError      String? // error class only
  processedTotal Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// A consumer failing on an event: RETRYING until `attempts` reaches the limit, then DEAD (shown in the control plane, retry button re-runs it). Nothing is dropped silently.
model EventDeadLetter {
  id            String        @id @default(cuid())
  eventId       String
  event         CustomerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumer      String
  attempts      Int           @default(1)
  status        String        @default("RETRYING") // RETRYING | DEAD | RESOLVED
  errorClass    String?
  errorMessage  String? // scrubbed
  firstFailedAt DateTime      @default(now())
  lastFailedAt  DateTime      @default(now())
  resolvedAt    DateTime?

  @@unique([eventId, consumer])
  @@index([status, lastFailedAt])
}

/// An emit that could not be stored (invalid, unregistered or a database error). The domain write was never affected. Metadata is kept only for non-personal classes.
model EventEmitFailure {
  id            String    @id @default(cuid())
  eventType     String
  source        String
  dedupeKey     String
  clientId      String?
  reason        String // INVALID | UNREGISTERED | DB_ERROR
  detail        String? // scrubbed, max 300 chars
  envelope      Json?
  status        String    @default("OPEN") // OPEN | RETRIED | RESOLVED
  attempts      Int       @default(1)
  createdAt     DateTime  @default(now())
  lastAttemptAt DateTime?

  @@index([status, createdAt])
  @@index([clientId])
}

/// A data-health finding computed from the relationship registry, the customer tables and the event stream. One row per (check, subject); resolved when the finding disappears.
model DataHealthItem {
  id               String    @id @default(cuid())
  checkKey         String // e.g. "no_identity_keys", "unassigned_lead"
  subjectType      String // "client" | "event" | "system"
  subjectId        String
  clientId         String? // set when the subject is a customer (plain id, no foreign key; removed by erasure)
  severity         String // "INFO" | "WARN" | "HIGH"
  title            String
  detail           Json? // counts, ids and codes; no free text about a person
  status           String    @default("OPEN") // OPEN | ACKNOWLEDGED | RESOLVED
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  resolvedAt       DateTime?
  acknowledgedById String?
  acknowledgedAt   DateTime?

  @@unique([checkKey, subjectType, subjectId])
  @@index([status, severity])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Wave 2 workstream B: customer memory (with the DISPUTED state), formal complaint and commitment handling, and
// household privacy walls. All additive. Nothing here replaces SupportTicket, Task, ConversationInsight or the calls
// data: complaints and commitments LINK to them by plain id (no foreign key, so those tables are untouched).
// ---------------------------------------------------------------------------

enum MemoryClass {
  FACT
  PREFERENCE
  INTEREST
  OBJECTION
  COMMITMENT
  GOAL
  SENTIMENT
  PRODUCT_STANCE
  SERVICE_CONTEXT
  DO_NOT_DO
}

enum MemoryConfirmation {
  UNCONFIRMED
  CONFIRMED
  DISPUTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum MemoryConfidence {
  LOW
  MEDIUM
  HIGH
}

/// One thing the company knows about a customer, with where it came from, how sure we are and how old it is
/// (docs/customer-memory.md). An AI-derived item is born UNCONFIRMED and never promotes itself; a conflicting new item
/// is stored as DISPUTED next to the old one, never over it. `evidence` holds redacted summaries and source refs, not raw text.
model CustomerMemoryItem {
  id                String             @id @default(cuid())
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id])
  class             MemoryClass
  /// e.g. "product_stance:PMS", "preference:language". Items with the same key and a different value conflict.
  key               String
  value             Json
  /// ledger | system | rm_entry | document | conversation_ai | call_ai | customer_stated | import
  sourceType        String
  /// "<kind>:<id>" (insight:, review:, activity:, consent:, ticket:, task:, document:, goal:, user:, import:)
  sourceRef         String
  /// [{ sourceRef, summary, observedAt }]: a short redacted summary per source, never full text.
  evidence          Json
  confidence        MemoryConfidence   @default(LOW)
  observedAt        DateTime
  freshUntil        DateTime?
  lastReconfirmedAt DateTime?
  confirmation      MemoryConfirmation @default(UNCONFIRMED)
  confirmedById     String?
  confirmedAt       DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  rejectedReason    String?
  disputedById      String?
  disputedAt        DateTime?
  disputedReason    String?
  /// The item this one disagrees with (set on the newer item while both are DISPUTED).
  conflictsWithId   String?
  supersededById    String?
  /// PERSONAL | SENSITIVE_PERSONAL
  dataClass         String             @default("PERSONAL")
  /// The consent purpose the item was derived under (AI_PROCESSING_OF_CHATS, CALL_RECORDING); null for human and system items.
  consentBasis      String?
  createdByType     String // RM | MANAGER | ADMIN | SYSTEM | AI_AGENT
  createdById       String?
  correlationId     String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([clientId, class, confirmation])
  @@index([clientId, key])
  @@index([confirmation, freshUntil])
}

enum ComplaintSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REOPENED
  CLOSED
}

/// A customer complaint as a managed case: severity, owner, SLA clock, resolution, reopen. The ticket, insight and call it
/// came from stay where they are and are linked by id; this row holds only the formal state.
model Complaint {
  id              String            @id @default(cuid())
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  title           String
  /// Short, redacted description. Not the transcript.
  summary         String?
  severity        ComplaintSeverity
  status          ComplaintStatus   @default(OPEN)
  ownerId         String?
  /// TICKET | INSIGHT | CALL | MANUAL
  sourceType      String
  supportTicketId String?
  insightId       String?
  reviewId        String?
  taskId          String?
  /// Idempotent link: "ticket:<id>" or "insight:<id>"; null for manual complaints.
  dedupeKey       String?           @unique
  openedAt        DateTime
  acknowledgedAt  DateTime?
  /// The SLA clock: when the complaint must be resolved by (from severity at the time it was opened or reopened).
  slaDueAt        DateTime
  resolvedAt      DateTime?
  closedAt        DateTime?
  reopenedCount   Int               @default(0)
  lastReopenedAt  DateTime?
  resolutionCode  String?
  resolution      String?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  events          ComplaintEvent[]

  @@index([clientId, status])
  @@index([status, slaDueAt])
  @@index([ownerId, status])
}

/// History of a complaint (opened, acknowledged, owner changed, resolved, reopened, closed). Deleted with the complaint.
model ComplaintEvent {
  id          String           @id @default(cuid())
  complaintId String
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  type        String
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus?
  actorId     String?
  note        String?
  at          DateTime         @default(now())

  @@index([complaintId, at])
}

enum CommitmentStatus {
  OPEN
  KEPT
  BROKEN
  CANCELLED
}

/// Who promised what to whom by when. Built over what exists: a COMMITMENT insight, a call review or a Task can be
/// linked by id; overdue is derived (OPEN and past due), not a stored status.
model Commitment {
  id             String           @id @default(cuid())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  /// RM | CRM | AI_AGENT | ALLVEST
  promisedByType String
  promisedById   String?
  /// CUSTOMER (the customer on this record) | INTERNAL
  promisedToType String           @default("CUSTOMER")
  text           String
  dueAt          DateTime
  status         CommitmentStatus @default(OPEN)
  /// Who must deliver it (defaults to the promiser).
  ownerId        String?
  /// MANUAL | INSIGHT | CALL | TASK
  sourceType     String
  insightId      String?
  reviewId       String?
  taskId         String?
  memoryItemId   String?
  /// Idempotent link: "insight:<id>" for ones built from conversation insights.
  dedupeKey      String?          @unique
  keptAt         DateTime?
  brokenAt       DateTime?
  cancelledAt    DateTime?
  outcomeNote    String?
  /// A person accepted this commitment as real. Rows built from an AI-read conversation start with both null ("suggested")
  /// and are never counted as overdue until accepted; rows a person enters are born confirmed.
  confirmedById  String?
  confirmedAt    DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([clientId, status])
  @@index([status, dueAt])
  @@index([ownerId, status])
}

enum AuditFindingSource {
  WHATSAPP
  CALL
  SUPPORT
  RM_COMMUNICATION
  COMPLAINT
  COMPLIANCE
  COMMITMENT
  MANUAL
}

/// The bible's quality flags (section 04). A category is what was noticed; the source says where it came from.
enum AuditFindingCategory {
  INCORRECT_COMMUNICATION
  POOR_CONVERSATION
  MISSED_FOLLOW_UP
  MISSED_OPPORTUNITY
  CUSTOMER_DISSATISFACTION
  COMMITMENT_NOT_COMPLETED
  POTENTIAL_COMPLIANCE_ISSUE
}

enum AuditFindingSeverity {
  LOW
  MEDIUM
  HIGH
}

enum AuditFindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

/// A quality or control flag raised over stored records (a commitment, a complaint, later a call or a chat). Findings
/// hold a short summary and a reference to the evidence, never the transcript. `dedupeKey` makes detection idempotent:
/// one source record and one category yield one finding, whatever number of times the detectors run.
model AuditFinding {
  id              String                @id @default(cuid())
  clientId        String?
  client          Client?               @relation(fields: [clientId], references: [id])
  subjectUserId   String?
  subjectUser     User?                 @relation("AuditFindingSubject", fields: [subjectUserId], references: [id])
  source          AuditFindingSource
  category        AuditFindingCategory
  severity        AuditFindingSeverity
  status          AuditFindingStatus    @default(OPEN)
  summary         String
  /// Reference to the evidence, such as "commitment:<id>" or "complaint:<id>". Never the message or transcript itself.
  evidenceRef     String?
  /// Idempotent key: "<source>:<record id>:<category>".
  dedupeKey       String                @unique
  detectedAt      DateTime
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?                 @relation("AuditFindingResolver", fields: [resolvedById], references: [id])
  createdAt       DateTime              @default(now())

  @@index([clientId, status])
  @@index([status, severity])
}

/// Relationship-level consent inside a household: the member `subjectClientId` agrees that what is listed in `scopes`
/// about them may be shown to the household view / the RM of `granteeClientId` (null = every member). Append-only in
/// spirit: a change is a new row, the newest row per (subject, grantee) decides. Without a row nothing crosses the wall.
model HouseholdRelationshipConsent {
  id              String    @id @default(cuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id])
  subjectClientId String
  subject         Client    @relation("HouseholdConsentSubject", fields: [subjectClientId], references: [id])
  granteeClientId String?
  grantee         Client?   @relation("HouseholdConsentGrantee", fields: [granteeClientId], references: [id], onDelete: Restrict)
  /// Facet keys from src/lib/households/privacy/policy.ts (never "relationship_exists", which needs no consent).
  scopes          Json
  /// GRANTED | WITHDRAWN
  status          String
  source          String
  evidenceRef     String?
  capturedById    String?
  capturedAt      DateTime  @default(now())
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([householdId, subjectClientId, granteeClientId, capturedAt(sort: Desc)])
  @@index([subjectClientId])
  @@index([granteeClientId])
}

// ---------------------------------------------------------------------------
// Product and Eligibility Registry (Wave 2, workstream C). The governed source of product facts: agents, the campaign planner and
// copy tools may only CITE a registry id (src/lib/registry/cite.ts). Versioned: a product has many versions, one of them in force
// (activeVersionId). Additive: no foreign key to any existing table (author and reviewer ids are plain strings, like AuditLog.userId
// on the other append-only tables), so nothing in erasure, merge or the relationship registry changes.
// status: DRAFT | APPROVED | SUSPENDED | RETIRED. Version state: DRAFT | IN_REVIEW | APPROVED | REJECTED | SUPERSEDED.
// ---------------------------------------------------------------------------
model RegistryProduct {
  id              String   @id @default(cuid())
  key             String   @unique // stable slug, e.g. "example-growth-fund"
  isExample       Boolean  @default(false) // seeded EXAMPLE entry: the owner must replace it; refused by cite() in production
  status          String   @default("DRAFT")
  activeVersionId String?
  statusReason    String?
  statusChangedAt DateTime?
  statusChangedBy String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions RegistryProductVersion[]

  @@index([status])
}

model RegistryProductVersion {
  id                 String          @id @default(cuid())
  productId          String
  product            RegistryProduct @relation(fields: [productId], references: [id])
  versionNo          Int
  state              String          @default("DRAFT")
  name               String
  category           String
  summary            String?
  availability       String
  minInvestmentMinor BigInt?
  currency           String          @default("INR")
  riskCategory       String
  jurisdictions      String[]
  requiredDocuments  String[]
  eligibility        Json            @default("[]")
  salesRestrictions  Json            @default("[]")
  claims             Json            @default("[]")
  validFrom          DateTime?
  validTo            DateTime?
  createdBy          String?
  createdAt          DateTime        @default(now())
  submittedAt        DateTime?
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewNote         String?

  @@unique([productId, versionNo])
  @@index([productId, state])
}

// ---------------------------------------------------------------------------
// Attention Engine v1 (Wave 2, workstream C). The AttentionItem read model is computed on read from existing sources; the only
// stored state is a person's own dismiss or snooze of an item. itemKey is deterministic ("<kind>:<sourceRef>"). No customer text.
// status: DISMISSED | SNOOZED. Every change also writes an AuditLog row.
// ---------------------------------------------------------------------------
model AttentionDismissal {
  id         String    @id @default(cuid())
  userId     String
  itemKey    String
  kind       String
  status     String
  snoozeUntil DateTime?
  reason     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, itemKey])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Decision Engine v2, SHADOW MODE (docs/decision-engine.md). Computed and stored, never shown to RMs by default.
// A decision is a recommendation, an explicit No Action, or an Abstain with a reason. Scores are heuristics, not probabilities.
// DecisionRecord has a RESTRICT foreign key to Client, so the erasure transaction deletes it (feedback, outcomes and the disagreement
// row go with it through ON DELETE CASCADE).
// ---------------------------------------------------------------------------

model DecisionRecord {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  engineVersion   String
  correlationId   String
  causationId     String?
  /// SHADOW today. Reserved for later modes; nothing reads another value yet.
  mode            String    @default("SHADOW")
  /// RECOMMEND | NO_ACTION | ABSTAIN
  result          String
  /// do_not_know | evidence_conflict | data_stale | human_review_required | do_not_contact
  abstainReason   String?
  escalation      String?
  action          String
  programme       String
  topic           String?
  assetClass      String?
  reason          String
  priority        String
  /// 0 to 100. HEURISTIC, not a probability.
  priorityScore   Int
  owner           String
  channel         String
  timing          String
  notBefore       DateTime?
  /// low | medium | high (labelled heuristic; never a percentage)
  confidence      String
  evidence        Json
  scoreInputs     Json
  suppression     Json
  policyResult    Json
  alternatives    Json
  /// What the current engine said at the same moment (for the disagreement log).
  legacy          Json?
  chosenCandidateId String?
  /// The chosen candidate's (ruleKey, fingerprint): what a snooze or a wrong mark writes to SuggestionDismissal, so every screen that honours dismissals honours it.
  chosenRuleKey   String?
  chosenFingerprint String?
  candidateCount  Int       @default(0)
  /// Hash of the inputs; an unchanged customer does not get a new row on every refresh.
  inputHash       String
  /// OPEN | ACCEPTED | SNOOZED | DISMISSED | EXPIRED | DONE
  status          String    @default("OPEN")
  statusUpdatedAt DateTime?
  /// As-of of the data the decision rests on (the clock the engine used).
  observedAt      DateTime
  createdAt       DateTime  @default(now())

  feedback        DecisionFeedback[]
  outcomes        DecisionOutcome[]
  disagreement    DecisionDisagreement?
  agentProposals  AgentProposal[]

  @@index([clientId, createdAt(sort: Desc)])
  @@index([result, createdAt])
  @@index([createdAt])
  @@index([correlationId])
}

/// A person's reaction to a decision (accept, done, snooze, wrong, not now, do not recommend). Evaluation data, not a command to the engine.
model DecisionFeedback {
  id         String         @id @default(cuid())
  decisionId String
  decision   DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  userId     String
  /// accept | done | snooze | wrong | not_now | dnr | ignored | expired
  kind       String
  /// For wrong: wrong_fact | already_done | wrong_customer | wrong_channel | wrong_product. Free text is not stored.
  reason     String?
  until      DateTime?
  scope      String?
  createdAt  DateTime       @default(now())

  @@index([decisionId])
  @@index([kind, createdAt])
}

/// A later event on the same customer, linked to a decision. Correlation, not causation: nothing here says the decision caused it.
model DecisionOutcome {
  id         String         @id @default(cuid())
  decisionId String
  decision   DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  /// contact | response | interaction_outcome | kyc | funding | complaint_resolved
  kind       String
  eventRef   String
  occurredAt DateTime
  daysAfter  Int
  detail     String?
  createdAt  DateTime       @default(now())

  @@unique([decisionId, kind, eventRef])
  @@index([kind, occurredAt])
}

/// Old versus new: one row per decision that differs from the current engine (or is flagged material).
model DecisionDisagreement {
  id         String         @id @default(cuid())
  decisionId String         @unique
  decision   DecisionRecord @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  /// action_differs | programme_differs | v2_holds_back | v2_abstains | suppression_regression
  kind       String
  /// info | minor | material
  severity   String
  summary    String
  createdAt  DateTime       @default(now())

  @@index([severity, createdAt])
  @@index([createdAt])
}

/// One replay of the engine over historical snapshots: the parameters and the summary. No customer data beyond ids and counts.
model DecisionReplayRun {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  createdById String?
  params      Json
  summary     Json
}

// Autopilot (marketing): proposals, decisions, rules, launch drafts and plans. Nothing here holds personal data and
// nothing has a foreign key to Client, so the erasure transaction needs no change. User ids are plain references.
// ---------------------------------------------------------------------------

/// One proposed action with its evidence. The id is stable (rule + target), so a decision sticks across daily runs.
model AutopilotRecommendation {
  id          String    @id
  ruleKey     String
  targetKey   String
  category    String
  severity    String
  issue       String
  evidence    Json
  action      Json
  impact      Json
  confidence  String
  /// PENDING | APPROVED | DENIED | APPLIED | FAILED | UNDONE
  status      String    @default("PENDING")
  decidedById String?
  decidedAt   DateTime?
  appliedAt   DateTime?
  undoToken   String?
  lastError   String?
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// The audit run that first proposed it, and that run's correlation id: every event, decision and applied action carries it (Action Ledger ready).
  auditRunId    String?
  correlationId String?
  /// An undecided proposal expires; every daily run that still finds the problem renews it.
  expiresAt     DateTime?

  @@index([status, lastSeenAt])
  @@index([correlationId])
}

/// Append-only record of every approve and deny, with the reason a denial carries (it feeds rule tuning).
model AutopilotDecision {
  id         String   @id @default(cuid())
  recId      String
  ruleKey    String
  targetKey  String
  /// APPROVED | DENIED
  decision   String
  reasonCode String?
  note       String?
  actorId    String
  correlationId String?
  createdAt  DateTime @default(now())

  @@index([ruleKey, createdAt])
  @@index([recId])
}

/// A rule an Admin or marketer wrote: "if X over N days, propose Y". It only ever proposes.
model AutopilotRule {
  id          String   @id @default(cuid())
  name        String
  enabled     Boolean  @default(true)
  metric      String
  op          String
  threshold   Float
  days        Int
  campaignIds Json?
  /// Ad accounts the rule is limited to; null = every account.
  accountIds  Json?
  action      String
  /// manual | drafted (written from a plain-language sentence through the AI gateway, then reviewed and saved by a person)
  source      String   @default("manual")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// A campaign launch draft. Always created PAUSED; turning it on is a separate, checked act.
model AutopilotLaunchDraft {
  id               String    @id @default(cuid())
  name             String
  input            Json
  estimates        Json
  checklist        Json
  /// DRAFT | LAUNCHED_PAUSED | ACTIVE | DISCARDED
  status           String    @default("DRAFT")
  complianceOk     Boolean   @default(false)
  /// Recorded by a person once the ad-approval annexure has been signed.
  annexureApproved Boolean   @default(false)
  externalId       String?
  createdById      String
  launchedById     String?
  launchedAt       DateTime?
  activatedById    String?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
}

/// What the team planned to spend on a campaign in a month, and the account-wide targets. Singleton settings use campaignId "*".
model AutopilotPlan {
  campaignId           String   @id
  plannedMonthlyBudget Float?
  targetCostPerFunded  Float?
  contactSlaMinutes    Int?
  /// Settings row only ("*"): when true, a proposal that came from a rule a person wrote cannot be approved by that same person (four eyes). Off by default.
  requireSecondApprover Boolean  @default(false)
  updatedById          String?
  updatedAt            DateTime @updatedAt
}

/// One run of the audit (the daily job, or a person asking for a refresh). Its correlation id follows every proposal it made through approval to the applied action.
model AutopilotAuditRun {
  id            String    @id @default(cuid())
  correlationId String    @unique
  /// job | page
  trigger       String
  /// RUNNING | SUCCEEDED | FAILED
  status        String    @default("RUNNING")
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  startedById   String?
  dataThrough   DateTime?
  healthScore   Int?
  proposals     Int       @default(0)
  newProposals  Int       @default(0)
  wastedSpend   Float?
  error         String?

  @@index([startedAt])
}

/// The weekly digest: an in-app notification for Admin and Marketing, and a draft email nobody receives until a person approves it. Aggregates only: no customer data.
model AutopilotDigest {
  id            String    @id @default(cuid())
  /// Monday of the week the digest covers (YYYY-MM-DD). One digest per week.
  weekStart     String    @unique
  correlationId String
  subject       String
  body          String
  /// DRAFT | APPROVED | DISCARDED
  status        String    @default("DRAFT")
  /// User ids that would receive it (Admin and Marketing users).
  recipients    Json
  createdAt     DateTime  @default(now())
  decidedById   String?
  decidedAt     DateTime?

  @@index([status, createdAt])
}

/// Optional platform datasets (search terms, keywords, hours, placements, auction ...) as the sync wrote them.
model AutopilotDataset {
  id         String   @id @default(cuid())
  kind       String
  platform   String
  payload    Json
  capturedAt DateTime
  createdAt  DateTime @default(now())

  @@index([kind, platform, capturedAt])
}

/// Assignment experiments (src/lib/experiments). Not the planning record above: this one holds arms, exposures and outcomes.
/// Named AbExperiment because `Experiment` above is already the planning model. Holds no customer names or contact data:
/// subjectId is an opaque customer or lead id, never an email, phone or name.
model AbExperiment {
  id        String   @id @default(cuid())
  /// Stable machine key, unique. Also part of the assignment hash, so two experiments split the same subjects independently.
  key       String   @unique
  name      String
  /// draft | running | stopped
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  arms      AbExperimentArm[]
  exposures AbExperimentExposure[]
  outcomes  AbExperimentOutcome[]
}

/// One arm of an experiment. Weights are whole percentages; they must sum to 100 per experiment (enforced in code).
/// position 0 is the control arm.
model AbExperimentArm {
  id           String       @id @default(cuid())
  experimentId String
  experiment   AbExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  key          String
  label        String
  weight       Int
  position     Int

  @@unique([experimentId, key])
}

/// The arm a subject was first put in. Unique per experiment and subject, so re-exposure is a no-op.
model AbExperimentExposure {
  id           String       @id @default(cuid())
  experimentId String
  experiment   AbExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  armKey       String
  /// Opaque id or hash only. Never a name, email or phone.
  subjectId    String
  exposedAt    DateTime     @default(now())

  @@unique([experimentId, subjectId])
  @@index([experimentId, armKey])
}

/// An outcome event for an exposed subject. The outcome string is an event type (for example campaign.funded.attributed).
model AbExperimentOutcome {
  id           String       @id @default(cuid())
  experimentId String
  experiment   AbExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  armKey       String
  subjectId    String
  outcome      String
  recordedAt   DateTime     @default(now())

  @@index([experimentId, subjectId])
}

/// Consent and do-not-contact ledger. Append-only: a withdrawal is a new row, and the current state is the latest
/// row per (clientId, purpose, channel). purpose, status and source are enum-like text (see src/lib/consent/policy.ts).
/// capturedById is a plain id (no FK) so removing a user never touches the evidence.
// ---------------------------------------------------------------------------
// Marketing: ad-platform reporting (read-only). One row per campaign per account-local calendar day, upserted by the
// sync job (src/lib/marketing/sync-meta.ts). Deliberately no foreign key to Client: this holds platform-reported
// numbers only, never personal data, so the data-privacy erasure transaction needs no change.
// ---------------------------------------------------------------------------
// One row per sync attempt. status: SUCCESS | PARTIAL | FAILED | RATE_LIMITED.
/// Back-office file import (BACKOFFICE_IMPORT_ENABLED). Singleton (id = "default"): the column-mapping config an Admin edits in Settings.
/// One row per import attempt (dry run or real). `seq` is the monotonic revision stamped on rows that carry no revision column.
/// Holds counts and per-row error codes only: never file contents, identifiers or values.
/// One ad (creative) on one day, from a platform that can report per ad. Holds no personal data and has no link to a customer.
/// A social post draft. Nothing is ever published from here: the workflow ends at SCHEDULED, which records intent only.
/// No foreign key to Client (no customer data), so the data-privacy erasure transaction is unaffected.
/// Append-only trail of what happened to a post and who did it.
// ---------------------------------------------------------------------------
// Customer outcomes and goals. Goals are kept by the customer's relationship manager; progress is worked out in code
// (src/lib/outcomes) from the portfolio feed's holdings, so nothing here stores a value or a projection. Linked
// accounts and holdings are plain references (ids) that the loader checks against the customer's own accounts.
// Every table has a RESTRICT foreign key to Client, so the erasure transaction deletes each of them.
// ---------------------------------------------------------------------------
/// A review the relationship manager marked as done. The latest one restarts the review cadence.
/// A suggestion an RM dismissed: hides one rule in one situation (its fingerprint) until `snoozeUntil`.
/// Outcome events, recorded for internal reporting only. Names and ids, never amounts, names or text. Never sent to any vendor.
// ---------------------------------------------------------------------------
// Referral programme (flag REFERRAL_PROGRAM_ENABLED). A referrer is an existing Client. Money is never moved by the CRM:
// the ledger and statements only record what is owed and, at the end, that finance paid it elsewhere (bank reference).
// Ledger and statement rows carry plain ids (no foreign keys) on purpose: they hold no personal data and survive the
// erasure of a person as anonymous financial records.
// ---------------------------------------------------------------------------

/// One row per signup that carried a code. (idempotencyKey) makes a replayed signup a no-op; a person can be attributed once (first touch wins).
/// SIGNED_UP | KYC_COMPLETE | FIRST_FUNDING, derived from existing KYC and funding data; never edited.
/// Append-only (a database trigger refuses UPDATE). kind: ACCRUED | REVIEW_CLEARED | REVERSED | APPROVED | PAID_MARKED.
/// One statement per referrer per month. PREPARED > APPROVED (a different person) > PAID (a marker with a bank reference).
/// Admin-editable text and numbers for the programme (key "disclaimer", "velocity_limit").
/// A hashed device identifier seen on a customer's app signup (never the raw value). Used only to raise Needs-review flags: the same device on a referrer and their referral, or across different referrers. Removed with the customer.
// ---------------------------------------------------------------------------
// Full data export (migration to another Allvest Customer OS instance)
// ---------------------------------------------------------------------------

/// One request to export all client data. Approval state lives on the linked ApprovalRequest (maker-checker: a different
/// Admin must approve); once approved the export can be downloaded a limited number of times until it expires. The file
/// itself is never stored — it is streamed from the database at download time.
model DataExport {
  id                String    @id @default(cuid())
  requestedById     String
  requestedBy       User      @relation("DataExportRequestedBy", fields: [requestedById], references: [id])
  reason            String
  approvalRequestId String?   @unique
  approvedAt        DateTime?
  expiresAt         DateTime?
  downloadCount     Int       @default(0)
  lastDownloadedAt  DateTime?
  /// Per-table row counts written when a download completes (the manifest's counts).
  rowCounts         Json?
  createdAt         DateTime  @default(now())

  @@index([requestedById, createdAt])
}

/// An RM's funded-amount target for one calendar quarter. A team's target is the sum of its RMs' targets (no team row).
/// "Funded" = the amount on funding records marked Partially/Fully Funded with a funding date in the quarter (lib/targets).
model RmTarget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("RmTargetUser", fields: [userId], references: [id])
  /// First day of the quarter (local midnight, stored as UTC).
  quarterStart DateTime
  fundedAmount Decimal  @db.Decimal(18, 2)
  setById      String
  setBy        User     @relation("RmTargetSetBy", fields: [setById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, quarterStart])
  @@index([quarterStart])
}

/// One click-to-call from Allvest Customer OS: Exotel rings the user's phone, then the client's. Drives the live call widget; the call
/// itself is logged as a CALL activity when Exotel reports it finished.
model CallSession {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  provider        String    @default("exotel")
  providerCallId  String?   @unique
  /// QUEUED | IN_PROGRESS | COMPLETED | NO_ANSWER | BUSY | FAILED
  status          String    @default("QUEUED")
  startedAt       DateTime  @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  activityId      String?
  /// Placed through the mock Exotel adapter (local and Preview only).
  mock            Boolean   @default(false)

  @@index([userId, startedAt])
  @@index([clientId])
}

// Wave 6: one eligibility rule for a registry product. `productKey` is RegistryProduct.key (the citable identity), so the
// rule set lives beside the governed registry and never forks it. `predicate` is a JSON tree over the client's KYC and
// risk profile (see src/lib/registry/eligibility.ts). A rule applies only inside [effectiveFrom, effectiveTo).
model EligibilityRule {
  id            String    @id @default(cuid())
  productKey    String
  /// Human label shown to the approver, e.g. "Accredited or HNI investors only".
  label         String
  predicate     Json
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([productKey, effectiveFrom])
}
