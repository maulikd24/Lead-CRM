# CI "all-on" profile: every SCREEN flag on, so the build and the e2e/layout/axe jobs exercise every feature screen.
# NEXT_PUBLIC_* are inlined at build time (build with this file, see scripts/ci/with-env.mjs); the others are read at run time.
# Flags that can cause anything to leave the system stay UNSET on purpose: there is no provider, key or secret in CI and
# nothing may make an outbound call (AGENT_NUDGER_ENABLED, WA_*, CLEVERTAP_PUSH_ENABLED, SSO_ENABLED, META_ADS_SYNC_ENABLED,
# GOOGLE_ADS_REPORTING_ENABLED, SOCIAL_DRAFTS_ENABLED, FRESHDESK_HANDOFF_ENABLED, PORTFOLIO_FEED_ENABLED, EVALS_REAL_PROVIDER).
NEXT_PUBLIC_NAV_V2=1
NEXT_PUBLIC_HOME_V2=1
NEXT_PUBLIC_MOTION=1
NEXT_PUBLIC_CLEVERTAP_CARD=1
NEXT_PUBLIC_C360=1
NEXT_PUBLIC_OUTCOMES=1
NEXT_PUBLIC_CALLS_REVIEW=1
NEXT_PUBLIC_CONSENT=1
NEXT_PUBLIC_MERGE_REVIEW=1
NEXT_PUBLIC_SUPPORT_SLA=1
NEXT_PUBLIC_INSIGHTS=1
NEXT_PUBLIC_MARKETING=1
PARTNER_WORKSPACE_ENABLED=1
REFERRAL_PROGRAM_ENABLED=1
BACKOFFICE_IMPORT_ENABLED=1
NEXT_PUBLIC_CONTROL_PLANE=1
AI_ADMIN_TAB=1
APPROVALS_INBOX_ENABLED=1
CUSTOMER_EVENTS_ENABLED=1
CUSTOMER_TIMELINE_V2=1
RELATIONSHIP_REGISTRY_ERASURE=1
RELATIONSHIP_REGISTRY_MERGE=1
NEXT_PUBLIC_ATTRIBUTION=1
# Closed-loop conversions: ON so its screens are built, exercised and scanned. Only the demo destination (CLOSED_LOOP_DEMO, no network, no credential) can exist in CI;
# a real Meta or Google destination needs credentials and an approved region saved in the app, so nothing can leave.
# Consent enforcement is a startup safety requirement of any outbound flag (FR-11); it only ever blocks, so it cannot make anything leave.
CONSENT_ENFORCEMENT=1
CLOSED_LOOP_CONVERSIONS_ENABLED=1
CLOSED_LOOP_DEMO=1
